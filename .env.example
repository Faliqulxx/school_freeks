# ==============================================================================
# FREEKS School Website Template - Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env jika ingin mengonfigurasi backend eksternal:
# cp .env.example .env
#
# Proyek ini dirancang ZERO-CONFIG. Jika file .env tidak ada,
# website otomatis berjalan 100% normal dengan mode backend 'none'.
# ==============================================================================

# 1. Pilihan Backend Provider
# Nilai yang didukung: 'none' | 'webhook' | 'supabase' | 'mysql'
# Default: 'none' (data tersimpan di browser localStorage + direct WhatsApp)
PUBLIC_BACKEND_PROVIDER=none

# ------------------------------------------------------------------------------
# 2. Konfigurasi Mode: WEBHOOK
# Cocok untuk: Google Apps Script / Google Sheets, Make.com, n8n, Zapier, Formspree
# ------------------------------------------------------------------------------
# URL umum (akan menerima form PPDB dan form Kontak)
PUBLIC_WEBHOOK_URL=

# Atau pisahkan URL per form (opsional, memprioritaskan URL khusus di bawah):
PUBLIC_WEBHOOK_PPDB_URL=
PUBLIC_WEBHOOK_CONTACT_URL=

# ------------------------------------------------------------------------------
# 3. Konfigurasi Mode: SUPABASE
# Dapatkan dari: Project Settings > API di Dashboard Supabase Anda
# ------------------------------------------------------------------------------
# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
PUBLIC_SUPABASE_URL=

# Supabase Anon Public API Key (Aman digunakan di client dengan RLS aktif)
# JANGAN PERNAH menaruh service_role key di sini!
PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. Konfigurasi Mode: MYSQL / HTTP API
# Endpoint API serverless atau REST proxy yang menerima payload form
# ------------------------------------------------------------------------------
PUBLIC_MYSQL_API_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. Konfigurasi Deployment & SEO
# Setel ke 'true' untuk preview/staging agar mesin pencari tidak mengindeks demo
# ------------------------------------------------------------------------------
PUBLIC_DEMO_MODE=false
