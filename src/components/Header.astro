<script is:inline>
  (function () {
    function setupMobileNav() {
      const header = document.getElementById('site-header');
      const drawerToggle = document.getElementById('drawer-toggle');
      const drawer = document.getElementById('mobile-drawer');
      const overlay = document.getElementById('drawer-overlay');
      const drawerClose = document.getElementById('drawer-close');

      // Sticky header shrink on scroll > 80px
      window.addEventListener('scroll', () => {
        if (window.scrollY > 80) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }
      }, { passive: true });

      // Open Drawer
      function openDrawer(e) {
        if (e) e.preventDefault();
        drawer?.classList.add('open');
        overlay?.classList.add('open');
        drawerToggle?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        drawer?.focus();
      }

      // Close Drawer
      function closeDrawer(e) {
        if (e) e.preventDefault();
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
        drawerToggle?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        drawerToggle?.focus();
      }

      drawerToggle?.addEventListener('click', openDrawer);
      drawerClose?.addEventListener('click', closeDrawer);
      overlay?.addEventListener('click', closeDrawer);

      // Close drawer on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer?.classList.contains('open')) {
          closeDrawer();
        }
      });

      // Close drawer automatically when any link inside drawer is tapped/clicked
      const drawerLinks = drawer?.querySelectorAll('a');
      drawerLinks?.forEach((link) => {
        link.addEventListener('click', () => {
          closeDrawer();
        });
      });

      // Mobile Accordion Logic: Only one open at a time
      const accordionTriggers = document.querySelectorAll('.mobile-accordion-trigger');
      accordionTriggers.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';
          const controlsId = btn.getAttribute('aria-controls');
          const content = controlsId ? document.getElementById(controlsId) : null;

          // Close all other accordions first
          accordionTriggers.forEach((otherBtn) => {
            if (otherBtn !== btn) {
              otherBtn.setAttribute('aria-expanded', 'false');
              const otherId = otherBtn.getAttribute('aria-controls');
              if (otherId) {
                const otherContent = document.getElementById(otherId);
                if (otherContent) otherContent.hidden = true;
              }
            }
          });

          if (isExpanded) {
            btn.setAttribute('aria-expanded', 'false');
            if (content) content.hidden = true;
          } else {
            btn.setAttribute('aria-expanded', 'true');
            if (content) content.hidden = false;
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMobileNav);
    } else {
      setupMobileNav();
    }
  })();
</script>

