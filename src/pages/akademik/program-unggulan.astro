---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import programUnggulanData from '../../data/programUnggulan.json';

const { programs } = programUnggulanData;

const breadcrumbItems = [
  { label: 'Akademik', href: '/akademik/kurikulum' },
  { label: 'Program Unggulan' }
];
---

<BaseLayout
  title="Program Unggulan – FREEKS.id School"
  description="5 Program unggulan FREEKS.id School: AI & Coding, Robotics & IoT, 3D Game Dev, Global Speaking, dan Capstone Project."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">5 Program Prioritas</span>
      </div>
      <h1 class="page-title">Program Unggulan & Inovasi</h1>
      <p class="page-description">
        Membekali siswa dengan logika computational thinking, eksplorasi rekayasa teknologi, keterampilan komunikasi global, dan integritas kepemimpinan masa depan.
      </p>

      <!-- Navigasi Anchor di atas (PRD 8.3) -->
      <nav class="anchor-nav" aria-label="Daftar Cepat Program Unggulan">
        <span class="anchor-nav-label">Pilih Program:</span>
        <ul class="anchor-list">
          {programs.map((p) => (
            <li>
              <a href={`#${p.id}`} class="anchor-link">
                <span>{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="container-wide section">
    <div class="programs-detail-list">
      {programs.map((prog, idx) => (
        <section id={prog.id} class="program-detail-card card">
          <div class="prog-detail-grid">
            <div class="prog-detail-media">
              <img
                src={prog.image.src}
                alt={prog.image.alt}
                width={prog.image.width}
                height={prog.image.height}
                class="prog-detail-img"
                loading="lazy"
                data-lightbox-src={prog.image.src}
                data-lightbox-alt={prog.image.alt}
                data-lightbox-caption={`${prog.title} - ${prog.summary}`}
                data-lightbox-group="program-unggulan"
                role="button"
                tabindex="0"
                aria-label={`Lihat foto ${prog.title}`}
              />
              <span class="prog-index-badge">Program #{idx + 1}</span>
            </div>

            <div class="prog-detail-content">
              <h2 class="prog-detail-title">{prog.title}</h2>
              <p class="prog-detail-lead">{prog.summary}</p>
              
              <div class="section-divider"></div>

              <div class="prog-meta-boxes">
                <div class="meta-box">
                  <Icon name="calendar" size={18} class="meta-icon" />
                  <div>
                    <span class="meta-label">Waktu Pelaksanaan:</span>
                    <span class="meta-value">{prog.schedule}</span>
                  </div>
                </div>

                <div class="meta-box">
                  <Icon name="user-check" size={18} class="meta-icon" />
                  <div>
                    <span class="meta-label">Pembina Program:</span>
                    <span class="meta-value">{prog.mentor}</span>
                  </div>
                </div>
              </div>

              <div class="prog-description-text">
                <h4>Tujuan & Capaian Program</h4>
                <p>{prog.description}</p>
              </div>

              <div class="prog-action-row">
                <a href="/ppdb/daftar" class="btn btn-secondary btn-sm">
                  <span>Daftar Siswa Baru</span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
    margin: 0 0 var(--s-5) 0;
  }

  /* Anchor Nav (PRD 8.3) */
  .anchor-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-300);
  }

  @media (min-width: 768px) {
    .anchor-nav {
      flex-direction: row;
      align-items: center;
      gap: 16px;
    }
  }

  .anchor-nav-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-900);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .anchor-list {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }

  .anchor-link {
    display: inline-block;
    padding: 6px 14px;
    background-color: #FFFFFF;
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-900);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease);
  }

  .anchor-link:hover {
    background-color: var(--green-50);
    border-color: var(--green-700);
    color: var(--green-700);
  }

  /* Program Detail Cards */
  .programs-detail-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .program-detail-card {
    padding: var(--s-5);
    scroll-margin-top: calc(var(--header-height-scrolled) + 32px);
  }

  @media (min-width: 1024px) {
    .program-detail-card {
      padding: var(--s-6);
    }
  }

  .prog-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  @media (min-width: 1024px) {
    .prog-detail-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-7);
      align-items: center;
    }
  }

  .prog-detail-media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .prog-detail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }

  .prog-index-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: var(--green-900);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .prog-detail-title {
    font-size: var(--h2);
    color: var(--green-900);
    margin-bottom: 8px;
  }

  .prog-detail-lead {
    font-size: var(--text-base);
    color: var(--ink-600);
    line-height: 1.6;
    margin-bottom: var(--s-4);
  }

  .prog-meta-boxes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-bottom: var(--s-4);
  }

  @media (min-width: 641px) {
    .prog-meta-boxes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .program-detail-card {
      padding: 16px;
    }
    .prog-detail-title {
      font-size: 1.25rem !important;
      line-height: 1.3 !important;
    }
  }

  .meta-box {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    background-color: var(--green-50);
    border-radius: var(--radius-sm);
    border: 1px solid var(--green-200);
    min-width: 0;
  }

  .meta-icon {
    color: var(--green-700);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .meta-label {
    display: block;
    font-size: 11px;
    color: var(--ink-600);
  }

  .meta-value {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-900);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .prog-description-text h4 {
    font-size: var(--text-sm);
    margin-bottom: 6px;
    color: var(--green-900);
  }

  .prog-description-text p {
    font-size: var(--text-sm);
    color: var(--ink-900);
    line-height: 1.6;
    margin-bottom: var(--s-5);
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>

