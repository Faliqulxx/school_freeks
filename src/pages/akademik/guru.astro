---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import guruData from '../../data/guru.json';

const { teachers } = guruData;

const breadcrumbItems = [
  { label: 'Akademik', href: '/akademik/kurikulum' },
  { label: 'Guru & Tenaga Kependidikan' }
];

const categories = ['Semua', 'Pimpinan', 'Kurikulum', 'Kesiswaan', 'Mata Pelajaran', 'Keagamaan', 'Tata Usaha'];
---

<BaseLayout
  title="Mentor & Fasilitator – FREEKS.id School"
  description="Daftar praktisi teknologi, mentor industri, dan pendidik yang membimbing siswa di FREEKS.id School."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">Pendidik Berdedikasi</span>
      </div>
      <h1 class="page-title">Guru & Tenaga Kependidikan</h1>
      <p class="page-description">
        Didukung oleh tenaga pendidik profesional lulusan perguruan tinggi terkemuka dengan keilmuan mendalam serta keteladanan akhlak.
      </p>

      <!-- Filter & Search Controls (PRD 8.3) -->
      <div class="filter-search-bar">
        <!-- Search Input -->
        <div class="search-input-wrap">
          <Icon name="search" size={18} class="search-input-icon" />
          <input
            type="search"
            id="teacher-search"
            class="teacher-search-input"
            placeholder="Cari nama guru atau mata pelajaran..."
            aria-label="Cari nama guru atau mata pelajaran"
          />
        </div>

        <!-- Category Filter Chips -->
        <div class="category-chips-list" role="tablist" aria-label="Filter Kategori Guru">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-chip ${idx === 0 ? 'active' : ''}`}
              data-filter={cat}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container-wide section">
    <!-- Teacher Grid: Desktop 4 cols, Tablet 3 cols, Mobile 2 cols (PRD 8.3) -->
    <div class="teachers-grid" id="teachers-grid">
      {teachers.map((t) => (
        <div
          class="teacher-card card card-clickable"
          data-name={t.name.toLowerCase()}
          data-fullname={t.fullName || t.name}
          data-birth={t.birthPlaceDate || '-'}
          data-subject={t.subject}
          data-position={t.position || t.role}
          data-category={t.category}
          data-photo={t.photo?.src || ''}
          data-photo-alt={t.photo?.alt || t.name}
          tabindex="0"
          role="button"
          aria-haspopup="dialog"
          aria-label={`Lihat detail profil ${t.name} (${t.position || t.role})`}
        >
          <div class="teacher-photo-wrap">
            {t.photo ? (
              <img
                src={t.photo.src}
                alt={t.photo.alt}
                width={t.photo.width}
                height={t.photo.height}
                class="teacher-img"
                loading="lazy"
              />
            ) : (
              <!-- Fallback circle with initials for teacher without photo (PRD A.7 & A.16) -->
              <div class="teacher-empty-photo" aria-label={`Inisial ${t.name}`}>
                <span class="initials-lg">
                  {t.name.split(' ').map(n => n[0]).filter(c => c && /[a-zA-Z]/.test(c)).slice(0, 2).join('')}
                </span>
                <span class="empty-badge">Foto Belum Tersedia</span>
              </div>
            )}
            <span class="teacher-category-tag">{t.category}</span>
          </div>

          <div class="card-body teacher-body">
            <!-- Long name handling (PRD A.16) -->
            <h3 class="teacher-name">{t.name}</h3>
            <span class="teacher-role">{t.role}</span>
            <div class="teacher-subject-box">
              <Icon name="book" size={14} class="subject-icon" />
              <span class="teacher-subject">{t.subject}</span>
            </div>
            <div class="teacher-click-hint">
              <span>Klik untuk detail data</span>
              <Icon name="chevron-right" size={14} />
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Teacher Detail Modal (Popup) -->
    <div id="teacher-modal" class="teacher-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-teacher-fullname" hidden>
      <div class="teacher-modal-backdrop" id="modal-backdrop"></div>
      <div class="teacher-modal-card card">
        <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Tutup jendela detail guru">
          <Icon name="x" size={20} />
        </button>

        <div class="modal-content-grid">
          <div class="modal-photo-wrap">
            <img id="modal-photo" src="/assets/guru-freeks.webp" alt="Foto Guru" class="modal-teacher-img" />
            <span class="chip chip-primary modal-category-badge" id="modal-category">Pimpinan</span>
          </div>

          <div class="modal-info-wrap">
            <div class="modal-header-meta">
              <span class="modal-sub-label">Profil Mentor & Pendidik FREEKS.id School</span>
              <h2 id="modal-teacher-fullname" class="modal-teacher-fullname">Nama Lengkap & Gelar</h2>
              <div class="section-divider"></div>
            </div>

            <div class="modal-data-table">
              <div class="modal-data-row">
                <div class="modal-icon-cell">
                  <Icon name="award" size={20} />
                </div>
                <div class="modal-text-cell">
                  <span class="data-label">Nama Lengkap + Gelar</span>
                  <strong class="data-value" id="modal-name-full">-</strong>
                </div>
              </div>

              <div class="modal-data-row">
                <div class="modal-icon-cell">
                  <Icon name="calendar" size={20} />
                </div>
                <div class="modal-text-cell">
                  <span class="data-label">Tempat & Tanggal Lahir</span>
                  <strong class="data-value" id="modal-birth">-</strong>
                </div>
              </div>

              <div class="modal-data-row">
                <div class="modal-icon-cell">
                  <Icon name="book" size={20} />
                </div>
                <div class="modal-text-cell">
                  <span class="data-label">Mata Pelajaran</span>
                  <strong class="data-value" id="modal-subject">-</strong>
                </div>
              </div>

              <div class="modal-data-row">
                <div class="modal-icon-cell">
                  <Icon name="briefcase" size={20} />
                </div>
                <div class="modal-text-cell">
                  <span class="data-label">Jabatan</span>
                  <strong class="data-value" id="modal-position">-</strong>
                </div>
              </div>
            </div>

            <div class="modal-footer-badge">
              <Icon name="check-circle" size={16} />
              <span>Data resmi terdaftar pada SIMPATIKA / EMIS Kementerian Agama RI</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Empty State if search yields no results -->
    <div id="teachers-empty" class="teachers-empty card" hidden>
      <Icon name="user-x" size={40} class="empty-icon" />
      <h3>Tidak Ditemukan Guru atau Tendik</h3>
      <p>Kata kunci pencarian atau filter yang Anda pilih tidak cocok. Silakan coba kata kunci lain.</p>
      <button type="button" id="reset-teacher-filter" class="btn btn-secondary btn-sm">
        Reset Pencarian
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
    margin-bottom: var(--s-5);
  }

  .filter-search-bar {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-300);
  }

  .search-input-wrap {
    position: relative;
    max-width: 480px;
  }

  .search-input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-600);
  }

  .teacher-search-input {
    width: 100%;
    height: 48px; /* PRD 7.5: Input tinggi 48px, font 16px */
    padding-left: 44px;
    padding-right: 16px;
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-md);
    font-size: 16px;
    color: var(--ink-900);
    background-color: #FFFFFF;
  }

  .teacher-search-input:focus {
    border-color: var(--green-700);
  }

  .category-chips-list {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }

  .filter-chip {
    padding: 8px 16px;
    border-radius: 999px;
    background-color: #FFFFFF;
    border: 1px solid var(--ink-300);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-900);
    cursor: pointer;
    white-space: nowrap;
    min-height: 40px;
    transition: background-color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease);
  }

  .filter-chip.active {
    background-color: var(--green-700);
    border-color: var(--green-700);
    color: #FFFFFF;
  }

  /* Grid: Desktop 4, Tablet 3, HP 2 (PRD 8.3) */
  .teachers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
  }

  @media (min-width: 768px) {
    .teachers-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 1024px) {
    .teachers-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-6);
    }
  }

  .teacher-card {
    height: 100%;
  }

  .teacher-photo-wrap {
    position: relative;
    aspect-ratio: 1 / 1; /* Rasio 1:1 proporsional */
    overflow: hidden;
    background-color: var(--bg-soft);
  }

  .teacher-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Fallback inisial foto kosong (PRD A.7 & A.16) */
  .teacher-empty-photo {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--green-50);
    gap: 8px;
    border-bottom: 1px solid var(--green-200);
  }

  .initials-lg {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--green-200);
    color: var(--green-900);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-badge {
    font-size: 10px;
    color: var(--ink-600);
    font-style: italic;
  }

  .teacher-category-tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: rgba(11, 59, 22, 0.85);
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .teacher-body {
    padding: var(--s-4);
  }

  @media (max-width: 640px) {
    .teachers-grid {
      gap: 10px;
    }
    .teacher-body {
      padding: 10px 12px;
    }
    .teacher-click-hint {
      display: none;
    }
  }

  /* Long name on 2-col card: wrap maksimal 2 baris */
  .teacher-name {
    font-size: clamp(0.88rem, 2.5vw, 1.05rem);
    color: var(--green-900);
    line-height: 1.35;
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Jabatan wrap maksimal 2 baris */
  .teacher-role {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--text-xs);
    color: var(--green-700);
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.35;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .teacher-subject-box {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid #F1F5F9;
    font-size: var(--text-xs);
    color: var(--ink-600);
  }

  .subject-icon {
    color: var(--green-500);
    flex-shrink: 0;
  }

  /* Empty state */
  .teachers-empty {
    padding: var(--s-7) var(--s-5);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .teachers-empty[hidden] {
    display: none !important;
  }

  .empty-icon {
    color: var(--ink-300);
  }

  .teachers-empty h3 {
    color: var(--green-900);
  }

  .teachers-empty p {
    color: var(--ink-600);
    max-width: 48ch;
  }

  /* Teacher Click Hint */
  .teacher-click-hint {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 700;
    color: var(--green-700);
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed var(--ink-300);
    transition: color var(--dur-fast) var(--ease);
  }

  .teacher-card.card-clickable {
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .teacher-card.card-clickable:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-2);
  }

  .teacher-card.card-clickable:hover .teacher-click-hint {
    color: var(--green-900);
  }

  /* Teacher Detail Modal (Popup) */
  .teacher-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-4);
  }

  .teacher-modal-overlay[hidden] {
    display: none;
  }

  .teacher-modal-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(11, 59, 22, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .teacher-modal-card {
    position: relative;
    z-index: 2001;
    width: 100%;
    max-width: 660px;
    background-color: #FFFFFF;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-drawer);
    padding: var(--s-6);
    max-height: 90vh;
    overflow-y: auto;
    animation: modalPop 240ms cubic-bezier(.2, .7, .2, 1);
  }

  @keyframes modalPop {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--ink-300);
    background-color: #FFFFFF;
    color: var(--ink-600);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
    z-index: 10;
  }

  .modal-close-btn:hover {
    background-color: var(--green-50);
    color: var(--green-900);
    border-color: var(--green-700);
  }

  .modal-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  @media (min-width: 640px) {
    .modal-content-grid {
      grid-template-columns: 210px 1fr;
      align-items: start;
      gap: var(--s-6);
    }
  }

  .modal-photo-wrap {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--green-50);
    box-shadow: var(--shadow-1);
  }

  .modal-teacher-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .modal-category-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
  }

  .modal-info-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .modal-sub-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .modal-teacher-fullname {
    font-size: var(--h3);
    color: var(--green-900);
    margin: 4px 0 8px 0;
    line-height: 1.25;
  }

  .modal-data-table {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: var(--bg-soft);
    padding: var(--s-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--ink-300);
  }

  .modal-data-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .modal-icon-cell {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--green-200);
    color: var(--green-900);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .modal-text-cell {
    display: flex;
    flex-direction: column;
  }

  .data-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-600);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .data-value {
    font-size: var(--text-sm);
    color: var(--green-900);
    line-height: 1.45;
    margin-top: 2px;
  }

  .modal-footer-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--green-800);
    background-color: var(--green-50);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    margin-top: 4px;
  }
</style>

<script>
  // Interactive client-side filter and search
  const searchInput = document.getElementById('teacher-search') as HTMLInputElement | null;
  const filterChips = document.querySelectorAll('.filter-chip');
  const teacherCards = document.querySelectorAll('.teacher-card') as NodeListOf<HTMLElement>;
  const emptyBox = document.getElementById('teachers-empty');
  const resetBtn = document.getElementById('reset-teacher-filter');

  let activeCategory = 'Semua';
  let searchQuery = '';

  function applyFilter() {
    let visibleCount = 0;

    teacherCards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const subject = card.getAttribute('data-subject') || '';
      const category = card.getAttribute('data-category') || '';

      const matchesSearch = !searchQuery || name.includes(searchQuery) || subject.includes(searchQuery);
      const matchesCategory = activeCategory === 'Semua' || category === activeCategory;

      if (matchesSearch && matchesCategory) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyBox) {
      emptyBox.hidden = visibleCount > 0;
      emptyBox.style.display = visibleCount > 0 ? 'none' : 'flex';
    }
  }

  // Initial call on page load
  applyFilter();

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilter();
  });

  filterChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      filterChips.forEach(c => {
        c.classList.remove('active');
        c.setAttribute('aria-selected', 'false');
      });
      chip.classList.add('active');
      chip.setAttribute('aria-selected', 'true');
      activeCategory = chip.getAttribute('data-filter') || 'Semua';
      applyFilter();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'Semua';
    filterChips.forEach((c, idx) => {
      if (idx === 0) {
        c.classList.add('active');
        c.setAttribute('aria-selected', 'true');
      } else {
        c.classList.remove('active');
        c.setAttribute('aria-selected', 'false');
      }
    });
    applyFilter();
  });

  // Modal interaction logic
  const modal = document.getElementById('teacher-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('modal-close-btn');

  const modalPhoto = document.getElementById('modal-photo') as HTMLImageElement | null;
  const modalCategory = document.getElementById('modal-category');
  const modalTeacherFullname = document.getElementById('modal-teacher-fullname');
  const modalNameFull = document.getElementById('modal-name-full');
  const modalPosition = document.getElementById('modal-position');
  const modalSubject = document.getElementById('modal-subject');
  const modalBirth = document.getElementById('modal-birth');

  let lastFocusedCard: HTMLElement | null = null;

  function openTeacherModal(card: HTMLElement) {
    lastFocusedCard = card;
    const fullname = card.getAttribute('data-fullname') || '-';
    const birth = card.getAttribute('data-birth') || '-';
    const subject = card.getAttribute('data-subject') || '-';
    const position = card.getAttribute('data-position') || '-';
    const category = card.getAttribute('data-category') || 'Pendidik';
    const photo = card.getAttribute('data-photo') || '/assets/guru-freeks.webp';
    const photoAlt = card.getAttribute('data-photo-alt') || fullname;

    if (modalPhoto) {
      modalPhoto.src = photo;
      modalPhoto.alt = photoAlt;
    }
    if (modalCategory) modalCategory.textContent = category;
    if (modalTeacherFullname) modalTeacherFullname.textContent = fullname;
    if (modalNameFull) modalNameFull.textContent = fullname;
    if (modalBirth) modalBirth.textContent = birth;
    if (modalSubject) modalSubject.textContent = subject;
    if (modalPosition) modalPosition.textContent = position;

    if (modal) {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }
  }

  function closeTeacherModal() {
    if (modal) {
      modal.hidden = true;
      document.body.style.overflow = '';
      lastFocusedCard?.focus();
    }
  }

  teacherCards.forEach((card) => {
    card.addEventListener('click', () => openTeacherModal(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openTeacherModal(card);
      }
    });
  });

  closeBtn?.addEventListener('click', closeTeacherModal);
  backdrop?.addEventListener('click', closeTeacherModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) {
      closeTeacherModal();
    }
  });
</script>

