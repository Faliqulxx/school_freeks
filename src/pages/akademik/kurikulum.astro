---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import kurikulumData from '../../data/kurikulum.json';

const breadcrumbItems = [
  { label: 'Akademik', href: '/akademik/kurikulum' },
  { label: 'Kurikulum' }
];
---

<BaseLayout
  title="Kurikulum Teknologi & Inovasi – FREEKS.id School"
  description="Struktur kurikulum modern FREEKS.id School: Kurikulum Merdeka terintegrasi dengan computational thinking, AI terapan, dan project-based learning."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">{kurikulumData.system}</span>
      </div>
      <h1 class="page-title">Struktur Kurikulum & Pembelajaran</h1>
      <p class="page-description">{kurikulumData.description}</p>
    </div>
  </div>

  <div class="container-wide section">
    <!-- P5-PPRA Card -->
    <div class="p5pra-box card">
      <div class="p5pra-icon-wrap">
        <Icon name="sparkles" size={28} />
      </div>
      <div>
        <h3 class="p5pra-title">{kurikulumData.p5pra.title}</h3>
        <p class="p5pra-desc">{kurikulumData.p5pra.description}</p>
      </div>
    </div>

    <!-- Subject Groups -->
    {kurikulumData.subjectGroups.map((group) => (
      <section class="subject-group-section">
        <div class="section-header">
          <h2>{group.group}</h2>
          <div class="section-divider"></div>
        </div>

        <!-- Responsive Table: Desktop table, Mobile Stacked Cards (PRD 8.3 & 10) -->
        <div class="table-wrapper">
          <table class="data-table table-responsive-stacked">
            <thead>
              <tr>
                <th style="width: 80px;">Kode</th>
                <th>Mata Pelajaran</th>
                <th style="width: 120px; text-align: center;">Jam / Minggu</th>
                <th>Capaian & Fokus Pembelajaran</th>
              </tr>
            </thead>
            <tbody>
              {group.subjects.map((sub) => (
                <tr>
                  <td data-label="Kode Mapel">
                    <span class="subject-code-badge">{sub.code}</span>
                  </td>
                  <td data-label="Mata Pelajaran">
                    <strong>{sub.name}</strong>
                  </td>
                  <td data-label="Beban Jam" style="text-align: center;">
                    <span class="hours-tag">{sub.hours} JP</span>
                  </td>
                  <td data-label="Fokus Pembelajaran" style="text-align: left;">
                    <span class="focus-text">{sub.description}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
    margin: 0;
  }

  .p5pra-box {
    display: flex;
    align-items: flex-start;
    padding: var(--s-5);
    gap: var(--s-4);
    background-color: var(--green-50);
    border: 1px solid var(--green-200);
    margin-bottom: var(--s-7);
    min-width: 0;
  }

  @media (max-width: 640px) {
    .p5pra-box {
      flex-direction: column;
      gap: 12px;
      padding: 16px;
    }
    .p5pra-icon-wrap {
      width: 44px;
      height: 44px;
    }
  }

  .table-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
    margin-bottom: var(--s-5);
  }

  @media (max-width: 767px) {
    .table-responsive-stacked td[data-label="Fokus Pembelajaran"] {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: 6px;
    }
    .table-responsive-stacked td[data-label="Fokus Pembelajaran"]::before {
      padding-right: 0;
    }
  }

  .p5pra-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background-color: var(--green-700);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .p5pra-title {
    font-size: 1.15rem;
    color: var(--green-900);
    margin-bottom: 6px;
    overflow-wrap: break-word;
  }

  .p5pra-desc {
    font-size: var(--text-sm);
    color: var(--ink-900);
    line-height: 1.6;
    margin: 0;
    overflow-wrap: break-word;
  }

  .subject-group-section {
    margin-bottom: var(--s-7);
    min-width: 0;
  }

  .subject-code-badge {
    display: inline-block;
    padding: 3px 8px;
    background-color: var(--bg-soft);
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: var(--text-xs);
    color: var(--green-800);
  }

  .hours-tag {
    display: inline-block;
    padding: 4px 10px;
    background-color: var(--green-50);
    color: var(--green-900);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: var(--text-xs);
  }

  .focus-text {
    font-size: var(--text-sm);
    color: var(--ink-600);
    line-height: 1.5;
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>

