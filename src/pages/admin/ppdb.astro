    originSchool: "SD Kreatif Digital Surabaya",
    parentName: "Ahmad Syafi'i",
    phone: "082145678901",
    wave: "Early Bird Wave",
    date: "2027-01-08",
    status: "Menunggu Verifikasi",
    assessmentScore: "Dalam Peninjauan Berkas"
  },
  {
    id: "REG-2027-003",
    name: "Rafi Ahmad Fauzan",
    gender: "Laki-laki",
    originSchool: "SD Prestasi Mandiri",
    parentName: "Hendra Wijaya",
    phone: "085678901234",
    wave: "Early Bird Wave",
    date: "2027-01-12",
    status: "Diterima",
    assessmentScore: "A- (Skor Logika 92 - Minat Robotika)"
  },
  {
    id: "REG-2027-004",
    name: "Nabila Zahratun Nisa",
    gender: "Perempuan",
    originSchool: "SD Global Islamic Tech",
    parentName: "H. Abdul Wahid",
    phone: "081398765432",
    wave: "Early Bird Wave",
    date: "2027-01-16",
    status: "Cadangan",
    assessmentScore: "B+ (Skor Logika 85 - Jalur Desain UI/UX)"
  },
  {
    id: "REG-2027-005",
    name: "Arya Maulana",
    gender: "Laki-laki",
    originSchool: "SD Nusantara Bintang",
    parentName: "Drs. M. Subhan",
    phone: "087812345678",
    wave: "Early Bird Wave",
