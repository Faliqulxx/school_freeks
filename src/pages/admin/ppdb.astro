---

<AdminLayout title="Manajemen PPDB Online (Modul 7)" activeMenu="ppdb">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 7 DARI 8</div>
      <h1>Manajemen PPDB & Data Pendaftar</h1>
      <p class="page-subtitle">
        Kelola jadwal gelombang pendaftaran, status kuota penerimaan siswa, rincian biaya starter pack & fasilitas teknologi, tanya jawab FAQ calon siswa, dan verifikasi kelulusan pendaftar online.
      </p>
    </div>

    <div class="header-action-group">
      <a href="/ppdb" target="_blank" class="btn btn-secondary">
        <Icon name="external-link" size={16} />
        <span>Buka Web Publik</span>
      </a>
      <button type="button" id="btn-export-ppdb-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-ppdb" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Data PPDB Berhasil Diperbarui!</strong>
      <p>Data pengaturan gelombang, rincian biaya, dan status pendaftar telah tersimpan secara lokal di browser Anda.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <!-- Sub-Modul Tab Navigation -->
  <div class="section-tabs-bar" role="tablist">
    <button type="button" class="tab-btn active" data-tab="tab-status" role="tab" aria-selected="true">
      <Icon name="settings" size={16} />
      <span>1. Status & Kuota</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-gelombang" role="tab" aria-selected="false">
      <Icon name="calendar" size={16} />
      <span>2. Gelombang & Jadwal</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-biaya" role="tab" aria-selected="false">
      <Icon name="dollar-sign" size={16} />
      <span>3. Syarat & Biaya</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-faq" role="tab" aria-selected="false">
      <Icon name="help-circle" size={16} />
      <span>4. FAQ Calon Siswa</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-pendaftar" role="tab" aria-selected="false">
      <Icon name="user-check" size={16} />
      <span>5. Data Pendaftar Online</span>
    </button>
  </div>

  <div class="ppdb-layout-grid">
    <!-- Left Column: Forms -->
    <div class="form-container">
      <form id="ppdb-form" onsubmit="return false;">

        <!-- ========================================== -->
        <!-- SUB-MODUL 1: STATUS & KUOTA -->
        <!-- ========================================== -->
        <div class="tab-panel active" id="tab-status">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="check-circle" size={20} />
              </div>
              <div>
                <h3>Status Pembukaan Pendaftaran</h3>
                <p class="card-desc">Atur status pendaftaran aktif dan teks badge yang muncul di beranda dan halaman PPDB.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-ppdb-year">Tahun Ajaran <span class="req">*</span></label>
                <input type="text" id="input-ppdb-year" value={academicYear} required class="form-control" />
              </div>

              <div class="form-group">
                <label for="input-ppdb-status-type">Status Operasional <span class="req">*</span></label>
                <select id="input-ppdb-status-type" class="form-control">
                  <option value="open" selected={statusType === 'open'}>Pendaftaran Dibuka (Open)</option>
                  <option value="closed" selected={statusType === 'closed'}>Pendaftaran Ditutup (Closed)</option>
                </select>
              </div>

              <div class="form-group col-span-2">
                <label for="input-ppdb-status-text">Teks Tampilan Status (Badge) <span class="req">*</span></label>
                <input type="text" id="input-ppdb-status-text" value={status} required class="form-control" />
                <span class="form-help">Contoh: "Dibuka s.d. 28 Februari 2027"</span>
              </div>
            </div>
          </div>

          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="users" size={20} />
              </div>
              <div>
                <h3>Alokasi Kuota & Daya Tampung</h3>
                <p class="card-desc">Pengaturan jumlah rombongan belajar dan kapasitas maksimal penerimaan siswa baru.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-quota-total">Total Daya Tampung (Siswa) <span class="req">*</span></label>
                <input type="number" id="input-quota-total" value={quota.total} required class="form-control" />
              </div>

              <div class="form-group">
                <label for="input-quota-classes">Jumlah Rombel (Kelas) <span class="req">*</span></label>
                <input type="number" id="input-quota-classes" value={quota.classes} required class="form-control" />
              </div>

              <div class="form-group">
                <label for="input-quota-perclass">Kapasitas Maksimal Per Kelas <span class="req">*</span></label>
                <input type="number" id="input-quota-perclass" value={quota.perClass} required class="form-control" />
              </div>

              <div class="form-group">
                <label for="input-quota-perwave">Target Kuota Per Gelombang <span class="req">*</span></label>
                <input type="number" id="input-quota-perwave" value={quota.perWave} required class="form-control" />
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 2: GELOMBANG & JADWAL -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-gelombang">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="calendar" size={20} />
                </div>
                <div>
                  <h3>Jadwal Gelombang Pendaftaran (CRUD)</h3>
                  <p class="card-desc">Atur rentang masa registrasi, sesi asesmen minat & logika, pengumuman hasil, dan konfirmasi daftar ulang.</p>
                </div>
              </div>
              <button type="button" id="btn-add-wave" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Gelombang</span>
              </button>
            </div>

            <div class="waves-admin-list" id="waves-list-container">
              {waves.map((w, idx) => (
                <div class="wave-admin-card" data-idx={idx}>
                  <div class="wave-card-header">
                    <div class="wave-title-row">
                      <span class={`wave-status-chip ${w.isCurrent ? 'active' : ''}`}>
                        {w.isCurrent ? 'Gelombang Aktif' : 'Akan Datang'}
                      </span>
                      <h4>{w.name}</h4>
                    </div>
                    <div class="wave-actions">
                      <button type="button" class="btn-action-edit btn-edit-wave" data-idx={idx} title="Edit Gelombang">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-wave" data-idx={idx} title="Hapus Gelombang">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>

                  <div class="wave-dates-grid">
                    <div>
                      <small>Pendaftaran</small>
                      <strong>{w.registration}</strong>
                    </div>
                    <div>
                      <small>Asesmen & Wawancara</small>
                      <strong>{w.selection}</strong>
                    </div>
                    <div>
                      <small>Pengumuman</small>
                      <strong>{w.announcement}</strong>
                    </div>
                    <div>
                      <small>Daftar Ulang</small>
                      <strong>{w.reRegistration}</strong>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Wave -->
          <div class="form-card card" id="modal-wave" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-wave-title">Atur Jadwal Gelombang</h3>
                <p class="card-desc">Lengkapi nama gelombang dan tanggal-tanggal penting penerimaan.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-wave-idx" value="" />
              <div class="form-group">
                <label for="input-wave-name">Nama Gelombang <span class="req">*</span></label>
                <input type="text" id="input-wave-name" placeholder="Contoh: Early Bird Wave / Gelombang 1" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-wave-is-current">Status Keaktifan</label>
                <select id="input-wave-is-current" class="form-control">
                  <option value="true">Gelombang Aktif Saat Ini</option>
                  <option value="false">Belum Aktif / Selesai</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-wave-reg">Rentang Pendaftaran <span class="req">*</span></label>
                <input type="text" id="input-wave-reg" placeholder="Contoh: 4 Jan – 28 Feb 2027" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-wave-sel">Tanggal Asesmen Minat & Logika <span class="req">*</span></label>
                <input type="text" id="input-wave-sel" placeholder="Contoh: 6 Mar 2027" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-wave-ann">Tanggal Pengumuman Hasil <span class="req">*</span></label>
                <input type="text" id="input-wave-ann" placeholder="Contoh: 12 Mar 2027" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-wave-rereg">Masa Daftar Ulang & Onboarding <span class="req">*</span></label>
                <input type="text" id="input-wave-rereg" placeholder="Contoh: 15 – 27 Mar 2027" class="form-control" />
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-wave" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-wave-item" class="btn btn-primary">Simpan Gelombang</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 3: SYARAT & BIAYA -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-biaya">
          <!-- Syarat Pendaftaran -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="check" size={20} />
                </div>
                <div>
                  <h3>Berkas Persyaratan Masuk (CRUD)</h3>
                  <p class="card-desc">Daftar dokumen digital dan persyaratan usia calon siswa baru Sekolah Contoh Indonesia.</p>
                </div>
              </div>
              <button type="button" id="btn-add-req" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Syarat</span>
              </button>
            </div>

            <div class="requirements-admin-list" id="req-list-container">
              {requirements.map((req, idx) => (
                <div class="req-item-row" data-idx={idx}>
                  <div class="req-num">{idx + 1}</div>
                  <input type="text" class="form-control req-input" value={req} />
                  <button type="button" class="btn-action-delete btn-del-req" data-idx={idx} title="Hapus Syarat">
                    <Icon name="trash-2" size={14} />
                    <span>Hapus</span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Rincian Biaya -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="dollar-sign" size={20} />
                </div>
                <div>
                  <h3>Komponen Biaya Pendaftaran & Fasilitas (CRUD)</h3>
                  <p class="card-desc">Biaya awal masuk, sarpras & lab teknologi, starter pack apparel resmi, modul digital, dan iuran edukasi bulanan.</p>
                </div>
              </div>
              <button type="button" id="btn-add-cost" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Komponen</span>
              </button>
            </div>

            <div class="costs-admin-list" id="costs-list-container">
              {costs.items.map((c, idx) => (
                <div class="cost-admin-item" data-idx={idx}>
                  <div class="cost-main-row">
                    <input type="text" class="form-control cost-comp-input" value={c.component} placeholder="Nama Komponen..." />
                    <input type="text" class="form-control cost-amt-input" value={c.amount} placeholder="Nominal (Rp)..." />
                    <button type="button" class="btn-action-delete btn-del-cost" data-idx={idx} title="Hapus Komponen">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                  <input type="text" class="form-control cost-note-input" value={c.note} placeholder="Catatan/Keterangan cicilan..." />
                </div>
              ))}
            </div>

            <div class="form-grid mt-2">
              <div class="form-group col-span-2">
                <label for="input-costs-concession">Keterangan Program Beasiswa & Keringanan Biaya</label>
                <textarea id="input-costs-concession" rows="2" class="form-control">{costs.concession}</textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 4: FAQ PPDB -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-faq">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="help-circle" size={20} />
                </div>
                <div>
                  <h3>Pertanyaan Umum / FAQ PPDB (CRUD)</h3>
                  <p class="card-desc">Jawaban pertanyaan seputar asesmen eksplorasi logika, skema cicilan sarpras, kurikulum teknologi, dan tata cara pendaftaran.</p>
                </div>
              </div>
              <button type="button" id="btn-add-faq" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah FAQ</span>
              </button>
            </div>

            <div class="faq-admin-list" id="faq-list-container">
              {faq.map((item, idx) => (
                <div class="faq-admin-card" data-idx={idx}>
                  <div class="faq-header-row">
                    <input type="text" class="form-control faq-q-input" value={item.q} placeholder="Pertanyaan..." />
                    <button type="button" class="btn-action-delete btn-del-faq" data-idx={idx} title="Hapus FAQ">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                  <textarea rows="2" class="form-control faq-a-input" placeholder="Jawaban resmi...">{item.a}</textarea>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 5: DATA PENDAFTAR ONLINE -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-pendaftar">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="user-check" size={20} />
                </div>
                <div>
                  <h3>Data Calon Siswa Baru Online</h3>
                  <p class="card-desc">Verifikasi berkas pendaftar, hasil asesmen minat & logika, ubah status penerimaan, dan ekspor data ke format CSV.</p>
                </div>
              </div>

              <div class="table-actions-group">
                <button type="button" id="btn-export-csv" class="btn btn-secondary btn-sm">
                  <Icon name="file-text" size={15} />
                  <span>Ekspor CSV</span>
                </button>
                <button type="button" id="btn-add-applicant" class="btn btn-primary btn-sm">
                  <Icon name="plus" size={15} />
                  <span>Tambah Pendaftar</span>
                </button>
              </div>
            </div>

            <!-- Filter Status Pill Bar -->
            <div class="filter-pills-row">
              <span class="filter-label">Filter:</span>
              <button type="button" class="filter-pill active" data-filter="all">Semua (<span id="count-all">5</span>)</button>
              <button type="button" class="filter-pill" data-filter="Menunggu Verifikasi">Menunggu (<span id="count-pending">2</span>)</button>
              <button type="button" class="filter-pill" data-filter="Diterima">Diterima (<span id="count-accepted">2</span>)</button>
              <button type="button" class="filter-pill" data-filter="Cadangan">Cadangan (<span id="count-waiting">1</span>)</button>
            </div>

            <!-- Table of Applicants -->
            <div class="table-responsive">
              <table class="admin-data-table" id="applicants-table">
                <thead>
                  <tr>
                    <th>No. Reg</th>
                    <th>Nama Calon Siswa</th>
                    <th>Asal Sekolah</th>
                    <th>Wali & Kontak WhatsApp</th>
                    <th>Hasil Asesmen Minat & Logika</th>
                    <th>Status Kelulusan</th>
                    <th style="min-width: 140px;">Aksi</th>
                  </tr>
                </thead>
                <tbody id="applicants-tbody">
                  <!-- Dynamically rendered -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Modal Edit Applicant Status -->
          <div class="form-card card" id="modal-applicant" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-app-title">Verifikasi Calon Siswa</h3>
                <p class="card-desc">Ubah status seleksi pendaftaran dan skor hasil asesmen minat/logika calon siswa.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-app-idx" value="" />
              <div class="form-group">
                <label for="input-app-id">Nomor Registrasi</label>
                <input type="text" id="input-app-id" readonly class="form-control" style="background:#F3F4F6;" />
              </div>
              <div class="form-group">
                <label for="input-app-name">Nama Calon Siswa <span class="req">*</span></label>
                <input type="text" id="input-app-name" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-app-origin">Asal SD/MI Sederajat <span class="req">*</span></label>
                <input type="text" id="input-app-origin" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-app-parent">Nama Orang Tua / Wali <span class="req">*</span></label>
                <input type="text" id="input-app-parent" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-app-phone">Nomor HP / WhatsApp Wali <span class="req">*</span></label>
                <input type="text" id="input-app-phone" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-app-quran">Hasil Asesmen Minat & Logika</label>
                <input type="text" id="input-app-quran" placeholder="Contoh: A (Skor Logika 94/100, Minat Robotika) / Dalam Peninjauan" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-app-status">Status Penerimaan Siswa <span class="req">*</span></label>
                <select id="input-app-status" class="form-control font-semibold">
                  <option value="Menunggu Verifikasi">Menunggu Verifikasi Berkas</option>
                  <option value="Diterima">Diterima (Lolos Seleksi)</option>
                  <option value="Cadangan">Cadangan (Menunggu Kuota)</option>
                  <option value="Ditolak">Ditolak / Berkas Tidak Memenuhi</option>
                </select>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-app" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-app-item" class="btn btn-primary">Simpan Status Verifikasi</button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Interactive Live Preview -->
    <aside class="preview-container">
      <div class="preview-sticky-wrap">
        <div class="card preview-card">
          <div class="card-header-sm">
            <div class="flex-align-center gap-2">
              <Icon name="eye" size={18} />
              <h4>Pratinjau PPDB</h4>
            </div>
