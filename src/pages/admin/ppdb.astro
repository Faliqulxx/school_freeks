          </div>
        `;
        wavesContainer.appendChild(card);
      });

      document.querySelectorAll('.btn-edit-w').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingWaveIdx = idx;
          const w = wavesState[idx];
          document.getElementById('modal-wave-title').textContent = 'Edit Gelombang';
          document.getElementById('input-wave-name').value = w.name;
          document.getElementById('input-wave-is-current').value = w.isCurrent ? 'true' : 'false';
          document.getElementById('input-wave-reg').value = w.registration;
          document.getElementById('input-wave-sel').value = w.selection;
          document.getElementById('input-wave-ann').value = w.announcement;
          document.getElementById('input-wave-rereg').value = w.reRegistration;
          modalWave.style.display = 'block';
          modalWave.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-w').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = wavesState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus "${item.name}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              wavesState.splice(idx, 1);
              renderWavesList();
            });
          } else if (confirm(msg)) {
            wavesState.splice(idx, 1);
            renderWavesList();
          }
        });
      });

      if (wavesState.length > 0) {
        if (document.getElementById('sim-wave-name')) document.getElementById('sim-wave-name').textContent = wavesState[0].name;
        if (document.getElementById('sim-wave-reg')) document.getElementById('sim-wave-reg').textContent = wavesState[0].registration;
