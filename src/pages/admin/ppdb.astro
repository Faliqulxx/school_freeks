        const isCurrent = document.getElementById('input-wave-is-current').value === 'true';
        const registration = document.getElementById('input-wave-reg').value.trim();
        const selection = document.getElementById('input-wave-sel').value.trim();
        const announcement = document.getElementById('input-wave-ann').value.trim();
        const reRegistration = document.getElementById('input-wave-rereg').value.trim();
        if (!name || !registration) {
          alert('Mohon lengkapi nama gelombang dan rentang pendaftaran!');
          return;
        }
        if (isCurrent) {
          wavesState.forEach(w => w.isCurrent = false);
        }
        const obj = { name, isCurrent, registration, selection, announcement, reRegistration };
        if (editingWaveIdx >= 0) {
          wavesState[editingWaveIdx] = obj;
        } else {
          wavesState.push(obj);
        }
        modalWave.style.display = 'none';
        renderWavesList();
