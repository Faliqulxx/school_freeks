          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus data pendaftar "${item.name}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              applicantsState.splice(idx, 1);
              renderApplicantsTable();
            });
          } else if (confirm(msg)) {
            applicantsState.splice(idx, 1);
            renderApplicantsTable();
          }
        });
      });
    }

    // Filter pills
    document.querySelectorAll('.filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.getAttribute('data-filter');
        renderApplicantsTable();
      });
    });

    const btnAddApp = document.getElementById('btn-add-applicant');
    if (btnAddApp) {
      btnAddApp.addEventListener('click', () => {
        editingAppIdx = -1;
        document.getElementById('modal-app-title').textContent = 'Tambah Calon Siswa Baru';
        document.getElementById('input-app-id').value = 'REG-2027-' + String(applicantsState.length + 1).padStart(3, '0');
        document.getElementById('input-app-name').value = '';
        document.getElementById('input-app-origin').value = '';
        document.getElementById('input-app-parent').value = '';
        document.getElementById('input-app-phone').value = '0812';
        document.getElementById('input-app-quran').value = 'Dalam Peninjauan Berkas';
        document.getElementById('input-app-status').value = 'Menunggu Verifikasi';
        modalApp.style.display = 'block';
        modalApp.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelApp = document.getElementById('btn-cancel-app');
    if (btnCancelApp) btnCancelApp.addEventListener('click', () => { modalApp.style.display = 'none'; });

    const btnSaveAppItem = document.getElementById('btn-save-app-item');
    if (btnSaveAppItem) {
      btnSaveAppItem.addEventListener('click', () => {
        const id = document.getElementById('input-app-id').value;
        const name = document.getElementById('input-app-name').value.trim();
        const originSchool = document.getElementById('input-app-origin').value.trim();
        const parentName = document.getElementById('input-app-parent').value.trim();
        const phone = document.getElementById('input-app-phone').value.trim();
        const assessmentScore = document.getElementById('input-app-quran').value.trim();
        const status = document.getElementById('input-app-status').value;

        if (!name || !originSchool || !parentName) {
          alert('Mohon lengkapi nama calon siswa, asal sekolah, dan orang tua!');
          return;
        }

        const obj = { id, name, originSchool, parentName, phone, assessmentScore, status, wave: wavesState[0]?.name || "Early Bird Wave" };
        if (editingAppIdx >= 0) {
          applicantsState[editingAppIdx] = obj;
        } else {
          applicantsState.push(obj);
        }
        modalApp.style.display = 'none';
        renderApplicantsTable();
      });
    }

    // Export CSV
    const btnExportCSV = document.getElementById('btn-export-csv');
    if (btnExportCSV) {
      btnExportCSV.addEventListener('click', () => {
        let csv = "Nomor Registrasi,Nama Calon Siswa,Asal Sekolah,Nama Orang Tua/Wali,Nomor HP/WA,Gelombang,Asesmen Minat & Logika,Status Penerimaan\n";
        applicantsState.forEach(a => {
          csv += `"${a.id}","${a.name}","${a.originSchool}","${a.parentName}","${a.phone}","${a.wave}","${a.assessmentScore || a.quranScore || '-'}","${a.status}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `rekap-pendaftar-ppdb-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Save All PPDB
    function handleSavePPDB() {
      // Collect costs
      const costItems = [];
      document.querySelectorAll('.cost-admin-item').forEach(item => {
        const comp = item.querySelector('.cost-comp-input')?.value.trim();
        const amt = item.querySelector('.cost-amt-input')?.value.trim();
        const note = item.querySelector('.cost-note-input')?.value.trim();
        if (comp && amt) costItems.push({ component: comp, amount: amt, note });
      });

      // Collect FAQ
      const faqItems = [];
      document.querySelectorAll('.faq-admin-card').forEach(item => {
        const q = item.querySelector('.faq-q-input')?.value.trim();
        const a = item.querySelector('.faq-a-input')?.value.trim();
        if (q && a) faqItems.push({ q, a });
      });

      // Collect Reqs
      const reqItems = [];
      document.querySelectorAll('.req-input').forEach(item => {
        if (item.value.trim()) reqItems.push(item.value.trim());
      });

      const payload = {
        updatedAt: new Date().toISOString(),
        academicYear: document.getElementById('input-ppdb-year')?.value || '2027/2028',
        status: document.getElementById('input-ppdb-status-text')?.value || '',
        statusType: document.getElementById('input-ppdb-status-type')?.value || 'open',
        totalQuota: parseInt(document.getElementById('input-quota-total')?.value, 10) || 120,
        classesCount: parseInt(document.getElementById('input-quota-classes')?.value, 10) || 4,
        waves: wavesState,
        requirements: reqItems,
        costs: costItems,
        concession: document.getElementById('input-costs-concession')?.value || '',
        faq: faqItems,
        applicants: applicantsState
      };

      localStorage.setItem('mts_cms_ppdb_data', JSON.stringify(payload));

      const toast = document.getElementById('save-toast');
      if (toast) {
        toast.hidden = false;
        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    const btnSave1 = document.getElementById('btn-save-ppdb');
    const btnSave2 = document.getElementById('btn-save-ppdb-side');
    if (btnSave1) btnSave1.addEventListener('click', handleSavePPDB);
    if (btnSave2) btnSave2.addEventListener('click', handleSavePPDB);

    const toastClose = document.getElementById('toast-close');
    if (toastClose) toastClose.addEventListener('click', () => { document.getElementById('save-toast').hidden = true; });

    // Export JSON
    const btnExportJSON = document.getElementById('btn-export-ppdb-json');
    if (btnExportJSON) {
      btnExportJSON.addEventListener('click', () => {
        const saved = localStorage.getItem('mts_cms_ppdb_data');
        const dataObj = saved ? JSON.parse(saved) : { waves: wavesState, costs: costsState, faq: faqState, applicants: applicantsState };
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(dataObj, null, 2));
        const a = document.createElement('a');
        a.setAttribute('href', dataStr);
        a.setAttribute('download', `ppdb-cms-${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Initial render
    renderWavesList();
    renderRequirementsList();
    renderCostsList();
    renderFaqList();
    renderApplicantsTable();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPPDB);
  } else {
    initPPDB();
  }
</script>
