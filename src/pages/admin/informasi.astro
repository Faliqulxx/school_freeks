---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import beritaData from '../../data/berita.json';
import pengumumanData from '../../data/pengumuman.json';
import galeriData from '../../data/galeri.json';
import unduhanData from '../../data/unduhan.json';

const { articles } = beritaData;
const { announcements } = pengumumanData;
const { albums } = galeriData;
const { downloads } = unduhanData;
---

<AdminLayout title="Manajemen Informasi & Berita (Modul 6)" activeMenu="informasi">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 6 DARI 8</div>
      <h1>Manajemen Informasi & Publikasi</h1>
      <p class="page-subtitle">
        Publikasikan artikel berita Sekolah, surat edaran pengumuman resmi, album dokumentasi galeri foto, dan pusat unduhan berkas publik.
      </p>
    </div>

    <div class="header-action-group">
      <a href="/informasi/berita" target="_blank" class="btn btn-secondary">
        <Icon name="external-link" size={16} />
        <span>Buka Web Publik</span>
      </a>
      <button type="button" id="btn-export-informasi-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-informasi" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Publikasi Berhasil Disimpan!</strong>
      <p>Data artikel berita, pengumuman, album galeri, dan repositori unduhan telah diperbarui secara lokal.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <!-- Sub-Modul Tab Navigation -->
  <div class="section-tabs-bar" role="tablist">
    <button type="button" class="tab-btn active" data-tab="tab-berita" role="tab" aria-selected="true">
      <Icon name="newspaper" size={16} />
      <span>1. Berita & Kegiatan</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-pengumuman" role="tab" aria-selected="false">
      <Icon name="bell" size={16} />
      <span>2. Pengumuman Resmi</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-galeri" role="tab" aria-selected="false">
      <Icon name="image" size={16} />
      <span>3. Galeri Foto Album</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-unduhan" role="tab" aria-selected="false">
      <Icon name="download" size={16} />
      <span>4. Pusat Unduhan Berkas</span>
    </button>
  </div>

  <div class="informasi-layout-grid">
    <!-- Left Column: Forms -->
    <div class="form-container">
      <form id="informasi-form" onsubmit="return false;">

        <!-- ========================================== -->
        <!-- SUB-MODUL 1: BERITA & ARTIKEL -->
        <!-- ========================================== -->
        <div class="tab-panel active" id="tab-berita">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="newspaper" size={20} />
                </div>
                <div>
                  <h3>Daftar Artikel Berita Sekolah (CRUD)</h3>
                  <p class="card-desc">Publikasikan liputan kegiatan sekolah, prestasi siswa inovatif, dan artikel teknologi edukasi.</p>
                </div>
              </div>
              <button type="button" id="btn-add-article" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tulis Berita Baru</span>
              </button>
            </div>

            <div class="articles-admin-list" id="articles-list-container">
              {articles.map((art, idx) => (
                <div class="article-admin-card" data-idx={idx}>
                  <div class="article-thumb-wrap">
                    <img src={art.image.src} alt={art.title} class="article-thumb" onerror="this.src='/assets/berita-kegiatan-osis.webp'" />
                  </div>
                  <div class="article-content-col">
                    <div class="article-badges-row">
                      <span class="cat-pill">{art.category}</span>
                      <span class="date-text">{art.date}</span>
                      <span class="author-text">Oleh: {art.author}</span>
                    </div>
                    <h4>{art.title}</h4>
                    <p class="article-excerpt-text">{art.excerpt}</p>
                    <small class="slug-text">/{art.slug}</small>
                  </div>
                  <div class="article-actions">
                    <button type="button" class="btn-action-edit btn-edit-article" data-idx={idx} title="Edit Artikel">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-article" data-idx={idx} title="Hapus Artikel">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Berita -->
          <div class="form-card card" id="modal-article" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-art-title">Tulis / Edit Artikel Berita</h3>
                <p class="card-desc">Lengkapi judul, slug unik, kategori, ringkasan, dan teks isi berita.</p>
              </div>
            </div>
            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-art-title">Judul Berita <span class="req">*</span></label>
                <input type="text" id="input-art-title" placeholder="Contoh: Annual Showcase Day 2026..." class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-art-slug">Slug URL Unik <span class="req">*</span></label>
                <input type="text" id="input-art-slug" placeholder="annual-showcase-day-2026" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-art-cat">Kategori Berita <span class="req">*</span></label>
                <select id="input-art-cat" class="form-control">
                  <option value="Kegiatan">Kegiatan Sekolah</option>
                  <option value="Prestasi">Prestasi & Juara</option>
                  <option value="Akademik">Akademik & Kurikulum</option>
                  <option value="Kesiswaan">Kesiswaan & OSIS</option>
                  <option value="Opini">Opini & Wawasan</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-art-date">Tanggal Rilis <span class="req">*</span></label>
                <input type="date" id="input-art-date" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-art-author">Penulis / Sumber <span class="req">*</span></label>
                <input type="text" id="input-art-author" value="Humas Sekolah Contoh Indonesia" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-art-img">Thumbnail Gambar Berita (WebP) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-art"
                    src="/assets/berita-kegiatan-osis.webp"
                    alt="Pratinjau Berita"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-art-img" value="/assets/berita-kegiatan-osis.webp" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Berita</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-art-img" data-target-preview="img-prev-art" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="form-group col-span-2">
                <label for="input-art-excerpt">Ringkasan Berita (Excerpt 1–2 Kalimat) <span class="req">*</span></label>
                <input type="text" id="input-art-excerpt" placeholder="Ringkasan yang tampil di kartu cuplikan..." class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-art-body">Paragraf Konten Berita <span class="req">*</span></label>
                <textarea id="input-art-body" rows="4" class="form-control" placeholder="Tuliskan isi berita lengkap..."></textarea>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-article" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-article-item" class="btn btn-primary">Publikasikan Berita</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 2: PENGUMUMAN RESMI -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-pengumuman">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="bell" size={20} />
                </div>
                <div>
                  <h3>Papan Pengumuman Resmi Sekolah (CRUD)</h3>
                  <p class="card-desc">Edaran jadwal PTS, libur hari besar, pengambilan seragam, dan jadwal pendaftaran.</p>
                </div>
              </div>
              <button type="button" id="btn-add-announcement" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Buat Pengumuman</span>
              </button>
            </div>

            <div class="announcements-admin-list" id="announcements-list-container">
              {announcements.map((ann, idx) => (
                <div class="announcement-admin-card" data-idx={idx}>
                  <div class="ann-date-badge">
                    <span class="ann-d">{ann.day}</span>
                    <span class="ann-m">{ann.month}</span>
                  </div>
                  <div class="ann-info-col">
                    <div class="ann-badges-row">
                      {ann.important && <span class="important-pill">PENTING</span>}
                      <span class="ann-full-date">{ann.date}</span>
                    </div>
                    <h4>{ann.title}</h4>
                    <p class="ann-summary-text">{ann.summary}</p>
                    {ann.attachment && (
                      <span class="ann-file-tag">
                        <Icon name="file-text" size={13} />
                        <span>{ann.attachment.name} ({ann.attachment.size})</span>
                      </span>
                    )}
                  </div>
                  <div class="ann-actions">
                    <button type="button" class="btn-action-edit btn-edit-ann" data-idx={idx} title="Edit Pengumuman">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-ann" data-idx={idx} title="Hapus Pengumuman">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Pengumuman -->
          <div class="form-card card" id="modal-announcement" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-ann-title">Buat / Edit Pengumuman Resmi</h3>
                <p class="card-desc">Tentukan judul maklumat, tingkat urgensi (Penting), dan berkas lampiran.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-ann-id" value="" />
              <div class="form-group col-span-2">
                <label for="input-ann-title-val">Judul Pengumuman <span class="req">*</span></label>
                <input type="text" id="input-ann-title-val" placeholder="Contoh: Jadwal Penilaian Akhir Semester (PAS)..." class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ann-date">Tanggal Terbit <span class="req">*</span></label>
                <input type="date" id="input-ann-date" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ann-important">Tingkat Urgensi</label>
                <select id="input-ann-important" class="form-control">
                  <option value="false">Normal</option>
                  <option value="true">Penting (Badge Merah)</option>
                </select>
              </div>
              <div class="form-group col-span-2">
                <label for="input-ann-summary">Ringkasan Isi Pengumuman <span class="req">*</span></label>
                <textarea id="input-ann-summary" rows="3" class="form-control" placeholder="Diberitahukan kepada seluruh siswa dan wali murid..."></textarea>
              </div>
              <div class="form-group">
                <label for="input-ann-file-name">Nama File Lampiran (Opsional)</label>
                <input type="text" id="input-ann-file-name" placeholder="Contoh: Jadwal_PAS_Ganjil.pdf" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ann-file-size">Ukuran File</label>
                <input type="text" id="input-ann-file-size" placeholder="Contoh: 150 KB" class="form-control" />
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-ann" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-ann-item" class="btn btn-primary">Simpan Pengumuman</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 3: GALERI FOTO ALBUM -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-galeri">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="image" size={20} />
                </div>
                <div>
                  <h3>Album Dokumentasi Kegiatan (CRUD)</h3>
                  <p class="card-desc">Koleksi dokumentasi visual acara showcase karya, riset robotika, dan aktivitas teknologi sekolah.</p>
                </div>
              </div>
              <button type="button" id="btn-add-album" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Buat Album Baru</span>
              </button>
            </div>

            <div class="albums-admin-grid" id="albums-list-container">
              {albums.map((alb, idx) => (
                <div class="album-admin-card" data-idx={idx}>
                  <div class="album-thumb-wrap">
                    <img src={alb.cover.src} alt={alb.title} class="album-thumb" onerror="this.src='/assets/kegiatan-sekolah-1.webp'" />
                  </div>
                  <div class="album-body">
                    <span class="photo-count-pill">{alb.photoCount} Foto</span>
                    <h4>{alb.title}</h4>
                    <p class="album-date-text">{alb.date}</p>
                    <div class="album-card-actions">
                      <button type="button" class="btn-action-edit btn-edit-album" data-idx={idx} title="Edit Album">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-album" data-idx={idx} title="Hapus Album">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Album -->
          <div class="form-card card" id="modal-album" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-alb-title">Buat / Edit Album Galeri</h3>
                <p class="card-desc">Lengkapi nama album, tanggal kegiatan, jumlah foto, dan cover utama.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-alb-id" value="" />
              <div class="form-group col-span-2">
                <label for="input-alb-title-val">Nama Album Kegiatan <span class="req">*</span></label>
                <input type="text" id="input-alb-title-val" placeholder="Contoh: Showcase Day & Tech Expo 2026" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-alb-date">Tanggal Dokumentasi <span class="req">*</span></label>
                <input type="date" id="input-alb-date" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-alb-count">Jumlah Foto Terkumpul</label>
                <input type="number" id="input-alb-count" value="12" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-alb-cover">Cover Foto Utama Album (WebP) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-alb"
                    src="/assets/kegiatan-sekolah-1.webp"
                    alt="Pratinjau Album"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-alb-cover" value="/assets/kegiatan-sekolah-1.webp" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Cover</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-alb-cover" data-target-preview="img-prev-alb" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-album" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-album-item" class="btn btn-primary">Simpan Album</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 4: PUSAT UNDUHAN BERKAS -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-unduhan">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="download" size={20} />
                </div>
                <div>
                  <h3>Pusat Berkas & Dokumen Publik (CRUD)</h3>
                  <p class="card-desc">Formulir admission, prospektus resmi, kalender akademik, dan buku panduan kode etik siswa.</p>
                </div>
              </div>
              <button type="button" id="btn-add-download" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Unggah Berkas Baru</span>
              </button>
            </div>

            <div class="downloads-admin-list" id="downloads-list-container">
              {downloads.map((dl, idx) => (
                <div class="download-admin-item" data-idx={idx}>
                  <div class="dl-format-tag">{dl.format}</div>
                  <div class="dl-info-col">
                    <div class="dl-meta-row">
                      <span class="cat-pill">{dl.category}</span>
                      <span class="dl-size-tag">{dl.size}</span>
                      <span class="dl-date">{dl.date}</span>
                    </div>
                    <h4>{dl.title}</h4>
                    <p class="dl-desc-text">{dl.description}</p>
                  </div>
                  <div class="dl-actions">
                    <button type="button" class="btn-action-edit btn-edit-dl" data-idx={idx} title="Edit Berkas">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-dl" data-idx={idx} title="Hapus Berkas">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Unduhan -->
          <div class="form-card card" id="modal-download" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-dl-title">Tambah / Edit Berkas Unduhan</h3>
                <p class="card-desc">Lengkapi nama berkas, kategori, format ekstensi, dan ukuran file.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-dl-id" value="" />
              <div class="form-group col-span-2">
                <label for="input-dl-title-val">Judul Dokumen Publik <span class="req">*</span></label>
                <input type="text" id="input-dl-title-val" placeholder="Contoh: Formulir Pendaftaran PPDB 2027/2028" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-dl-cat">Kategori Berkas <span class="req">*</span></label>
                <select id="input-dl-cat" class="form-control">
                  <option value="PPDB">PPDB & Pendaftaran</option>
                  <option value="Akademik">Akademik & Kalender</option>
                  <option value="Kesiswaan">Kesiswaan & Tata Tertib</option>
                  <option value="Umum">Umum & Surat Resmi</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-dl-format">Format Berkas <span class="req">*</span></label>
                <select id="input-dl-format" class="form-control">
                  <option value="PDF">PDF</option>
                  <option value="DOCX">DOCX</option>
                  <option value="XLSX">XLSX</option>
                  <option value="ZIP">ZIP</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-dl-size">Ukuran Berkas <span class="req">*</span></label>
                <input type="text" id="input-dl-size" placeholder="Contoh: 240 KB / 1,4 MB" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-dl-date">Tanggal Rilis <span class="req">*</span></label>
                <input type="date" id="input-dl-date" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-dl-url">Tautan / Link Berkas</label>
                <input type="text" id="input-dl-url" value="#download-file" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-dl-desc">Keterangan Dokumen <span class="req">*</span></label>
                <textarea id="input-dl-desc" rows="2" class="form-control" placeholder="Petunjuk pengisian atau isi dokumen singkat..."></textarea>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-dl" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-dl-item" class="btn btn-primary">Simpan Berkas</button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Interactive Live Preview -->
    <aside class="preview-container">
      <div class="preview-sticky-wrap">
        <div class="card preview-card">
          <div class="card-header-sm">
            <div class="flex-align-center gap-2">
