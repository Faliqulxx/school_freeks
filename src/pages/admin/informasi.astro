    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sim-dl-content h4 {
    font-size: 0.875rem;
    margin-bottom: 2px;
  }

  .sim-dl-desc {
    font-size: 0.72rem;
    color: var(--admin-ink-700);
    margin-bottom: 2px;
  }

  .preview-footer-action {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--admin-ink-100);
  }

  /* Toast Notification */
  .toast-notification {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-left: 4px solid #10B981;
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 20px;
  }

  .toast-icon {
    color: #059669;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .toast-body {
    flex: 1;
    font-size: 0.875rem;
    color: #065F46;
  }

  .toast-body strong {
    display: block;
    margin-bottom: 2px;
  }

  .toast-body p {
    font-size: 0.825rem;
    color: #047857;
  }

  .toast-close-btn {
    background: transparent;
    border: none;
    color: #059669;
    cursor: pointer;
    padding: 4px;
    display: flex;
  }

  .flex-align-center {
    display: flex;
    align-items: center;
  }

  .gap-2 {
    gap: 8px;
  }
</style>

<script is:inline>
  function initInformasi() {
    // Initial states for Sekolah Contoh Indonesia
    let articlesState = [
      {
        slug: "showcase-day-karya-teknologi-2026",
        date: "2026-10-22",
        category: "Kegiatan",
        title: "Annual Showcase Day 2026: Siswa Sekolah Contoh Pamerkan 24 Prototipe IoT & Game Edukasi",
        excerpt: "Seluruh siswa menampilkan karya capstone inovatif di hadapan mentor industri dan para wali murid.",
        author: "Tim Media Sekolah Contoh",
        image: { src: "/assets/kegiatan-sekolah-1.webp", alt: "Showcase Day Sekolah Contoh Indonesia", width: 1200, height: 800 }
      },
      {
        slug: "tim-robotika-freeks-juara-1-nasional",
        date: "2026-10-15",
        category: "Prestasi",
        title: "Tim Robotika FREEKS Raih Medali Emas National Youth Robotics Summit",
        excerpt: "Prototipe robot penyelamat otonom karya tim siswa berhasil unggul di antara 80 tim dari seluruh Indonesia.",
        author: "Pembina Robotika",
        image: { src: "/assets/berita-prestasi-sains.webp", alt: "Prestasi Robotika Siswa FREEKS", width: 1200, height: 800 }
      },
      {
        slug: "mid-term-project-sprint-dimulai",
        date: "2026-10-08",
        category: "Akademik",
        title: "Mid-Term Project Sprint 2026 Dimulai: Kolaborasi Riset Terintegrasi Siswa",
        excerpt: "Siswa memulai sprint riset terintegrasi selama dua pekan untuk memecahkan tantangan lingkungan sekolah.",
        author: "Academic Lead",
        image: { src: "/assets/kegiatan-sekolah-2.webp", alt: "Project Sprint Akademik", width: 1200, height: 800 }
      }
    ];

    let announcementsState = [
      {
        id: "pts-ganjil-2026",
        date: "2026-10-24",
        day: "24",
        month: "Okt",
        year: "2026",
        title: "Jadwal Mid-Term Project Sprint & Asesmen Terpadu Semester Ganjil",
        important: true,
        summary: "Diberitahukan kepada seluruh siswa dan orang tua bahwa pelaksanaan Project Sprint dan Asesmen Ganjil dimulai 26 Oktober 2026. Jadwal mentorship lab dan demo project dapat diunduh pada lampiran.",
        attachment: { name: "Jadwal_Project_Sprint_2026.pdf", size: "180 KB" }
      },
      {
        id: "workshop-ai-2026",
        date: "2026-10-20",
        day: "20",
        month: "Okt",
        year: "2026",
        title: "FREEKS Tech Talk: Menjelajahi Kecerdasan Buatan dan Etika Digital",
        important: false,
        summary: "Sesi seminar interaktif bersama pembicara tamu praktisi industri teknologi untuk seluruh siswa dan terbuka bagi orang tua.",
        attachment: null
      },
      {
        id: "apparel-gel-2",
        date: "2026-10-12",
        day: "12",
        month: "Okt",
        year: "2026",
        title: "Distribusi Starter Pack & Apparel Resmi FREEKS Gelombang 2",
        important: false,
        summary: "Pengambilan hoodie identitas dan polo shirt resmi FREEKS dapat dilakukan di Campus Registry Office pada jam layanan operasional.",
        attachment: { name: "Daftar_Apparel_Batch2.pdf", size: "95 KB" }
      }
    ];

    let albumsState = [
      {
        id: "showcase-day-2026",
        title: "Annual Showcase Day & Tech Expo 2026",
        date: "2026-10-22",
        photoCount: 24,
        cover: { src: "/assets/kegiatan-sekolah-1.webp", alt: "Showcase Day Expo", width: 1200, height: 800 }
      },
      {
        id: "olimpiade-sains-2026",
        title: "Kompetisi Robotika & Sains Nasional",
        date: "2026-10-15",
        photoCount: 12,
        cover: { src: "/assets/kegiatan-sekolah-2.webp", alt: "Kompetisi Sains", width: 1200, height: 800 }
      }
    ];

    let downloadsState = [
      {
        id: "unduh-form-ppdb",
        title: "Formulir Pendaftaran Admission (Format Cetak)",
        category: "Admission",
        format: "PDF",
        size: "210 KB",
        date: "2026-10-10",
        description: "Formulir pendaftaran fisik bagi calon siswa atau orang tua yang ingin mengisi secara manual sebelum diserahkan ke tim admission."
      },
      {
        id: "unduh-brosur-ppdb",
        title: "Buku Prospektus & Brosur Resmi Sekolah Contoh Indonesia",
        category: "Admission",
        format: "PDF",
        size: "1,8 MB",
        date: "2026-10-15",
        description: "Memuat informasi program inovasi, kurikulum computational, profil sekolah, dan rincian biaya penerimaan."
      },
      {
        id: "unduh-kalender-akademik",
        title: "Kalender Akademik & Project Milestones 2026/2027",
        category: "Akademik",
        format: "PDF",
        size: "320 KB",
        date: "2026-07-15",
        description: "Agenda pembelajaran terpadu, jadwal sprint proyek, demo day, dan hari libur resmi."
      },
      {
        id: "unduh-tata-tertib",
        title: "Buku Panduan & Kode Etik Siswa FREEKS (Student Handbook)",
        category: "Kesiswaan",
        format: "PDF",
        size: "540 KB",
        date: "2026-07-20",
        description: "Pedoman hak, kewajiban, etika digital, pemanfaatan laboratorium, dan nilai integritas siswa."
      }
    ];

    // Load from localStorage with migration
    const savedInf = localStorage.getItem('mts_cms_informasi_data');
    if (savedInf) {
      try {
        const parsed = JSON.parse(savedInf);
        const hasLegacy = parsed.articles && parsed.articles.some(a => (a.slug && a.slug.includes('hari-siswa')) || (a.image?.src && a.image.src.includes('Sekolah-')));
        if (hasLegacy) {
          localStorage.removeItem('mts_cms_informasi_data');
        } else {
          if (parsed.articles && parsed.articles.length) articlesState = parsed.articles;
          if (parsed.announcements && parsed.announcements.length) announcementsState = parsed.announcements;
          if (parsed.albums && parsed.albums.length) albumsState = parsed.albums;
          if (parsed.downloads && parsed.downloads.length) downloadsState = parsed.downloads;
        }
      } catch (e) {
        console.error('Failed to parse saved informasi:', e);
      }
    }

    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab');
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Preview switcher
    const previewPills = document.querySelectorAll('#informasi-preview-pills .pill-btn');
    const simViews = {
      berita: document.getElementById('sim-inf-berita'),
      pengumuman: document.getElementById('sim-inf-pengumuman'),
      galeri: document.getElementById('sim-inf-galeri'),
      unduhan: document.getElementById('sim-inf-unduhan')
    };

    previewPills.forEach(pill => {
      pill.addEventListener('click', () => {
        previewPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const mode = pill.getAttribute('data-mode');
        Object.keys(simViews).forEach(k => {
          if (simViews[k]) simViews[k].style.display = (k === mode) ? 'block' : 'none';
        });
      });
    });

    // CRUD Berita
    const artContainer = document.getElementById('articles-list-container');
    const modalArt = document.getElementById('modal-article');
    let editingArtIdx = -1;

    function renderArticlesList() {
      if (!artContainer) return;
      artContainer.innerHTML = '';
      articlesState.forEach((art, idx) => {
        const card = document.createElement('div');
        card.className = 'article-admin-card';
        card.innerHTML = `
          <div class="article-thumb-wrap">
            <img src="${art.image?.src || '/assets/berita-kegiatan-osis.webp'}" alt="${art.title}" class="article-thumb" onerror="this.src='/assets/berita-kegiatan-osis.webp'" />
          </div>
          <div class="article-content-col">
            <div class="article-badges-row">
              <span class="cat-pill">${art.category}</span>
              <span class="date-text">${art.date}</span>
              <span class="author-text">Oleh: ${art.author}</span>
            </div>
            <h4>${art.title}</h4>
            <p class="article-excerpt-text">${art.excerpt}</p>
            <small class="slug-text">/${art.slug}</small>
          </div>
          <div class="article-actions">
            <button type="button" class="btn-action-edit btn-edit-art-item" data-idx="${idx}" title="Edit Artikel">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
              <span>Edit</span>
            </button>
            <button type="button" class="btn-action-delete btn-delete-art-item" data-idx="${idx}" title="Hapus Artikel">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;
        artContainer.appendChild(card);
      });

      document.querySelectorAll('.btn-edit-art-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingArtIdx = idx;
          const a = articlesState[idx];
          document.getElementById('modal-art-title').textContent = 'Edit Artikel Berita';
          document.getElementById('input-art-title').value = a.title;
          document.getElementById('input-art-slug').value = a.slug;
          document.getElementById('input-art-cat').value = a.category;
          document.getElementById('input-art-date').value = a.date;
          document.getElementById('input-art-author').value = a.author;
          document.getElementById('input-art-img').value = a.image?.src || '/assets/berita-kegiatan-osis.webp';
          const prevArtImg = document.getElementById('img-prev-art');
          if (prevArtImg) prevArtImg.src = a.image?.src || '/assets/berita-kegiatan-osis.webp';
          document.getElementById('input-art-excerpt').value = a.excerpt;
          document.getElementById('input-art-body').value = a.excerpt;
          modalArt.style.display = 'block';
          modalArt.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-art-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = articlesState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus artikel "${item.title}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              articlesState.splice(idx, 1);
              renderArticlesList();
            });
          } else if (confirm(msg)) {
            articlesState.splice(idx, 1);
            renderArticlesList();
          }
        });
      });

      if (articlesState.length > 0) {
        if (document.getElementById('sim-art-cat')) document.getElementById('sim-art-cat').textContent = articlesState[0].category;
        if (document.getElementById('sim-art-title')) document.getElementById('sim-art-title').textContent = articlesState[0].title;
        if (document.getElementById('sim-art-excerpt')) document.getElementById('sim-art-excerpt').textContent = articlesState[0].excerpt;
        if (document.getElementById('sim-art-meta')) document.getElementById('sim-art-meta').textContent = `Oleh: ${articlesState[0].author} (${articlesState[0].date})`;
      }
    }

    const btnAddArt = document.getElementById('btn-add-article');
    if (btnAddArt) {
      btnAddArt.addEventListener('click', () => {
        editingArtIdx = -1;
        document.getElementById('modal-art-title').textContent = 'Tulis Artikel Berita Baru';
        document.getElementById('input-art-title').value = '';
        document.getElementById('input-art-slug').value = 'berita-' + Date.now();
        document.getElementById('input-art-cat').value = 'Kegiatan';
        document.getElementById('input-art-date').value = new Date().toISOString().split('T')[0];
        document.getElementById('input-art-author').value = 'Humas Sekolah Contoh Indonesia';
        document.getElementById('input-art-img').value = '/assets/berita-kegiatan-osis.webp';
        const prevArtImg = document.getElementById('img-prev-art');
        if (prevArtImg) prevArtImg.src = '/assets/berita-kegiatan-osis.webp';
        document.getElementById('input-art-excerpt').value = '';
        document.getElementById('input-art-body').value = '';
        modalArt.style.display = 'block';
        modalArt.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelArt = document.getElementById('btn-cancel-article');
    if (btnCancelArt) btnCancelArt.addEventListener('click', () => { modalArt.style.display = 'none'; });

    const btnSaveArtItem = document.getElementById('btn-save-article-item');
    if (btnSaveArtItem) {
      btnSaveArtItem.addEventListener('click', () => {
        const title = document.getElementById('input-art-title').value.trim();
        const slug = document.getElementById('input-art-slug').value.trim();
        const category = document.getElementById('input-art-cat').value;
        const date = document.getElementById('input-art-date').value;
        const author = document.getElementById('input-art-author').value.trim();
        const src = document.getElementById('input-art-img').value.trim();
        const excerpt = document.getElementById('input-art-excerpt').value.trim();
        if (!title || !slug || !excerpt) {
          alert('Mohon lengkapi judul, slug unik, dan ringkasan berita!');
          return;
        }
        const obj = { slug, date, category, title, excerpt, author, image: { src, alt: title, width: 1200, height: 800 } };
        if (editingArtIdx >= 0) {
          articlesState[editingArtIdx] = obj;
        } else {
          articlesState.push(obj);
        }
        modalArt.style.display = 'none';
        renderArticlesList();
      });
    }

    // Auto slug on typing article title
    const inputArtTitle = document.getElementById('input-art-title');
    if (inputArtTitle) {
      inputArtTitle.addEventListener('blur', () => {
        const slugInput = document.getElementById('input-art-slug');
        if (slugInput && !slugInput.value.trim() || slugInput.value.startsWith('berita-')) {
          slugInput.value = inputArtTitle.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
        }
      });
    }

    // CRUD Pengumuman
    const annContainer = document.getElementById('announcements-list-container');
    const modalAnn = document.getElementById('modal-announcement');
    let editingAnnIdx = -1;

    function renderAnnouncementsList() {
      if (!annContainer) return;
      annContainer.innerHTML = '';
      announcementsState.forEach((ann, idx) => {
        const card = document.createElement('div');
        card.className = 'announcement-admin-card';
        card.innerHTML = `
          <div class="ann-date-badge">
            <span class="ann-d">${ann.day}</span>
            <span class="ann-m">${ann.month}</span>
          </div>
          <div class="ann-info-col">
            <div class="ann-badges-row">
              ${ann.important ? '<span class="important-pill">PENTING</span>' : ''}
              <span class="ann-full-date">${ann.date}</span>
            </div>
            <h4>${ann.title}</h4>
            <p class="ann-summary-text">${ann.summary}</p>
            ${ann.attachment ? `<span class="ann-file-tag">${ann.attachment.name} (${ann.attachment.size})</span>` : ''}
          </div>
          <div class="ann-actions">
            <button type="button" class="btn-action-edit btn-edit-ann-item" data-idx="${idx}" title="Edit Pengumuman">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
              <span>Edit</span>
            </button>
            <button type="button" class="btn-action-delete btn-delete-ann-item" data-idx="${idx}" title="Hapus Pengumuman">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;
        annContainer.appendChild(card);
      });

      document.querySelectorAll('.btn-edit-ann-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingAnnIdx = idx;
          const a = announcementsState[idx];
          document.getElementById('modal-ann-title').textContent = 'Edit Pengumuman';
          document.getElementById('input-ann-id').value = a.id;
          document.getElementById('input-ann-title-val').value = a.title;
          document.getElementById('input-ann-date').value = a.date;
          document.getElementById('input-ann-important').value = a.important ? 'true' : 'false';
          document.getElementById('input-ann-summary').value = a.summary;
          document.getElementById('input-ann-file-name').value = a.attachment?.name || '';
          document.getElementById('input-ann-file-size').value = a.attachment?.size || '';
          modalAnn.style.display = 'block';
          modalAnn.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-ann-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = announcementsState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus pengumuman "${item.title}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              announcementsState.splice(idx, 1);
              renderAnnouncementsList();
            });
          } else if (confirm(msg)) {
            announcementsState.splice(idx, 1);
            renderAnnouncementsList();
          }
        });
      });

      if (announcementsState.length > 0) {
        if (document.getElementById('sim-ann-date')) document.getElementById('sim-ann-date').textContent = announcementsState[0].date;
        if (document.getElementById('sim-ann-title')) document.getElementById('sim-ann-title').textContent = announcementsState[0].title;
        if (document.getElementById('sim-ann-summary')) document.getElementById('sim-ann-summary').textContent = announcementsState[0].summary;
      }
    }

    const btnAddAnn = document.getElementById('btn-add-announcement');
    if (btnAddAnn) {
      btnAddAnn.addEventListener('click', () => {
        editingAnnIdx = -1;
        document.getElementById('modal-ann-title').textContent = 'Buat Pengumuman Baru';
        document.getElementById('input-ann-id').value = 'ann-' + Date.now();
        document.getElementById('input-ann-title-val').value = '';
        document.getElementById('input-ann-date').value = new Date().toISOString().split('T')[0];
        document.getElementById('input-ann-important').value = 'false';
        document.getElementById('input-ann-summary').value = '';
        document.getElementById('input-ann-file-name').value = '';
        document.getElementById('input-ann-file-size').value = '';
        modalAnn.style.display = 'block';
        modalAnn.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelAnn = document.getElementById('btn-cancel-ann');
    if (btnCancelAnn) btnCancelAnn.addEventListener('click', () => { modalAnn.style.display = 'none'; });

    const btnSaveAnnItem = document.getElementById('btn-save-ann-item');
    if (btnSaveAnnItem) {
      btnSaveAnnItem.addEventListener('click', () => {
        const id = document.getElementById('input-ann-id').value || ('ann-' + Date.now());
        const title = document.getElementById('input-ann-title-val').value.trim();
        const date = document.getElementById('input-ann-date').value;
        const important = document.getElementById('input-ann-important').value === 'true';
        const summary = document.getElementById('input-ann-summary').value.trim();
        const fileName = document.getElementById('input-ann-file-name').value.trim();
        const fileSize = document.getElementById('input-ann-file-size').value.trim();

        if (!title || !date || !summary) {
          alert('Mohon lengkapi judul, tanggal, dan ringkasan pengumuman!');
          return;
        }

        const dateParts = date.split('-');
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
        const day = dateParts[2];
        const month = months[parseInt(dateParts[1], 10) - 1];
        const year = dateParts[0];

        const attachment = fileName ? { name: fileName, size: fileSize || '100 KB', url: '#' } : null;
        const obj = { id, date, day, month, year, title, important, summary, attachment };

        if (editingAnnIdx >= 0) {
          announcementsState[editingAnnIdx] = obj;
        } else {
          announcementsState.push(obj);
        }
        modalAnn.style.display = 'none';
        renderAnnouncementsList();
      });
    }

    // CRUD Galeri Album
    const albContainer = document.getElementById('albums-list-container');
    const modalAlb = document.getElementById('modal-album');
    let editingAlbIdx = -1;

    function renderAlbumsList() {
      if (!albContainer) return;
      albContainer.innerHTML = '';
      albumsState.forEach((alb, idx) => {
        const card = document.createElement('div');
        card.className = 'album-admin-card';
        card.innerHTML = `
          <div class="album-thumb-wrap">
            <img src="${alb.cover?.src || '/assets/kegiatan-sekolah-1.webp'}" alt="${alb.title}" class="album-thumb" onerror="this.src='/assets/kegiatan-sekolah-1.webp'" />
          </div>
          <div class="album-body">
            <span class="photo-count-pill">${alb.photoCount} Foto</span>
            <h4>${alb.title}</h4>
            <p class="album-date-text">${alb.date}</p>
            <div class="album-card-actions">
              <button type="button" class="btn-action-edit btn-edit-alb-item" data-idx="${idx}" title="Edit Album">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                <span>Edit</span>
              </button>
              <button type="button" class="btn-action-delete btn-delete-alb-item" data-idx="${idx}" title="Hapus Album">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Hapus</span>
              </button>
            </div>
          </div>
        `;
        albContainer.appendChild(card);
      });

      document.querySelectorAll('.btn-edit-alb-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingAlbIdx = idx;
          const a = albumsState[idx];
          document.getElementById('modal-alb-title').textContent = 'Edit Album Galeri';
          document.getElementById('input-alb-id').value = a.id;
          document.getElementById('input-alb-title-val').value = a.title;
          document.getElementById('input-alb-date').value = a.date;
          document.getElementById('input-alb-count').value = a.photoCount;
          document.getElementById('input-alb-cover').value = a.cover?.src || '/assets/kegiatan-sekolah-1.webp';
          const prevAlbImg = document.getElementById('img-prev-alb');
          if (prevAlbImg) prevAlbImg.src = a.cover?.src || '/assets/kegiatan-sekolah-1.webp';
          modalAlb.style.display = 'block';
          modalAlb.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-alb-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = albumsState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus album "${item.title}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              albumsState.splice(idx, 1);
              renderAlbumsList();
            });
          } else if (confirm(msg)) {
            albumsState.splice(idx, 1);
            renderAlbumsList();
          }
        });
      });
    }

    const btnAddAlb = document.getElementById('btn-add-album');
    if (btnAddAlb) {
      btnAddAlb.addEventListener('click', () => {
        editingAlbIdx = -1;
        document.getElementById('modal-alb-title').textContent = 'Buat Album Galeri Baru';
        document.getElementById('input-alb-id').value = 'album-' + Date.now();
        document.getElementById('input-alb-title-val').value = '';
        document.getElementById('input-alb-date').value = new Date().toISOString().split('T')[0];
        document.getElementById('input-alb-count').value = '8';
        document.getElementById('input-alb-cover').value = '/assets/kegiatan-sekolah-1.webp';
        const prevAlbImg = document.getElementById('img-prev-alb');
        if (prevAlbImg) prevAlbImg.src = '/assets/kegiatan-sekolah-1.webp';
        modalAlb.style.display = 'block';
        modalAlb.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelAlb = document.getElementById('btn-cancel-album');
    if (btnCancelAlb) btnCancelAlb.addEventListener('click', () => { modalAlb.style.display = 'none'; });

    const btnSaveAlbItem = document.getElementById('btn-save-album-item');
    if (btnSaveAlbItem) {
      btnSaveAlbItem.addEventListener('click', () => {
        const id = document.getElementById('input-alb-id').value || ('album-' + Date.now());
        const title = document.getElementById('input-alb-title-val').value.trim();
        const date = document.getElementById('input-alb-date').value;
        const photoCount = parseInt(document.getElementById('input-alb-count').value, 10) || 10;
        const src = document.getElementById('input-alb-cover').value.trim();
        if (!title || !date) {
          alert('Mohon lengkapi judul album dan tanggal acara!');
          return;
        }
        const obj = { id, title, date, photoCount, cover: { src, alt: title, width: 1200, height: 800 } };
        if (editingAlbIdx >= 0) {
          albumsState[editingAlbIdx] = obj;
        } else {
          albumsState.push(obj);
        }
        modalAlb.style.display = 'none';
        renderAlbumsList();
      });
    }

    // CRUD Unduhan
    const dlContainer = document.getElementById('downloads-list-container');
    const modalDl = document.getElementById('modal-download');
    let editingDlIdx = -1;

    function renderDownloadsList() {
      if (!dlContainer) return;
      dlContainer.innerHTML = '';
      downloadsState.forEach((dl, idx) => {
        const item = document.createElement('div');
        item.className = 'download-admin-item';
        item.innerHTML = `
          <div class="dl-format-tag">${dl.format}</div>
          <div class="dl-info-col">
            <div class="dl-meta-row">
              <span class="cat-pill">${dl.category}</span>
              <span class="dl-size-tag">${dl.size}</span>
              <span class="dl-date">${dl.date}</span>
            </div>
            <h4>${dl.title}</h4>
            <p class="dl-desc-text">${dl.description}</p>
          </div>
          <div class="dl-actions">
            <button type="button" class="btn-action-edit btn-edit-dl-item" data-idx="${idx}" title="Edit Berkas">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
              <span>Edit</span>
            </button>
            <button type="button" class="btn-action-delete btn-delete-dl-item" data-idx="${idx}" title="Hapus Berkas">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;
        dlContainer.appendChild(item);
      });

      document.querySelectorAll('.btn-edit-dl-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingDlIdx = idx;
          const d = downloadsState[idx];
          document.getElementById('modal-dl-title').textContent = 'Edit Berkas Unduhan';
          document.getElementById('input-dl-id').value = d.id;
          document.getElementById('input-dl-title-val').value = d.title;
          document.getElementById('input-dl-cat').value = d.category;
          document.getElementById('input-dl-format').value = d.format;
          document.getElementById('input-dl-size').value = d.size;
          document.getElementById('input-dl-date').value = d.date;
          document.getElementById('input-dl-desc').value = d.description;
          modalDl.style.display = 'block';
          modalDl.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-dl-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = downloadsState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus berkas unduhan "${item.title}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              downloadsState.splice(idx, 1);
              renderDownloadsList();
            });
          } else if (confirm(msg)) {
            downloadsState.splice(idx, 1);
            renderDownloadsList();
          }
        });
      });

      if (downloadsState.length > 0) {
        if (document.getElementById('sim-dl-fmt')) document.getElementById('sim-dl-fmt').textContent = downloadsState[0].format;
        if (document.getElementById('sim-dl-title')) document.getElementById('sim-dl-title').textContent = downloadsState[0].title;
        if (document.getElementById('sim-dl-desc')) document.getElementById('sim-dl-desc').textContent = downloadsState[0].description;
        if (document.getElementById('sim-dl-size')) document.getElementById('sim-dl-size').textContent = `${downloadsState[0].size} • ${downloadsState[0].category}`;
      }
    }

    const btnAddDl = document.getElementById('btn-add-download');
    if (btnAddDl) {
      btnAddDl.addEventListener('click', () => {
        editingDlIdx = -1;
        document.getElementById('modal-dl-title').textContent = 'Unggah Berkas Baru';
        document.getElementById('input-dl-id').value = 'unduh-' + Date.now();
        document.getElementById('input-dl-title-val').value = '';
        document.getElementById('input-dl-cat').value = 'Admission';
        document.getElementById('input-dl-format').value = 'PDF';
        document.getElementById('input-dl-size').value = '250 KB';
        document.getElementById('input-dl-date').value = new Date().toISOString().split('T')[0];
        document.getElementById('input-dl-desc').value = '';
        modalDl.style.display = 'block';
        modalDl.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelDl = document.getElementById('btn-cancel-dl');
    if (btnCancelDl) btnCancelDl.addEventListener('click', () => { modalDl.style.display = 'none'; });

    const btnSaveDlItem = document.getElementById('btn-save-dl-item');
    if (btnSaveDlItem) {
      btnSaveDlItem.addEventListener('click', () => {
        const id = document.getElementById('input-dl-id').value || ('unduh-' + Date.now());
        const title = document.getElementById('input-dl-title-val').value.trim();
        const category = document.getElementById('input-dl-cat').value;
        const format = document.getElementById('input-dl-format').value;
        const size = document.getElementById('input-dl-size').value.trim();
        const date = document.getElementById('input-dl-date').value;
        const description = document.getElementById('input-dl-desc').value.trim();
        if (!title || !size) {
          alert('Mohon lengkapi judul dokumen dan ukuran file!');
          return;
        }
        const obj = { id, title, category, format, size, date, description, url: '#' };
        if (editingDlIdx >= 0) {
          downloadsState[editingDlIdx] = obj;
        } else {
          downloadsState.push(obj);
        }
        modalDl.style.display = 'none';
        renderDownloadsList();
      });
    }

    // Save All Informasi
    function handleSaveInformasi() {
      const payload = {
        updatedAt: new Date().toISOString(),
        articles: articlesState,
        announcements: announcementsState,
        albums: albumsState,
        downloads: downloadsState
      };

      localStorage.setItem('mts_cms_informasi_data', JSON.stringify(payload));

      const toast = document.getElementById('save-toast');
      if (toast) {
        toast.hidden = false;
        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    const btnSave1 = document.getElementById('btn-save-informasi');
    const btnSave2 = document.getElementById('btn-save-informasi-side');
    if (btnSave1) btnSave1.addEventListener('click', handleSaveInformasi);
    if (btnSave2) btnSave2.addEventListener('click', handleSaveInformasi);

    const toastClose = document.getElementById('toast-close');
    if (toastClose) toastClose.addEventListener('click', () => { document.getElementById('save-toast').hidden = true; });

    // Export JSON
    const btnExport = document.getElementById('btn-export-informasi-json');
    if (btnExport) {
      btnExport.addEventListener('click', () => {
        const saved = localStorage.getItem('mts_cms_informasi_data');
        const dataObj = saved ? JSON.parse(saved) : { articles: articlesState, announcements: announcementsState, albums: albumsState, downloads: downloadsState };
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(dataObj, null, 2));
        const a = document.createElement('a');
        a.setAttribute('href', dataStr);
        a.setAttribute('download', `informasi-cms-${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Initial render
    renderArticlesList();
    renderAnnouncementsList();
    renderAlbumsList();
    renderDownloadsList();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInformasi);
  } else {
    initInformasi();
  }
</script>
