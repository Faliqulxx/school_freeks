              <img id="sim-art-thumb" src={articles[0].image.src} alt="Thumbnail" class="sim-art-img" />
              <div class="sim-art-body">
                <span class="sim-cat-tag" id="sim-art-cat">{articles[0].category}</span>
                <h4 id="sim-art-title">{articles[0].title}</h4>
                <p id="sim-art-excerpt" class="sim-excerpt">{articles[0].excerpt}</p>
                <small id="sim-art-meta">Oleh: {articles[0].author} ({articles[0].date})</small>
              </div>
            </div>
          </div>

          <!-- Preview 2: Pengumuman -->
          <div id="sim-inf-pengumuman" class="sim-inf-view" style="display: none;">
            <div class="sim-ann-box">
              <div class="sim-ann-head">
                <span class="sim-important-pill" id="sim-ann-pill">PENTING</span>
                <span id="sim-ann-date">{announcements[0].date}</span>
              </div>
              <h4 id="sim-ann-title">{announcements[0].title}</h4>
              <p id="sim-ann-summary">{announcements[0].summary}</p>
            </div>
          </div>

          <!-- Preview 3: Galeri -->
          <div id="sim-inf-galeri" class="sim-inf-view" style="display: none;">
            <div class="sim-gal-card">
              <img id="sim-gal-thumb" src={albums[0].cover.src} alt="Cover" class="sim-gal-img" />
              <div class="sim-gal-body">
                <span class="sim-photo-pill" id="sim-gal-count">{albums[0].photoCount} Foto</span>
                <h4 id="sim-gal-title">{albums[0].title}</h4>
                <small id="sim-gal-date">{albums[0].date}</small>
              </div>
            </div>
          </div>

          <!-- Preview 4: Unduhan -->
          <div id="sim-inf-unduhan" class="sim-inf-view" style="display: none;">
            <div class="sim-dl-box">
              <div class="sim-dl-fmt" id="sim-dl-fmt">{downloads[0].format}</div>
              <div class="sim-dl-content">
                <h4 id="sim-dl-title">{downloads[0].title}</h4>
                <p id="sim-dl-desc">{downloads[0].description}</p>
                <small id="sim-dl-size">{downloads[0].size} • {downloads[0].category}</small>
              </div>
            </div>
          </div>

          <div class="preview-footer-action">
            <button type="button" id="btn-save-informasi-side" class="btn btn-primary btn-block">
              <Icon name="check" size={18} />
              <span>Simpan Perubahan Informasi</span>
            </button>
          </div>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>

