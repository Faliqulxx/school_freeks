              <button type="button" class="pill-btn" data-mode="pengumuman">Pengumuman</button>
              <button type="button" class="pill-btn" data-mode="galeri">Galeri</button>
              <button type="button" class="pill-btn" data-mode="unduhan">Unduhan</button>
            </div>
          </div>

