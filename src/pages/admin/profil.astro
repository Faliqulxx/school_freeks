<script is:inline>
  function initProfil() {
    // Initial states for interactive sub-modules (Sekolah Contoh Modern Tech School)
    let historyState = [
      { year: "2019", title: "Awal Inisiasi & Digital Sandbox", description: "Berawal dari inisiatif komunitas inkubator teknologi dan lab kreatif independen anak muda bernama FREEKS Studio, yang menguji coba program eksplorasi coding, desain digital, dan robotika interaktif bagi remaja." },
      { year: "2021", title: "Pendirian Yayasan Pendidikan Teladan Nusantara & Izin Sekolah", description: "Resmi berbadan hukum di bawah Yayasan Inovasi Kreasi Digital (Yayasan Pendidikan Teladan Nusantara) dan memperoleh legalitas penyelenggaraan institusi pendidikan modern berbasis kurikulum integratif dan computational thinking." },
      { year: "2023", title: "Pembangunan Sekolah Cerdas & Tech Hub", description: "Peresmian gedung sekolah modern ramah lingkungan (FREEKS Campus) lengkap dengan fasilitas Smart Classroom, Maker Space, VR/AR Studio, serta arena kompetisi robotika." },
      { year: "2024", title: "Akreditasi Unggul & Kemitraan Ekosistem", description: "Meraih akreditasi Unggul (A) dan menjalin kemitraan inkubasi riset dengan berbagai industri kreatif digital, membuka akses magang mini dan mentoring industri untuk siswa." },
      { year: "2025–Kini", title: "Pelopor Modern Tech School Abad ke-21", description: "Menjadi episentrum pendidikan teknologi masa depan terdepan yang mengintegrasikan kurikulum nasional, kecerdasan buatan terapan, etika digital, dan inkubasi wirausaha teknologi muda." }
    ];

    let orgState = [
      { level: 1, role: "Dewan Pembina & Yayasan", name: "Ketua Pengurus Yayasan Pendidikan Teladan Nusantara", category: "Yayasan" },
      { level: 2, role: "Head of School / Principal", name: "Sekolah Contoh", category: "Pimpinan" },
      { level: 2, role: "Dewan Komite & Mitra Industri", name: "Perwakilan Industri Digital & Wali Murid", category: "Mitra" },
      { level: 3, role: "Waka Akademik & Kurikulum Tech", name: "Sekolah Contoh", category: "Akademik" },
      { level: 3, role: "Waka Kesiswaan & Portofolio Siswa", name: "Sekolah Contoh", category: "Kesiswaan" },
      { level: 3, role: "Waka Sarana & Digital Infrastructure", name: "Sekolah Contoh", category: "Sarpras" },
      { level: 4, role: "Koordinator AI & Robotics Lab", name: "Sekolah Contoh", category: "Laboratorium" },
      { level: 4, role: "Koordinator Digital Media & 3D Studio", name: "Sekolah Contoh", category: "Studio" },
      { level: 4, role: "Koordinator Library & Resource Center", name: "Sekolah Contoh", category: "Riset" },
      { level: 5, role: "Dewan Mentor & Instruktur Teknologi", name: "Seluruh Mentor & Guru Ahli", category: "Pengajar" },
      { level: 6, role: "Student Innovators & OSIS", name: "Pengurus OSIS & Komunitas Kreatif", category: "Siswa" }
    ];

    let facilitiesState = [
      { id: "fasilitas-1", name: "Cyber Smart Classrooms", description: "Ruang belajar interaktif ber-AC yang dilengkapi Smart Board digital, modul meja fleksibel untuk diskusi kelompok, dan jaringan gigabit fiber-optic super cepat.", image: { src: "/assets/hero-siswa-belajar.webp", alt: "Ruang Cyber Smart Classroom Sekolah Contoh Indonesia" } },
      { id: "fasilitas-2", name: "Maker Space & Robotics Arena", description: "Laboratorium rekayasa perangkat keras yang dilengkapi 3D printer, soldering station, mikrokontroler (Arduino/Raspberry Pi), dan lintasan uji robotika otonom.", image: { src: "/assets/berita-prestasi-sains.webp", alt: "Maker Space dan Arena Uji Robotika Siswa" } },
      { id: "fasilitas-3", name: "Digital Media & 3D Creative Studio", description: "Studio multimedia berkemampuan rendering tinggi untuk produksi karya animasi, pemodelan 3D, motion graphic, game development, dan podcast siswa.", image: { src: "/assets/kegiatan-sekolah-2.webp", alt: "Studio Media Kreatif dan Lab 3D Sekolah Contoh Indonesia" } },
      { id: "fasilitas-4", name: "VR/AR & Applied AI Laboratory", description: "Fasilitas headset virtual reality imersif dan workstation pengolahan model kecerdasan buatan untuk simulasi sains dan riset visual interaktif.", image: { src: "/assets/program-unggulan-tahfidz.webp", alt: "Lab Riset Sains dan Teknologi Interaktif" } },
      { id: "fasilitas-5", name: "Innovation Hub & Amphitheater", description: "Auditorium modern dan amfiteater terbuka untuk pitching proyek siswa, pameran karya teknologi (Showcase Day), serta seminar pembicara industri tamu.", image: { src: "/assets/gedung-freeks.webp", alt: "Gedung Utama FREEKS Campus dan Area Hub" } },
      { id: "fasilitas-6", name: "Co-Working Commons & Green Lounge", description: "Area kolaborasi santai luar ruangan dan kafe sehat ramah lingkungan untuk berdiskusi, brainstorming santai, dan relaksasi antar sesi belajar.", image: { src: "/assets/hero-siswa-berjalan.webp", alt: "Koridor dan area lingkungan hijau Sekolah" } }
    ];

    // Load from localStorage if present with auto-migration from legacy data
    const savedProfil = localStorage.getItem('mts_cms_profil_data');
    if (savedProfil) {
      try {
        const parsed = JSON.parse(savedProfil);
        if (parsed.history && Array.isArray(parsed.history) && parsed.history.length > 0) {
          // If legacy 1987 data, upgrade to modern FREEKS history
          if (parsed.history[0]?.year === "1987") {
            // Keep default modern tech history
          } else {
            historyState = parsed.history;
          }
        }
        if (parsed.org && Array.isArray(parsed.org) && parsed.org.length > 0) {
          if (parsed.org[0]?.role?.includes('Yayasan Inovasi Kreasi Digital (Yayasan Pendidikan Teladan Nusantara)') && parsed.org[0]?.name?.includes('Ketua Pengurus Yayasan')) {
            // Upgrade to modern org structure
          } else {
            orgState = parsed.org;
          }
        }
        if (parsed.facilities && Array.isArray(parsed.facilities) && parsed.facilities.length > 0) {
          if (parsed.facilities[0]?.name?.includes('Ruang Kelas Bersih')) {
            // Upgrade to modern tech facilities
          } else {
            facilitiesState = parsed.facilities.map(f => {
              if (f.image && f.image.src && (f.image.src.includes('Sekolah-2') || f.image.src.includes('undefined'))) {
                f.image.src = '/assets/kegiatan-sekolah-2.webp';
              }
              return f;
            });
          }
        }
        if (parsed.vision && document.getElementById('input-vision')) {
          document.getElementById('input-vision').value = parsed.vision;
        }
      } catch (e) {
        console.error('Failed to parse saved profil:', e);
      }
    }

    // Sub-modul tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab');
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Preview mode switcher
    const previewPills = document.querySelectorAll('#profil-preview-pills .pill-btn');
    const simViews = {
      sejarah: document.getElementById('sim-prof-sejarah'),
      visi: document.getElementById('sim-prof-visi'),
      sambutan: document.getElementById('sim-prof-sambutan'),
      struktur: document.getElementById('sim-prof-struktur')
    };

    previewPills.forEach(pill => {
      pill.addEventListener('click', () => {
        previewPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const mode = pill.getAttribute('data-mode');
        Object.keys(simViews).forEach(k => {
          if (simViews[k]) simViews[k].style.display = (k === mode) ? 'block' : 'none';
        });
      });
    });

    // Live preview sync
    function syncProfilPreview() {
      // Sejarah
      const leadInput = document.getElementById('input-sejarah-lead');
      if (leadInput && document.getElementById('sim-sejarah-lead-text')) {
        document.getElementById('sim-sejarah-lead-text').textContent = leadInput.value;
      }
      // Visi
      const visionInput = document.getElementById('input-vision');
      if (visionInput && document.getElementById('sim-vision-text')) {
        document.getElementById('sim-vision-text').textContent = `"${visionInput.value}"`;
      }
      // Sambutan
      const nameInput = document.getElementById('input-sambutan-prof-name');
      const roleInput = document.getElementById('input-sambutan-prof-role');
      const arabicInput = document.getElementById('input-sambutan-prof-arabic');
      if (nameInput && document.getElementById('sim-prof-sambutan-name')) {
        document.getElementById('sim-prof-sambutan-name').textContent = nameInput.value;
        if (document.getElementById('sim-org-mid-name')) document.getElementById('sim-org-mid-name').textContent = nameInput.value;
      }
      if (roleInput && document.getElementById('sim-prof-sambutan-role')) {
        document.getElementById('sim-prof-sambutan-role').textContent = roleInput.value + ' Sekolah Contoh Indonesia';
      }
      if (arabicInput && document.getElementById('sim-prof-arabic')) {
        document.getElementById('sim-prof-arabic').textContent = arabicInput.value;
      }
    }

    const liveInputs = document.querySelectorAll('#profil-form input, #profil-form textarea');
    liveInputs.forEach(i => i.addEventListener('input', syncProfilPreview));

    // CRUD Sejarah
    const historyListContainer = document.getElementById('history-list-container');
    const modalHistory = document.getElementById('modal-history');
    let editingHistoryIdx = -1;

    function renderHistoryList() {
      if (!historyListContainer) return;
      historyListContainer.innerHTML = '';
      historyState.forEach((h, idx) => {
        const item = document.createElement('div');
        item.className = 'history-admin-item';
        item.innerHTML = `
          <div class="history-year-tag">${h.year}</div>
          <div class="history-content-col">
            <strong>${h.title}</strong>
            <p>${h.description}</p>
          </div>
          <div class="history-actions">
            <button type="button" class="btn-action-edit btn-edit-h" data-idx="${idx}" title="Edit Peristiwa">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
              <span>Edit</span>
            </button>
            <button type="button" class="btn-action-delete btn-delete-h" data-idx="${idx}" title="Hapus Peristiwa">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;
        historyListContainer.appendChild(item);
      });

      document.querySelectorAll('.btn-edit-h').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingHistoryIdx = idx;
          const h = historyState[idx];
          document.getElementById('modal-history-title').textContent = 'Edit Tonggak Sejarah';
          document.getElementById('input-hist-year').value = h.year;
          document.getElementById('input-hist-title').value = h.title;
          document.getElementById('input-hist-desc').value = h.description;
          modalHistory.style.display = 'block';
          modalHistory.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-h').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = historyState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus peristiwa tahun ${item.year}?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              historyState.splice(idx, 1);
              renderHistoryList();
            });
          } else if (confirm(msg)) {
            historyState.splice(idx, 1);
            renderHistoryList();
          }
        });
      });

      if (historyState.length > 0) {
        if (document.getElementById('sim-first-year')) document.getElementById('sim-first-year').textContent = historyState[0].year;
        if (document.getElementById('sim-first-title')) document.getElementById('sim-first-title').textContent = historyState[0].title;
      }
    }

    const btnAddHistory = document.getElementById('btn-add-history');
    if (btnAddHistory) {
      btnAddHistory.addEventListener('click', () => {
        editingHistoryIdx = -1;
        document.getElementById('modal-history-title').textContent = 'Tambah Tonggak Sejarah';
        document.getElementById('input-hist-year').value = '';
        document.getElementById('input-hist-title').value = '';
        document.getElementById('input-hist-desc').value = '';
        modalHistory.style.display = 'block';
        modalHistory.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelHistory = document.getElementById('btn-cancel-history');
    if (btnCancelHistory) btnCancelHistory.addEventListener('click', () => { modalHistory.style.display = 'none'; });

    const btnSaveHistoryItem = document.getElementById('btn-save-history-item');
    if (btnSaveHistoryItem) {
      btnSaveHistoryItem.addEventListener('click', () => {
        const year = document.getElementById('input-hist-year').value.trim();
        const title = document.getElementById('input-hist-title').value.trim();
        const desc = document.getElementById('input-hist-desc').value.trim();
        if (!year || !title || !desc) {
          alert('Mohon lengkapi tahun, judul, dan narasi!');
          return;
        }
        if (editingHistoryIdx >= 0) {
          historyState[editingHistoryIdx] = { year, title, description: desc };
        } else {
          historyState.push({ year, title, description: desc });
        }
        modalHistory.style.display = 'none';
        renderHistoryList();
      });
    }

    // CRUD Struktur Organisasi
    const orgListContainer = document.getElementById('org-list-container');
    const modalOrg = document.getElementById('modal-org');
    let editingOrgIdx = -1;

    function renderOrgList() {
      if (!orgListContainer) return;
      orgListContainer.innerHTML = '';
      orgState.forEach((st, idx) => {
        const item = document.createElement('div');
        item.className = 'org-admin-card';
        item.innerHTML = `
          <div class="org-level-badge lvl-${st.level}">Lvl ${st.level}</div>
          <div class="org-info-col">
            <strong class="org-role-name">${st.role}</strong>
            <span class="org-person-name">${st.name}</span>
          </div>
          <div class="org-cat-tag">${st.category}</div>
          <div class="org-item-actions">
            <button type="button" class="btn-action-edit btn-edit-o" data-idx="${idx}" title="Edit Posisi">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
              <span>Edit</span>
            </button>
            <button type="button" class="btn-action-delete btn-delete-o" data-idx="${idx}" title="Hapus Posisi">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;
        orgListContainer.appendChild(item);
      });

      document.querySelectorAll('.btn-edit-o').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingOrgIdx = idx;
          const o = orgState[idx];
          document.getElementById('modal-org-title').textContent = 'Edit Posisi Organisasi';
          document.getElementById('input-org-level').value = o.level;
          document.getElementById('input-org-category').value = o.category;
          document.getElementById('input-org-role').value = o.role;
          document.getElementById('input-org-name').value = o.name;
          modalOrg.style.display = 'block';
          modalOrg.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-o').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = orgState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus posisi "${item.role}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              orgState.splice(idx, 1);
              renderOrgList();
            });
          } else if (confirm(msg)) {
            orgState.splice(idx, 1);
            renderOrgList();
          }
        });
      });
    }

    const btnAddOrg = document.getElementById('btn-add-org');
    if (btnAddOrg) {
      btnAddOrg.addEventListener('click', () => {
        editingOrgIdx = -1;
        document.getElementById('modal-org-title').textContent = 'Tambah Posisi Organisasi';
        document.getElementById('input-org-level').value = '3';
        document.getElementById('input-org-category').value = '';
        document.getElementById('input-org-role').value = '';
        document.getElementById('input-org-name').value = '';
        modalOrg.style.display = 'block';
        modalOrg.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelOrg = document.getElementById('btn-cancel-org');
    if (btnCancelOrg) btnCancelOrg.addEventListener('click', () => { modalOrg.style.display = 'none'; });

    const btnSaveOrgItem = document.getElementById('btn-save-org-item');
    if (btnSaveOrgItem) {
      btnSaveOrgItem.addEventListener('click', () => {
        const level = parseInt(document.getElementById('input-org-level').value, 10);
        const category = document.getElementById('input-org-category').value.trim();
        const role = document.getElementById('input-org-role').value.trim();
        const name = document.getElementById('input-org-name').value.trim();
        if (!category || !role || !name) {
          alert('Mohon lengkapi seluruh formulir posisi!');
          return;
        }
        if (editingOrgIdx >= 0) {
          orgState[editingOrgIdx] = { level, category, role, name };
        } else {
          orgState.push({ level, category, role, name });
        }
        modalOrg.style.display = 'none';
        renderOrgList();
      });
    }

    // CRUD Fasilitas
    const facContainer = document.getElementById('facilities-list-container');
    const modalFac = document.getElementById('modal-facility');
    let editingFacIdx = -1;

    function renderFacilitiesList() {
      if (!facContainer) return;
      facContainer.innerHTML = '';
      facilitiesState.forEach((fac, idx) => {
        const card = document.createElement('div');
        card.className = 'facility-admin-card';
        card.innerHTML = `
          <div class="fac-admin-thumb-wrap">
            <img src="${fac.image.src}" alt="${fac.name}" class="fac-admin-thumb" onerror="this.src='/assets/hero-siswa-belajar.webp'" />
          </div>
          <div class="fac-admin-body">
            <h4>${fac.name}</h4>
            <p class="fac-admin-desc">${fac.description}</p>
            <div class="fac-admin-actions">
              <button type="button" class="btn-action-edit btn-edit-f" data-idx="${idx}" title="Edit Fasilitas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                <span>Edit</span>
              </button>
              <button type="button" class="btn-action-delete btn-delete-f" data-idx="${idx}" title="Hapus Fasilitas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Hapus</span>
              </button>
            </div>
          </div>
        `;
        facContainer.appendChild(card);
      });

      document.querySelectorAll('.btn-edit-f').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingFacIdx = idx;
          const f = facilitiesState[idx];
          document.getElementById('modal-fac-title').textContent = 'Edit Fasilitas';
          document.getElementById('input-fac-id').value = f.id;
          document.getElementById('input-fac-name').value = f.name;
          document.getElementById('input-fac-img').value = f.image.src;
          const prevFacImg = document.getElementById('img-prev-fac');
          if (prevFacImg) prevFacImg.src = f.image.src;
          document.getElementById('input-fac-desc').value = f.description;
          modalFac.style.display = 'block';
          modalFac.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-f').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = facilitiesState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus fasilitas "${item.name}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              facilitiesState.splice(idx, 1);
              renderFacilitiesList();
            });
          } else if (confirm(msg)) {
            facilitiesState.splice(idx, 1);
            renderFacilitiesList();
          }
        });
      });
    }

    const btnAddFac = document.getElementById('btn-add-facility');
    if (btnAddFac) {
      btnAddFac.addEventListener('click', () => {
        editingFacIdx = -1;
        document.getElementById('modal-fac-title').textContent = 'Tambah Fasilitas Baru';
        document.getElementById('input-fac-id').value = 'fasilitas-' + Date.now();
        document.getElementById('input-fac-name').value = '';
        document.getElementById('input-fac-img').value = '/assets/gedung-freeks.webp';
        const prevFacImg = document.getElementById('img-prev-fac');
        if (prevFacImg) prevFacImg.src = '/assets/gedung-freeks.webp';
        document.getElementById('input-fac-desc').value = '';
        modalFac.style.display = 'block';
        modalFac.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelFac = document.getElementById('btn-cancel-facility');
    if (btnCancelFac) btnCancelFac.addEventListener('click', () => { modalFac.style.display = 'none'; });

    const btnSaveFacItem = document.getElementById('btn-save-facility-item');
    if (btnSaveFacItem) {
      btnSaveFacItem.addEventListener('click', () => {
        const id = document.getElementById('input-fac-id').value || ('fasilitas-' + Date.now());
        const name = document.getElementById('input-fac-name').value.trim();
        const src = document.getElementById('input-fac-img').value.trim();
        const desc = document.getElementById('input-fac-desc').value.trim();
        if (!name || !src || !desc) {
          alert('Mohon lengkapi nama fasilitas, foto WebP, dan deskripsi!');
          return;
        }
        const obj = { id, name, description: desc, image: { src, alt: name, width: 1200, height: 800 } };
        if (editingFacIdx >= 0) {
          facilitiesState[editingFacIdx] = obj;
        } else {
          facilitiesState.push(obj);
        }
        modalFac.style.display = 'none';
        renderFacilitiesList();
      });
    }

    // Dynamic Misi, Tujuan, Paragraf, Simbol & Unit Add/Delete with Standardized Action Buttons
    const btnAddMission = document.getElementById('btn-add-mission');
    const missionsContainer = document.getElementById('missions-list-container');
    if (btnAddMission && missionsContainer) {
      btnAddMission.addEventListener('click', () => {
        const count = missionsContainer.querySelectorAll('.ordered-item-row').length + 1;
        const row = document.createElement('div');
        row.className = 'ordered-item-row';
        row.innerHTML = `
          <div class="order-badge">${count}</div>
          <input type="text" class="form-control mission-input" placeholder="Tuliskan butir misi baru..." />
          <button type="button" class="btn-action-delete btn-delete-row" title="Hapus Misi">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            <span>Hapus</span>
          </button>
        `;
        row.querySelector('.btn-delete-row').addEventListener('click', () => row.remove());
        missionsContainer.appendChild(row);
      });
    }

    // Bind SSR missions delete
    document.querySelectorAll('.btn-delete-mission').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = btn.closest('.ordered-item-row');
        if (row) row.remove();
      });
    });

    const btnAddGoal = document.getElementById('btn-add-goal');
    const goalsContainer = document.getElementById('goals-list-container');
    if (btnAddGoal && goalsContainer) {
      btnAddGoal.addEventListener('click', () => {
        const count = goalsContainer.querySelectorAll('.ordered-item-row').length + 1;
        const row = document.createElement('div');
        row.className = 'ordered-item-row';
        row.innerHTML = `
          <div class="order-badge">${count}</div>
          <input type="text" class="form-control goal-input" placeholder="Tuliskan target capaian baru..." />
          <button type="button" class="btn-action-delete btn-delete-row" title="Hapus Tujuan">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            <span>Hapus</span>
          </button>
        `;
        row.querySelector('.btn-delete-row').addEventListener('click', () => row.remove());
        goalsContainer.appendChild(row);
      });
    }

    // Bind SSR goals delete
    document.querySelectorAll('.btn-delete-goal').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = btn.closest('.ordered-item-row');
        if (row) row.remove();
      });
    });

    // Paragraphs dynamic
    const btnAddP = document.getElementById('btn-add-paragraph');
    const pContainer = document.getElementById('sambutan-paragraphs-container');
    if (btnAddP && pContainer) {
      btnAddP.addEventListener('click', () => {
        const count = pContainer.querySelectorAll('.paragraph-item-row').length + 1;
        const row = document.createElement('div');
        row.className = 'paragraph-item-row';
        row.innerHTML = `
          <span class="p-num">§${count}</span>
          <textarea rows="3" class="form-control sambutan-p-input" placeholder="Tuliskan paragraf pidato baru..."></textarea>
          <button type="button" class="btn-action-delete btn-delete-p" title="Hapus Paragraf">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            <span>Hapus</span>
          </button>
        `;
        row.querySelector('.btn-delete-p').addEventListener('click', () => row.remove());
        pContainer.appendChild(row);
      });
    }

    document.querySelectorAll('.btn-delete-p').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = btn.closest('.paragraph-item-row');
        if (row) row.remove();
      });
    });

    // Symbols & units delete
    document.querySelectorAll('.btn-delete-symbol').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = btn.closest('.symbol-admin-card');
        if (row) row.remove();
      });
    });

    document.querySelectorAll('.btn-delete-unit').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const row = btn.closest('.unit-admin-row');
        if (row) row.remove();
      });
    });

    // Save All Profil Handler
    function handleSaveProfil() {
      // Collect missions
      const missionInputs = document.querySelectorAll('.mission-input');
      const missionsData = Array.from(missionInputs).map(i => i.value.trim()).filter(Boolean);

      // Collect goals
      const goalInputs = document.querySelectorAll('.goal-input');
      const goalsData = Array.from(goalInputs).map(i => i.value.trim()).filter(Boolean);

      // Collect sambutan paragraphs
      const pInputs = document.querySelectorAll('.sambutan-p-input');
      const pData = Array.from(pInputs).map(i => i.value.trim()).filter(Boolean);

      const payload = {
        updatedAt: new Date().toISOString(),
        history: historyState,
        vision: document.getElementById('input-vision')?.value || '',
        missions: missionsData,
        goals: goalsData,
        foundation: {
          name: document.getElementById('input-fnd-name')?.value || '',
          established: document.getElementById('input-fnd-est')?.value || '',
          leader: document.getElementById('input-fnd-leader')?.value || '',
          description: document.getElementById('input-fnd-desc')?.value || ''
        },
        sambutan: {
          name: document.getElementById('input-sambutan-prof-name')?.value || 'Sekolah Contoh',
          role: document.getElementById('input-sambutan-prof-role')?.value || 'Head of School / Principal',
          photo: {
            src: document.getElementById('input-sambutan-prof-photo')?.value || '/assets/guru-freeks.webp'
          },
          arabicGreeting: document.getElementById('input-sambutan-prof-arabic')?.value || '',
          fullText: pData
        },
        org: orgState,
        facilities: facilitiesState
      };

      localStorage.setItem('mts_cms_profil_data', JSON.stringify(payload));

      const toast = document.getElementById('save-toast');
      if (toast) {
        toast.hidden = false;
        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    const btnSave1 = document.getElementById('btn-save-profil');
    const btnSave2 = document.getElementById('btn-save-profil-side');
    if (btnSave1) btnSave1.addEventListener('click', handleSaveProfil);
    if (btnSave2) btnSave2.addEventListener('click', handleSaveProfil);

    const toastClose = document.getElementById('toast-close');
    if (toastClose) toastClose.addEventListener('click', () => { document.getElementById('save-toast').hidden = true; });

    // Export JSON
    const btnExport = document.getElementById('btn-export-profil-json');
    if (btnExport) {
      btnExport.addEventListener('click', () => {
        const saved = localStorage.getItem('mts_cms_profil_data');
        const dataObj = saved ? JSON.parse(saved) : { history: historyState, org: orgState, facilities: facilitiesState };
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(dataObj, null, 2));
        const a = document.createElement('a');
        a.setAttribute('href', dataStr);
        a.setAttribute('download', `profil-Sekolah-cms-${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Initial renders
    renderHistoryList();
    renderOrgList();
    renderFacilitiesList();
    syncProfilPreview();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProfil);
  } else {
    initProfil();
  }
</script>

