  /* Ordered Lists (Misi & Tujuan) */
  :global(.ordered-items-list) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.ordered-item-row) {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  :global(.order-badge) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
