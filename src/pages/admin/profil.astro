---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import profilData from '../../data/profil.json';
import heroSambutanData from '../../data/heroSambutan.json';
import siteData from '../../data/siteData.json';

const { history, vision, missions, goals, foundation, facilities } = profilData;
const { sambutan } = heroSambutanData;
const { school } = siteData;

const initialStructure = [
  { level: 1, role: "Dewan Pembina & Yayasan", name: "Ketua Pengurus Yayasan Pendidikan Teladan Nusantara", category: "Yayasan" },
  { level: 2, role: "Head of School / Principal", name: "Sekolah Contoh", category: "Pimpinan" },
  { level: 2, role: "Dewan Komite & Mitra Industri", name: "Perwakilan Industri Digital & Wali Murid", category: "Mitra" },
  { level: 3, role: "Waka Akademik & Kurikulum Tech", name: "Sekolah Contoh", category: "Akademik" },
  { level: 3, role: "Waka Kesiswaan & Portofolio Siswa", name: "Sekolah Contoh", category: "Kesiswaan" },
  { level: 3, role: "Waka Sarana & Digital Infrastructure", name: "Sekolah Contoh", category: "Sarpras" },
  { level: 4, role: "Koordinator AI & Robotics Lab", name: "Sekolah Contoh", category: "Laboratorium" },
  { level: 4, role: "Koordinator Digital Media & 3D Studio", name: "Sekolah Contoh", category: "Studio" },
  { level: 4, role: "Koordinator Library & Resource Center", name: "Sekolah Contoh", category: "Riset" },
  { level: 5, role: "Dewan Mentor & Instruktur Teknologi", name: "Seluruh Mentor & Guru Ahli", category: "Pengajar" },
  { level: 6, role: "Student Innovators & OSIS", name: "Pengurus OSIS & Komunitas Kreatif", category: "Siswa" }
];
---

<AdminLayout title="Manajemen Profil Sekolah (Modul 3)" activeMenu="profil">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 3 DARI 8</div>
      <h1>Manajemen Profil Sekolah</h1>
      <p class="page-subtitle">
        Kelola linimasa sejarah, visi misi tujuan, naskah sambutan pimpinan, hierarki struktur organisasi, profil Yayasan Pendidikan Teladan Nusantara, dan fasilitas sarana prasarana.
      </p>
    </div>

    <div class="header-action-group">
      <a href="/profil/sejarah" target="_blank" class="btn btn-secondary">
        <Icon name="external-link" size={16} />
        <span>Buka Web Publik</span>
      </a>
      <button type="button" id="btn-export-profil-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-profil" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Perubahan Profil Sekolah Berhasil Disimpan!</strong>
      <p>Data profil telah tersimpan secara lokal di browser Anda. Anda dapat mengunduh berkas profil.json terbaru kapan pun.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <!-- Sub-Modul Tab Navigation -->
  <div class="section-tabs-bar" role="tablist">
    <button type="button" class="tab-btn active" data-tab="tab-sejarah" role="tab" aria-selected="true">
      <Icon name="calendar" size={16} />
      <span>1. Sejarah</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-visimisi" role="tab" aria-selected="false">
      <Icon name="award" size={16} />
      <span>2. Visi, Misi & Tujuan</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-sambutan" role="tab" aria-selected="false">
      <Icon name="file-text" size={16} />
      <span>3. Sambutan Lengkap</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-struktur" role="tab" aria-selected="false">
      <Icon name="sitemap" size={16} />
      <span>4. Struktur Organisasi</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-yayasan" role="tab" aria-selected="false">
      <Icon name="landmark" size={16} />
      <span>5. Yayasan Pendidikan Teladan Nusantara</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-fasilitas" role="tab" aria-selected="false">
      <Icon name="box" size={16} />
      <span>6. Fasilitas Sarpras</span>
    </button>
  </div>

  <div class="profil-layout-grid">
    <!-- Left Column: Forms for 6 Sub-Modules -->
    <div class="form-container">
      <form id="profil-form" onsubmit="return false;">

        <!-- ========================================== -->
        <!-- SUB-MODUL 1: SEJARAH RINTISAN -->
        <!-- ========================================== -->
        <div class="tab-panel active" id="tab-sejarah">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="calendar" size={20} />
              </div>
              <div>
                <h3>Pengantar Sejarah & Dokumentasi Gedung</h3>
                <p class="card-desc">Paragraf pembuka sejarah Sekolah dan takarir foto arsip gedung utama.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-sejarah-lead">Paragraf Pengantar Sejarah <span class="req">*</span></label>
                <textarea
                  id="input-sejarah-lead"
                  name="sejarahLead"
                  rows="3"
                  required
                  class="form-control"
                >Sekolah Contoh Indonesia berawal dari kepedulian tokoh masyarakat dan para ulama di bawah naungan Yayasan Inovasi Kreasi Digital (Yayasan Pendidikan Teladan Nusantara) untuk menghadirkan pendidikan formal tingkat menengah pertama yang berakar pada nilai-nilai keislaman dan akhlak mulia.</textarea>
              </div>

              <div class="form-group col-span-2">
                <label for="input-sejarah-img">Path Foto Gedung Sekolah <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-sejarah"
                    src="/assets/gedung-freeks.webp"
                    alt="Foto Gedung Sejarah"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input
                      type="text"
                      id="input-sejarah-img"
                      name="sejarahImg"
                      value="/assets/gedung-freeks.webp"
                      required
                      class="form-control"
                    />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Gedung</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-sejarah-img" data-target-preview="img-prev-sejarah" data-sim-preview="sim-sejarah-preview-img" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                    <input
                      type="text"
                      id="input-sejarah-caption"
                      name="sejarahCaption"
                      value="Foto Gedung: Sekolah Sekolah Contoh Indonesia dengan motto Berilmu Beramal Berakhlak"
                      placeholder="Takarir foto arsip gedung..."
                      class="form-control"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CRUD Timeline Tonggak Sejarah -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="clock" size={20} />
                </div>
                <div>
                  <h3>Linimasa Tonggak Sejarah (CRUD)</h3>
                  <p class="card-desc">Tahapan peristiwa penting sejak tahun pendirian hingga era modern.</p>
                </div>
              </div>
              <button type="button" id="btn-add-history" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Peristiwa</span>
              </button>
            </div>

            <div class="history-admin-list" id="history-list-container">
              {history.map((h, idx) => (
                <div class="history-admin-item" data-idx={idx}>
                  <div class="history-year-tag">{h.year}</div>
                  <div class="history-content-col">
                    <strong>{h.title}</strong>
                    <p>{h.description}</p>
                  </div>
                  <div class="history-actions">
                    <button type="button" class="btn-action-edit btn-edit-h" data-idx={idx} title="Edit">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-h" data-idx={idx} title="Hapus">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal/Form Edit Tonggak Sejarah -->
          <div class="form-card card" id="modal-history" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-history-title">Tambah Tonggak Sejarah</h3>
                <p class="card-desc">Masukkan tahun, judul peristiwa, dan narasi penjelasan.</p>
              </div>
            </div>
            <div class="form-grid">
              <div class="form-group">
                <label for="input-hist-year">Tahun / Rentang <span class="req">*</span></label>
                <input type="text" id="input-hist-year" placeholder="Contoh: 1987 / 2024–Kini" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-hist-title">Judul Peristiwa <span class="req">*</span></label>
                <input type="text" id="input-hist-title" placeholder="Contoh: Awal Berdiri & Rintisan" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-hist-desc">Narasi Sejarah <span class="req">*</span></label>
                <textarea id="input-hist-desc" rows="3" placeholder="Penjelasan mengenai latar belakang dan capaian peristiwa..." class="form-control"></textarea>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-history" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-history-item" class="btn btn-primary">Simpan Peristiwa</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 2: VISI, MISI & TUJUAN -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-visimisi">
          <!-- Visi -->
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="award" size={20} />
              </div>
              <div>
                <h3>Visi Sekolah</h3>
                <p class="card-desc">Pernyataan cita-cita luhur jangka panjang institusi Sekolah Contoh Indonesia.</p>
              </div>
            </div>
            <div class="form-group">
              <label for="input-vision">Teks Visi Utama <span class="req">*</span></label>
              <textarea
                id="input-vision"
                name="vision"
                rows="3"
                required
                class="form-control"
              >{vision}</textarea>
            </div>
          </div>

          <!-- Misi -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="check-circle" size={20} />
                </div>
                <div>
                  <h3>Butir-Butir Misi (CRUD)</h3>
                  <p class="card-desc">Langkah strategis operasional untuk mewujudkan visi Sekolah.</p>
                </div>
              </div>
              <button type="button" id="btn-add-mission" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Misi</span>
              </button>
            </div>

            <div class="ordered-items-list" id="missions-list-container">
              {missions.map((m, idx) => (
                <div class="ordered-item-row" data-idx={idx}>
                  <div class="order-badge">{idx + 1}</div>
                  <input type="text" class="form-control mission-input" value={m} />
                  <button type="button" class="btn-action-delete btn-delete-mission" data-idx={idx} title="Hapus Misi">
                    <Icon name="trash-2" size={14} />
                    <span>Hapus</span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- Tujuan -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="target" size={20} />
                </div>
                <div>
                  <h3>Tujuan Pendidikan Sekolah (CRUD)</h3>
                  <p class="card-desc">Target capaian lulusan dan kelembagaan yang terukur.</p>
                </div>
              </div>
              <button type="button" id="btn-add-goal" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Tujuan</span>
              </button>
            </div>

            <div class="ordered-items-list" id="goals-list-container">
              {goals.map((g, idx) => (
                <div class="ordered-item-row" data-idx={idx}>
                  <div class="order-badge">{idx + 1}</div>
                  <input type="text" class="form-control goal-input" value={g} />
                  <button type="button" class="btn-action-delete btn-delete-goal" data-idx={idx} title="Hapus Tujuan">
                    <Icon name="trash-2" size={14} />
                    <span>Hapus</span>
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 3: SAMBUTAN Head of School / Principal LENGKAP -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-sambutan">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="file-text" size={20} />
              </div>
              <div>
                <h3>Sambutan Head of School / Principal Lengkap</h3>
                <p class="card-desc">Naskah pidato resmi untuk halaman profil sambutan (`/profil/sambutan`).</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-sambutan-prof-name">Nama Lengkap Head of School / Principal <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-sambutan-prof-name"
                  value={sambutan.name}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-sambutan-prof-role">Jabatan Resmi <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-sambutan-prof-role"
                  value={sambutan.role}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-sambutan-prof-photo">Foto Resmi Head of School / Principal <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-sambutan-prof"
                    src={sambutan.photo.src}
                    alt={sambutan.photo.alt}
                    class="asset-thumb-leader"
                  />
                  <div class="asset-details">
                    <input
                      type="text"
                      id="input-sambutan-prof-photo"
                      value={sambutan.photo.src}
                      required
                      class="form-control"
                    />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Pimpinan</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-sambutan-prof-photo" data-target-preview="img-prev-sambutan-prof" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                    <input
                      type="text"
                      id="input-sambutan-prof-motto"
                      value="Pendidikan adalah amal jariyah dan ikhtiar mencerdaskan umat."
                      placeholder="Motto pimpinan..."
                      class="form-control"
                    />
                  </div>
                </div>
              </div>

              <div class="form-group col-span-2">
                <label for="input-sambutan-prof-arabic">Salam Pembuka Bahasa Arab <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-sambutan-prof-arabic"
                  value={sambutan.arabicGreeting}
                  dir="rtl"
                  required
                  class="form-control font-arabic"
                />
              </div>

              <div class="form-group col-span-2">
                <label>Paragraf Pidato Sambutan Lengkap (Per Paragraf)</label>
                <div class="paragraphs-list" id="sambutan-paragraphs-container">
                  {sambutan.fullText.map((p, idx) => (
                    <div class="paragraph-item-row" data-idx={idx}>
                      <span class="p-num">§{idx + 1}</span>
                      <textarea rows="3" class="form-control sambutan-p-input">{p}</textarea>
                      <button type="button" class="btn-action-delete btn-delete-p" data-idx={idx} title="Hapus Paragraf">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  ))}
                </div>
                <button type="button" id="btn-add-paragraph" class="btn btn-secondary btn-sm mt-2">
                  <Icon name="plus" size={15} />
                  <span>Tambah Paragraf Pidato</span>
                </button>
              </div>

              <div class="form-group">
                <label for="input-sambutan-sig-city">Kota & Titimangsa Surat</label>
                <input type="text" id="input-sambutan-sig-city" value="Kecamatan Contoh, Oktober 2026" class="form-control" />
              </div>

              <div class="form-group">
                <label for="input-sambutan-sig-nip">NIP Pimpinan</label>
                <input type="text" id="input-sambutan-sig-nip" value="NIP. 19780512 200501 1 004" class="form-control" />
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 4: STRUKTUR ORGANISASI -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-struktur">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="sitemap" size={20} />
                </div>
                <div>
                  <h3>Bagan Hierarki & Struktur Organisasi (CRUD)</h3>
                  <p class="card-desc">Susunan kepemimpinan, waka Sekolah, koordinator, dan dewan pengajar.</p>
                </div>
              </div>
              <button type="button" id="btn-add-org" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Posisi</span>
              </button>
            </div>

            <div class="org-admin-list" id="org-list-container">
              {initialStructure.map((st, idx) => (
                <div class="org-admin-card" data-idx={idx}>
                  <div class={`org-level-badge lvl-${st.level}`}>Lvl {st.level}</div>
                  <div class="org-info-col">
                    <strong class="org-role-name">{st.role}</strong>
                    <span class="org-person-name">{st.name}</span>
                  </div>
                  <div class="org-cat-tag">{st.category}</div>
                  <div class="org-item-actions">
                    <button type="button" class="btn-action-edit btn-edit-o" data-idx={idx} title="Edit Posisi">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-o" data-idx={idx} title="Hapus Posisi">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal/Form Edit Struktur -->
          <div class="form-card card" id="modal-org" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-org-title">Tambah Posisi Organisasi</h3>
                <p class="card-desc">Atur level hierarki (1 = Yayasan, 2 = Pimpinan/Komite, 3 = Waka, 4 = Koordinator).</p>
              </div>
            </div>
            <div class="form-grid">
              <div class="form-group">
                <label for="input-org-level">Level Hierarki (1-6) <span class="req">*</span></label>
                <select id="input-org-level" class="form-control">
                  <option value="1">Level 1 - Yayasan</option>
                  <option value="2">Level 2 - Pimpinan / Komite</option>
                  <option value="3">Level 3 - Waka / Tata Usaha</option>
                  <option value="4">Level 4 - Koordinator Unit</option>
                  <option value="5">Level 5 - Dewan Guru / Pembina</option>
                  <option value="6">Level 6 - Siswa / OSIS</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-org-category">Kategori Departemen <span class="req">*</span></label>
                <input type="text" id="input-org-category" placeholder="Contoh: Pimpinan / Akademik / Sarpras" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-org-role">Nama Jabatan / Posisi <span class="req">*</span></label>
                <input type="text" id="input-org-role" placeholder="Contoh: Waka Kurikulum" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-org-name">Nama Pejabat / Personil <span class="req">*</span></label>
                <input type="text" id="input-org-name" placeholder="Contoh: Sekolah Contoh" class="form-control" />
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-org" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-org-item" class="btn btn-primary">Simpan Posisi</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 5: PROFIL FREEKS FOUNDATION -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-yayasan">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="landmark" size={20} />
              </div>
              <div>
                <h3>Identitas Yayasan Yayasan Pendidikan Teladan Nusantara</h3>
                <p class="card-desc">Informasi yayasan penaung institusi pendidikan Sekolah Contoh Indonesia.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-fnd-name">Nama Resmi Yayasan <span class="req">*</span></label>
                <input type="text" id="input-fnd-name" value={foundation.name} required class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-fnd-est">Tahun Berdiri <span class="req">*</span></label>
                <input type="text" id="input-fnd-est" value={foundation.established} required class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-fnd-leader">Ketua Pengurus Yayasan <span class="req">*</span></label>
                <input type="text" id="input-fnd-leader" value={foundation.leader} required class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-fnd-desc">Narasi Sejarah & Khidmah Yayasan <span class="req">*</span></label>
                <textarea id="input-fnd-desc" rows="3" required class="form-control">{foundation.description}</textarea>
              </div>
            </div>
          </div>

          <!-- CRUD Makna Lambang Yayasan -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="award" size={20} />
                </div>
                <div>
                  <h3>Makna & Simbol Lambang FREEKS (CRUD)</h3>
                  <p class="card-desc">Arti filosofis di balik logo 3D yayasan.</p>
                </div>
              </div>
              <button type="button" id="btn-add-symbol" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Simbol</span>
              </button>
            </div>

            <div class="symbols-admin-list" id="symbols-list-container">
              {foundation.logoMeaning.map((sym, idx) => (
                <div class="symbol-admin-card" data-idx={idx}>
                  <div class="sym-elem-pill">{sym.element}</div>
                  <div class="sym-content-col">
                    <strong>{sym.symbol}</strong>
                    <p>{sym.description}</p>
                  </div>
                  <div class="sym-actions">
                    <button type="button" class="btn-action-delete btn-delete-symbol" data-idx={idx} title="Hapus Simbol">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Ekosistem Pendidikan & Lab FREEKS -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="book-open" size={20} />
                </div>
                <div>
                  <h3>Ekosistem Pendidikan & Lab FREEKS (CRUD)</h3>
                  <p class="card-desc">Lembaga dan divisi pendidikan di bawah ekosistem FREEKS.</p>
                </div>
              </div>
              <button type="button" id="btn-add-unit" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Unit</span>
              </button>
            </div>

            <div class="units-admin-list" id="units-list-container">
              {foundation.units.map((u, idx) => (
                <div class="unit-admin-row" data-idx={idx}>
                  <input type="text" class="form-control unit-name-input" value={u.name} placeholder="Nama Lembaga..." />
                  <input type="text" class="form-control unit-desc-input" value={u.desc} placeholder="Keterangan Jenjang..." />
                  <button type="button" class="btn-action-delete btn-delete-unit" data-idx={idx} title="Hapus Unit">
                    <Icon name="trash-2" size={14} />
                    <span>Hapus</span>
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 6: FASILITAS SEKOLAH -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-fasilitas">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="box" size={20} />
                </div>
                <div>
                  <h3>Sarana & Fasilitas Sekolah (CRUD)</h3>
                  <p class="card-desc">Kelola laboratorium, ruang kelas, musala, perpustakaan, dan gedung utama.</p>
                </div>
              </div>
              <button type="button" id="btn-add-facility" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Fasilitas</span>
              </button>
            </div>

            <div class="facilities-admin-grid" id="facilities-list-container">
              {facilities.map((fac, idx) => (
                <div class="facility-admin-card" data-id={fac.id}>
                  <div class="fac-admin-thumb-wrap">
                    <img src={fac.image.src} alt={fac.image.alt} class="fac-admin-thumb" onerror="this.src='/assets/hero-siswa-belajar.webp'" />
                  </div>
                  <div class="fac-admin-body">
                    <h4>{fac.name}</h4>
                    <p class="fac-admin-desc">{fac.description}</p>
                    <div class="fac-admin-actions">
                      <button type="button" class="btn-action-edit btn-edit-f" data-idx={idx} title="Edit Fasilitas">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-f" data-idx={idx} title="Hapus Fasilitas">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal/Form Edit Fasilitas -->
          <div class="form-card card" id="modal-facility" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-fac-title">Tambah Fasilitas Baru</h3>
                <p class="card-desc">Lengkapi nama ruangan, deskripsi kenyamanan, dan path foto WebP.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-fac-id" value="" />
              <div class="form-group col-span-2">
                <label for="input-fac-name">Nama Fasilitas / Ruangan <span class="req">*</span></label>
                <input type="text" id="input-fac-name" placeholder="Contoh: Laboratorium Komputer Modern" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-fac-img">Foto Fasilitas (WebP) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-fac"
                    src="/assets/kegiatan-Sekolah-2.webp"
                    alt="Pratinjau Fasilitas"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-fac-img" placeholder="/assets/kegiatan-Sekolah-2.webp" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Fasilitas</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-fac-img" data-target-preview="img-prev-fac" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="form-group col-span-2">
                <label for="input-fac-desc">Deskripsi Fasilitas & Sarana <span class="req">*</span></label>
                <textarea id="input-fac-desc" rows="3" placeholder="Fasilitas dilengkapi AC, sarana multimedia, dll..." class="form-control"></textarea>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-facility" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-facility-item" class="btn btn-primary">Simpan Fasilitas</button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Interactive Live Preview -->
    <aside class="preview-container">
      <div class="preview-sticky-wrap">
        <div class="card preview-card">
          <div class="card-header-sm">
            <div class="flex-align-center gap-2">
              <Icon name="eye" size={18} />
              <h4>Pratinjau Profil</h4>
            </div>
            <div class="preview-mode-pills" id="profil-preview-pills">
              <button type="button" class="pill-btn active" data-mode="sejarah">Sejarah</button>
              <button type="button" class="pill-btn" data-mode="visi">Visi</button>
              <button type="button" class="pill-btn" data-mode="sambutan">Sambutan</button>
              <button type="button" class="pill-btn" data-mode="struktur">Struktur</button>
            </div>
          </div>

          <!-- Preview 1: Sejarah -->
          <div id="sim-prof-sejarah" class="sim-prof-view active">
            <div class="sim-sejarah-box">
              <img id="sim-sejarah-preview-img" src="/assets/gedung-freeks.webp" alt="Gedung" class="sim-sejarah-img" />
              <div class="sim-sejarah-lead" id="sim-sejarah-lead-text">
                Sekolah Contoh Indonesia berawal dari kepedulian tokoh masyarakat dan ulama...
              </div>
              <div class="sim-timeline-mini" id="sim-timeline-mini">
                <div class="sim-timeline-row">
                  <span class="sim-yr" id="sim-first-year">{history[0].year}</span>
                  <span class="sim-tl-title" id="sim-first-title">{history[0].title}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Preview 2: Visi & Misi -->
          <div id="sim-prof-visi" class="sim-prof-view" style="display: none;">
            <div class="sim-visi-box">
              <span class="sim-badge-tag">Visi Institusi</span>
              <blockquote class="sim-vision-quote" id="sim-vision-text">"{vision}"</blockquote>
              <div class="sim-missions-preview">
                <strong>Butir Misi Teratas:</strong>
                <p id="sim-mission-first">{missions[0]}</p>
              </div>
            </div>
          </div>

          <!-- Preview 3: Sambutan -->
          <div id="sim-prof-sambutan" class="sim-prof-view" style="display: none;">
            <div class="sim-sambutan-box">
              <div class="sim-sambutan-head">
                <img src={sambutan.photo.src} alt="Foto" class="sim-leader-avatar" />
                <div>
                  <h4 id="sim-prof-sambutan-name">{sambutan.name}</h4>
                  <small id="sim-prof-sambutan-role">{sambutan.role} Sekolah Contoh Indonesia</small>
                </div>
              </div>
              <div class="sim-arabic" id="sim-prof-arabic">{sambutan.arabicGreeting}</div>
              <p class="sim-p-first" id="sim-prof-p1">"{sambutan.fullText[0]}"</p>
            </div>
          </div>

          <!-- Preview 4: Struktur -->
          <div id="sim-prof-struktur" class="sim-prof-view" style="display: none;">
            <div class="sim-struktur-box">
              <div class="sim-org-node top">
                <span>Ketua Yayasan</span>
                <strong>Yayasan Pendidikan Teladan Nusantara</strong>
              </div>
              <div class="sim-org-connector"></div>
              <div class="sim-org-node mid">
                <span>Head of School / Principal</span>
                <strong id="sim-org-mid-name">{sambutan.name}</strong>
              </div>
              <div class="sim-org-connector"></div>
              <div class="sim-org-row">
                <div class="sim-org-node sub">Kurikulum</div>
                <div class="sim-org-node sub">Kesiswaan</div>
                <div class="sim-org-node sub">Sarpras</div>
              </div>
            </div>
          </div>

          <div class="preview-footer-action">
            <button type="button" id="btn-save-profil-side" class="btn btn-primary btn-block">
              <Icon name="check" size={18} />
              <span>Simpan Profil Sekolah</span>
            </button>
          </div>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>

<style>
  .page-header-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--admin-ink-300);
  }

  @media (min-width: 768px) {
    .page-header-wrap {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .module-tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--admin-green-700);
    letter-spacing: 0.8px;
    margin-bottom: 6px;
  }

  .page-header-wrap h1 {
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--admin-ink-500);
    max-width: 75ch;
  }

  .header-action-group {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Sub-Modul Tabs */
  .section-tabs-bar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--admin-ink-100);
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-size: 0.875rem;
    font-weight: 600;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--admin-ink-500);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    border-radius: 6px 6px 0 0;
  }

  .tab-btn:hover {
    color: var(--admin-green-800);
    background-color: var(--admin-green-50);
  }

  .tab-btn.active {
    color: var(--admin-green-900);
