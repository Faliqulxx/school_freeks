    color: #FFFFFF;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sender-info strong {
    display: block;
    font-size: 0.875rem;
  }

  .sender-info span {
    font-size: 0.75rem;
    color: var(--admin-ink-500);
  }

  .reader-body {
    margin-bottom: 20px;
  }

  .message-content-box {
    font-size: 0.85rem;
    color: var(--admin-ink-900);
    line-height: 1.55;
    background-color: #FFFFFF;
    border-left: 3px solid var(--admin-green-700);
    padding: 10px 14px;
    font-style: normal;
  }

  .reader-actions-bar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--admin-ink-100);
    padding-top: 16px;
  }

  .btn-wa {
    background-color: #25D366;
