        date: "2026-10-20 19:05",
        status: "Sudah Dibalas",
        message: "Saya alumni FREEKS.id School angkatan 2024 bermaksud memohon surat rekomendasi akademik dan transkrip portofolio proyek untuk pendaftaran beasiswa teknologi. Apakah bisa diproses dalam 2 hari kerja?"
      }
    ];

    // Load from localStorage if present with auto-migration
    const savedMessages = localStorage.getItem('mts_cms_kontak_messages');
    if (savedMessages) {
      try {
        const parsed = JSON.parse(savedMessages);
        const hasLegacy = Array.isArray(parsed) && parsed.some(m => m.message?.includes('Al-Qur\'an') || m.message?.includes('MTs') || m.message?.includes('tadarus'));
        if (hasLegacy) {
          localStorage.removeItem('mts_cms_kontak_messages');
        } else if (Array.isArray(parsed) && parsed.length > 0) {
          messagesState = parsed;
        }
      } catch (e) {
        console.error('Failed to parse saved messages:', e);
      }
    }

    let currentSelectedIdx = 0;
    let currentFilter = 'all';

    const container = document.getElementById('messages-container');

    function updateMetrics() {
      const unreadCount = messagesState.filter(m => m.status === 'Belum Dibaca').length;
      const repliedCount = messagesState.filter(m => m.status === 'Sudah Dibalas').length;
      const ppdbCount = messagesState.filter(m => m.subject === 'Informasi PPDB').length;

      if (document.getElementById('metric-unread')) document.getElementById('metric-unread').textContent = unreadCount;
      if (document.getElementById('metric-replied')) document.getElementById('metric-replied').textContent = repliedCount;
      if (document.getElementById('metric-ppdb')) document.getElementById('metric-ppdb').textContent = ppdbCount;
      if (document.getElementById('metric-total')) document.getElementById('metric-total').textContent = messagesState.length;
    }

    function renderReader(idx) {
      if (idx < 0 || idx >= messagesState.length) return;
      currentSelectedIdx = idx;
      const m = messagesState[idx];

      if (document.getElementById('reader-status')) {
        const statusEl = document.getElementById('reader-status');
        statusEl.textContent = m.status;
        statusEl.className = 'status-pill ' + (m.status === 'Belum Dibaca' ? 'status-unread' : 'status-replied');
      }

      if (document.getElementById('reader-cat')) document.getElementById('reader-cat').textContent = m.subject;
      if (document.getElementById('reader-subject')) document.getElementById('reader-subject').textContent = m.subject;
      if (document.getElementById('reader-date')) document.getElementById('reader-date').textContent = m.date;
      if (document.getElementById('reader-name')) document.getElementById('reader-name').textContent = m.name;
      if (document.getElementById('reader-contact')) document.getElementById('reader-contact').textContent = m.contact;
      if (document.getElementById('reader-avatar')) document.getElementById('reader-avatar').textContent = m.name.charAt(0).toUpperCase();
      if (document.getElementById('reader-body-text')) document.getElementById('reader-body-text').textContent = `"${m.message}"`;

      // Quick WA link
      const btnWA = document.getElementById('btn-quick-wa');
      if (btnWA) {
        if (m.isWhatsApp || m.contact.startsWith('08') || m.contact.startsWith('+62')) {
          btnWA.style.display = 'inline-flex';
          const cleanPhone = m.contact.replace(/^0/, '62').replace(/[^0-9]/g, '');
          const replyText = `Halo ${m.name}. Terima kasih telah menghubungi FREEKS.id School perihal "${m.subject}". Berikut informasi yang dapat kami sampaikan: `;
          btnWA.href = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(replyText)}`;
        } else {
          btnWA.style.display = 'none';
        }
      }

      // Quick Email link
      const btnMail = document.getElementById('btn-quick-mail');
      if (btnMail) {
        if (m.contact.includes('@')) {
          btnMail.style.display = 'inline-flex';
          btnMail.href = `mailto:${m.contact}?subject=Tanggapan%20FREEKS.id%20School:%20${encodeURIComponent(m.subject)}`;
        } else {
          btnMail.style.display = 'none';
        }
      }

      // Toggle read label
      const toggleLabel = document.getElementById('label-toggle-read');
      if (toggleLabel) {
        toggleLabel.textContent = m.status === 'Belum Dibaca' ? 'Tandai Sudah Dibalas' : 'Tandai Belum Dibaca';
      }
    }
        toggleLabel.textContent = m.status === 'Belum Dibaca' ? 'Tandai Sudah Dibalas' : 'Tandai Belum Dibaca';
      }
    }

    function renderMessagesList() {
      if (!container) return;
      container.innerHTML = '';

      let filtered = messagesState;
      if (currentFilter === 'Belum Dibaca') filtered = messagesState.filter(m => m.status === 'Belum Dibaca');
      else if (currentFilter === 'Sudah Dibalas') filtered = messagesState.filter(m => m.status === 'Sudah Dibalas');
      else if (currentFilter === 'Informasi PPDB') filtered = messagesState.filter(m => m.subject === 'Informasi PPDB');
      else if (currentFilter === 'Saran & Pengaduan') filtered = messagesState.filter(m => m.subject === 'Saran & Pengaduan');

      if (filtered.length === 0) {
        container.innerHTML = '<div style="padding:24px;text-align:center;color:var(--admin-ink-500);font-size:0.875rem;">Tidak ada pesan dalam kategori ini.</div>';
        return;
      }

      filtered.forEach((msg, fIdx) => {
        const originalIdx = messagesState.indexOf(msg);
        const card = document.createElement('div');
        const isUnread = msg.status === 'Belum Dibaca';
        const isSelected = originalIdx === currentSelectedIdx;

        card.className = `message-item-card ${isUnread ? 'unread' : ''} ${isSelected ? 'active' : ''}`;
        card.innerHTML = `
          <div class="msg-item-top">
            <strong>${msg.name}</strong>
            <span class="msg-item-date">${msg.date}</span>
          </div>
          <div class="msg-item-badges">
            <span class="status-pill ${isUnread ? 'status-unread' : 'status-replied'}">${msg.status}</span>
            <span class="category-pill">${msg.subject}</span>
          </div>
          <p class="msg-item-snippet">${msg.message}</p>
        `;

        card.addEventListener('click', () => {
          renderReader(originalIdx);
          renderMessagesList();
        });

        container.appendChild(card);
      });

      updateMetrics();
    }

    // Filter pills
    document.querySelectorAll('.filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.getAttribute('data-filter');
        renderMessagesList();
      });
    });

    // Toggle Read Status
    const btnToggleRead = document.getElementById('btn-toggle-read');
    if (btnToggleRead) {
      btnToggleRead.addEventListener('click', () => {
        if (currentSelectedIdx >= 0 && currentSelectedIdx < messagesState.length) {
          const current = messagesState[currentSelectedIdx].status;
          messagesState[currentSelectedIdx].status = (current === 'Belum Dibaca') ? 'Sudah Dibalas' : 'Belum Dibaca';
          localStorage.setItem('mts_cms_kontak_messages', JSON.stringify(messagesState));
          renderReader(currentSelectedIdx);
          renderMessagesList();
        }
      });
    }

    // Delete message
    const btnDeleteMsg = document.getElementById('btn-delete-msg');
    if (btnDeleteMsg) {
      btnDeleteMsg.addEventListener('click', () => {
        if (currentSelectedIdx >= 0 && currentSelectedIdx < messagesState.length) {
          const item = messagesState[currentSelectedIdx];
          const msg = `Apakah Anda yakin ingin menghapus pesan dari "${item.name}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              messagesState.splice(currentSelectedIdx, 1);
              localStorage.setItem('mts_cms_kontak_messages', JSON.stringify(messagesState));
              currentSelectedIdx = 0;
              renderMessagesList();
              if (messagesState.length > 0) renderReader(0);
            });
          } else if (confirm(msg)) {
            messagesState.splice(currentSelectedIdx, 1);
            localStorage.setItem('mts_cms_kontak_messages', JSON.stringify(messagesState));
            currentSelectedIdx = 0;
            renderMessagesList();
            if (messagesState.length > 0) renderReader(0);
          }
        }
      });
    }

    // Export CSV
    const btnExportCSV = document.getElementById('btn-export-messages-csv');
    if (btnExportCSV) {
      btnExportCSV.addEventListener('click', () => {
        let csv = "ID Pesan,Nama Pengirim,Kontak,Kategori Perihal,Waktu Kirim,Status,Isi Pesan\n";
        messagesState.forEach(m => {
          csv += `"${m.id}","${m.name}","${m.contact}","${m.subject}","${m.date}","${m.status}","${m.message.replace(/"/g, '""')}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `rekap-pesan-aspirasi-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Save Messages
    const btnSave = document.getElementById('btn-save-messages');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        localStorage.setItem('mts_cms_kontak_messages', JSON.stringify(messagesState));
        const toast = document.getElementById('save-toast');
        if (toast) {
          toast.hidden = false;
          toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }

    const toastClose = document.getElementById('toast-close');
    if (toastClose) toastClose.addEventListener('click', () => { document.getElementById('save-toast').hidden = true; });

    // Initial render
    renderMessagesList();
    if (messagesState.length > 0) renderReader(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKontak);
  } else {
    initKontak();
  }
</script>
