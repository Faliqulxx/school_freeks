  :global(.category-pill) {
    font-size: 0.68rem;
    font-weight: 600;
    background-color: var(--admin-ink-100);
    color: var(--admin-ink-700);
    padding: 2px 6px;
    border-radius: 4px;
  }

  :global(.msg-item-snippet) {
    font-size: 0.8rem;
    color: var(--admin-ink-700);
    line-height: 1.4;
    white-space: nowrap;
