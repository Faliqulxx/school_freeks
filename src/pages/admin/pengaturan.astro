---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import siteData from '../../data/siteData.json';

const { school } = siteData;
---

<AdminLayout title="Pengaturan Global Situs (Modul 1)" activeMenu="pengaturan">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 1 DARI 8</div>
      <h1>Pengaturan Global Situs</h1>
      <p class="page-subtitle">
        Kelola identitas utama Sekolah, alamat resmi, kontak pelayanan WhatsApp, jam kerja, dan akun media sosial yang tampil di seluruh halaman website.
      </p>
    </div>

    <div class="header-action-group">
      <button type="button" id="btn-export-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-settings" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Perubahan Berhasil Disimpan!</strong>
      <p>Data pengaturan global telah diperbarui secara lokal. Anda juga dapat mengunduh berkas siteData.json terbaru.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <div class="settings-layout-grid">
    <!-- Left Column: Form Sections -->
    <div class="form-container">
      <form id="global-settings-form" onsubmit="return false;">
        <!-- Card 1: Identitas Sekolah -->
        <div class="form-card card" id="sec-identitas">
          <div class="card-header">
            <div class="header-icon-wrap">
              <Icon name="landmark" size={20} />
            </div>
            <div>
              <h3>1. Identitas Sekolah</h3>
              <p class="card-desc">Informasi resmi lembaga di bawah naungan Kementerian Agama dan Yayasan.</p>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group col-span-2">
              <label for="input-school-name">Nama Resmi Sekolah <span class="req">*</span></label>
              <input
                type="text"
                id="input-school-name"
                name="name"
                value={school.name}
                required
                class="form-control"
              />
              <span class="form-help">Nama lengkap yang muncul pada judul situs dan kop resmi.</span>
            </div>

            <div class="form-group">
              <label for="input-short-name">Nama Singkat / Brand <span class="req">*</span></label>
              <input
                type="text"
                id="input-short-name"
                name="shortName"
                value={school.shortName}
                required
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-foundation">Yayasan Naungan <span class="req">*</span></label>
              <input
                type="text"
                id="input-foundation"
                name="foundation"
                value={school.foundation}
                required
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-npsn">NPSN (Nomor Pokok Sekolah Nasional) <span class="req">*</span></label>
              <input
                type="text"
                id="input-npsn"
                name="npsn"
                value={school.npsn}
                required
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-accreditation">Status Akreditasi <span class="req">*</span></label>
              <select id="input-accreditation" name="accreditation" class="form-control">
                <option value="Unggul" selected={school.accreditation === 'Unggul'}>Unggul</option>
                <option value="A" selected={school.accreditation === 'A'}>A (Amat Baik)</option>
                <option value="B" selected={school.accreditation === 'B'}>B (Baik)</option>
                <option value="C" selected={school.accreditation === 'C'}>C (Cukup)</option>
              </select>
            </div>

            <div class="form-group col-span-2">
              <label for="input-slogan">Motto / Slogan Sekolah <span class="req">*</span></label>
              <input
                type="text"
                id="input-slogan"
                name="slogan"
                value={school.slogan}
                required
                class="form-control"
              />
              <span class="form-help">Slogan yang tertulis di fasad gedung: "Berilmu, Beramal, Berakhlak".</span>
            </div>
          </div>
        </div>
          </div>
        </div>

        <!-- Card 2: Kontak & Pelayanan -->
        <div class="form-card card" id="sec-kontak">
          <div class="card-header">
            <div class="header-icon-wrap">
              <Icon name="phone" size={20} />
            </div>
            <div>
              <h3>2. Kontak & Jam Pelayanan</h3>
              <p class="card-desc">Nomor telepon kantor, WhatsApp Panitia PPDB, email, dan jam operasional.</p>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="input-phone">Telepon Kantor / Tata Usaha <span class="req">*</span></label>
              <input
                type="tel"
                id="input-phone"
                name="phone"
                value={school.phone}
                required
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-email">Email Resmi Sekolah <span class="req">*</span></label>
              <input
                type="email"
                id="input-email"
                name="email"
                value={school.email}
                required
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-whatsapp">Nomor WhatsApp Tampilan <span class="req">*</span></label>
              <input
                type="text"
                id="input-whatsapp"
                name="whatsapp"
                value={school.whatsapp}
                placeholder="0823-0000-0000"
                required
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-whatsapp-raw">WhatsApp Raw (Format 62xxx) <span class="req">*</span></label>
              <input
                type="text"
                id="input-whatsapp-raw"
                name="whatsappRaw"
                value={school.whatsappRaw}
                placeholder="6282300000000"
                required
                class="form-control"
              />
              <span class="form-help">Digunakan untuk tautan langsung https://wa.me/62...</span>
            </div>

            <div class="form-group col-span-2">
              <label for="input-whatsapp-msg">Pesan Otomatis WhatsApp (Default Template)</label>
              <textarea
                id="input-whatsapp-msg"
                name="whatsappMessage"
                rows="2"
                class="form-control"
              >{school.whatsappMessage}</textarea>
              <span class="form-help">Pesan pembuka otomatis saat calon wali murid menekan tombol WhatsApp.</span>
            </div>

            <div class="form-group col-span-2">
              <label for="input-office-hours">Jam Layanan Kantor <span class="req">*</span></label>
              <input
                type="text"
                id="input-office-hours"
                name="officeHours"
                value={school.officeHours}
                required
                class="form-control"
              />
            </div>
          </div>
        </div>
          </div>
        </div>

        <!-- Card 3: Alamat & Lokasi Google Maps -->
        <div class="form-card card" id="sec-lokasi">
          <div class="card-header">
            <div class="header-icon-wrap">
              <Icon name="map-pin" size={20} />
            </div>
            <div>
              <h3>3. Alamat Sekolah & Google Maps</h3>
              <p class="card-desc">Lokasi fisik sekolah dan koordinat peta navigasi.</p>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group col-span-2">
              <label for="input-address">Alamat Lengkap Sekolah <span class="req">*</span></label>
              <textarea
                id="input-address"
                name="address"
                rows="2"
                required
                class="form-control"
              >{school.address}</textarea>
            </div>

            <div class="form-group col-span-2">
              <label for="input-maps-url">Tautan Google Maps Resmi</label>
              <div class="input-with-button">
                <input
                  type="url"
                  id="input-maps-url"
                  name="mapsUrl"
                  value={school.mapsUrl}
                  class="form-control"
                />
                <a
                  href={school.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  id="btn-test-maps"
                  class="btn btn-secondary btn-sm"
                  title="Buka Peta"
                >
                  <Icon name="external-link" size={14} />
                  <span>Uji Buka</span>
                </a>
              </div>
            </div>

            <div class="form-group">
              <label for="input-lat">Koordinat Latitude (Garis Lintang)</label>
              <input
                type="number"
                step="any"
                id="input-lat"
                name="lat"
                value={school.coordinates.lat}
                class="form-control"
              />
            </div>

            <div class="form-group">
              <label for="input-lng">Koordinat Longitude (Garis Bujur)</label>
              <input
                type="number"
                step="any"
                id="input-lng"
                name="lng"
                value={school.coordinates.lng}
                class="form-control"
              />
            </div>
          </div>
        </div>
          </div>
        </div>

        <!-- Card 4: Media Sosial Resmi -->
        <div class="form-card card" id="sec-sosial">
          <div class="card-header">
            <div class="header-icon-wrap">
              <Icon name="share-2" size={20} />
            </div>
            <div>
              <h3>4. Akun Media Sosial Resmi</h3>
              <p class="card-desc">Tautan kanal komunikasi dan publikasi Sekolah kepada masyarakat.</p>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group col-span-2">
              <label for="input-ig-url">Instagram URL</label>
              <div class="input-with-button">
                <input
                  type="url"
                  id="input-ig-url"
                  name="instagramUrl"
                  value={school.socials.instagramUrl}
                  class="form-control"
                />
                <a
                  href={school.socials.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  id="btn-test-ig"
                  class="btn btn-secondary btn-sm"
                >
                  <Icon name="instagram" size={14} />
                  <span>Kunjungi</span>
                </a>
              </div>
            </div>

            <div class="form-group col-span-2">
              <label for="input-yt-url">YouTube Channel URL</label>
              <div class="input-with-button">
                <input
                  type="url"
                  id="input-yt-url"
                  name="youtubeUrl"
                  value={school.socials.youtubeUrl}
                  class="form-control"
                />
                <a
                  href={school.socials.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  id="btn-test-yt"
                  class="btn btn-secondary btn-sm"
                >
                  <Icon name="youtube" size={14} />
                  <span>Kunjungi</span>
                </a>
              </div>
            </div>

            <div class="form-group col-span-2">
              <label for="input-fb-url">Facebook Page URL</label>
              <div class="input-with-button">
                <input
                  type="url"
                  id="input-fb-url"
                  name="facebookUrl"
                  value={school.socials.facebookUrl}
                  class="form-control"
                />
                <a
                  href={school.socials.facebookUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  id="btn-test-fb"
                  class="btn btn-secondary btn-sm"
                >
                  <Icon name="facebook" size={14} />
                  <span>Kunjungi</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 5: Tema & Warna Tampilan Website -->
        <div class="form-card card" id="sec-theme-color">
          <div class="card-header">
            <div class="header-icon-wrap" style="background: var(--green-700); color: #fff;">
              <Icon name="palette" size={20} />
            </div>
            <div>
              <h3>5. Tema & Warna Tampilan Website</h3>
              <p class="card-desc">Ubah warna aksen utama website (hijau, biru, ungu, oranye, dll). Perubahan langsung diterapkan ke seluruh halaman publik dan admin.</p>
            </div>
          </div>

          <div class="theme-customizer-body">
            <!-- Preset Swatches -->
            <div class="theme-presets-section">
              <label class="theme-sublabel">Pilihan Preset Warna Siap Pakai:</label>
              <div class="preset-chips-grid">
                <button type="button" class="preset-chip active" data-preset="emerald" data-color="#1B7A2F">
                  <span class="preset-color-dot" style="background: #1B7A2F;"></span>
                  <span class="preset-name">Emerald Tech (Hijau)</span>
                </button>
                <button type="button" class="preset-chip" data-preset="blue" data-color="#2563EB">
                  <span class="preset-color-dot" style="background: #2563EB;"></span>
                  <span class="preset-name">Cyber Electric Blue</span>
                </button>
                <button type="button" class="preset-chip" data-preset="purple" data-color="#7C3AED">
                  <span class="preset-color-dot" style="background: #7C3AED;"></span>
                  <span class="preset-name">Futuristic Purple</span>
                </button>
                <button type="button" class="preset-chip" data-preset="amber" data-color="#EA580C">
                  <span class="preset-color-dot" style="background: #EA580C;"></span>
                  <span class="preset-name">Cyberpunk Orange</span>
                </button>
                <button type="button" class="preset-chip" data-preset="teal" data-color="#0D9488">
                  <span class="preset-color-dot" style="background: #0D9488;"></span>
                  <span class="preset-name">Teal Matrix Cyan</span>
                </button>
                <button type="button" class="preset-chip" data-preset="slate" data-color="#334155">
                  <span class="preset-color-dot" style="background: #334155;"></span>
                  <span class="preset-name">Midnight Dark Slate</span>
                </button>
                <button type="button" class="preset-chip" data-preset="crimson" data-color="#DC2626">
                  <span class="preset-color-dot" style="background: #DC2626;"></span>
                  <span class="preset-name">Crimson Red</span>
                </button>
              </div>
            </div>

            <!-- Custom Color Picker -->
            <div class="custom-color-section">
              <label class="theme-sublabel">Atau Pilih Warna Kustom Sendiri:</label>
              <div class="custom-color-controls">
                <div class="color-picker-wrap">
                  <input type="color" id="input-theme-color" value="#1B7A2F" class="color-picker-input" />
                  <span class="color-picker-label">Palet Warna</span>
                </div>
                <div class="hex-input-wrap">
                  <span class="hex-prefix">#</span>
                  <input type="text" id="input-theme-hex" value="1B7A2F" maxlength="7" class="hex-input" />
                </div>
                <button type="button" id="btn-reset-color" class="btn btn-secondary btn-sm">
                  <Icon name="refresh-cw" size={14} />
                  <span>Reset Default</span>
                </button>
              </div>
            </div>

            <!-- Live Color Elements Preview -->
            <div class="theme-preview-box">
              <span class="theme-preview-title">Pratinjau Komponen dengan Warna Terpilih:</span>
              <div class="theme-preview-elements">
                <div class="preview-sample-btn" id="sample-btn" style="background: var(--green-700); color: #fff;">
                  Contoh Tombol Utama
                </div>
                <div class="preview-sample-chip" id="sample-chip" style="background: var(--green-50); color: var(--green-700); border: 1px solid var(--green-200);">
                  Contoh Chip / Badge
                </div>
                <div class="preview-sample-nav" id="sample-nav" style="background: var(--green-900); color: #fff;">
                  Header / Navbar
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Right Column: Live Preview & Logo Card -->
    <aside class="preview-sidebar">
      <!-- Logo Asset Box -->
      <div class="card logo-card">
        <div class="card-header-sm">
          <Icon name="image" size={18} />
          <h4>Logo Resmi Sekolah</h4>
        </div>
        <div class="logo-preview-stage">
          <img src="/assets/logo-freeks.webp" alt="Logo FREEKS.id School" width="90" height="82" class="preview-logo-img" id="admin-logo-preview" />
          <div class="logo-meta">
            <span class="file-badge" id="logo-badge-status">Logo Standar Aktif</span>
            <span class="file-path" id="logo-path-text">/assets/logo-freeks.webp</span>
          </div>
        </div>
        <div class="logo-upload-controls">
          <label for="logo-file-input" class="btn btn-primary btn-sm btn-upload-logo">
            <Icon name="upload" size={15} />
            <span>Unggah Logo Baru</span>
          </label>
          <input type="file" id="logo-file-input" accept="image/png, image/jpeg, image/webp, image/svg+xml" style="display: none;" />
          <button type="button" id="btn-reset-logo" class="btn btn-secondary btn-sm" title="Kembalikan logo default">
            <Icon name="rotate-ccw" size={14} />
            <span>Reset Default</span>
          </button>
        </div>
        <p class="logo-help-text">
          Dukungan format: <strong>PNG (transparan), WebP, SVG, JPG</strong>. Rekomendasi rasio 1:1. Logo baru akan langsung tampil seragam di seluruh website.
        </p>
      </div>

      <!-- Model 3D Asset Box -->
      <div class="card logo-card model-3d-card">
        <div class="card-header-sm">
          <Icon name="box" size={18} />
          <h4>Model 3D Logo (.GLB)</h4>
        </div>
        <div class="glb-preview-stage">
          <div class="glb-viewer-container">
            <model-viewer
              id="admin-glb-preview"
              src="/assets/3d/freeks.glb"
              poster="/assets/logo-freeks.webp"
              alt="Model 3D Logo Sekolah"
              camera-controls
              auto-rotate
              rotation-per-second="18deg"
              shadow-intensity="0.8"
              exposure="1.15"
              interaction-prompt="none"
              class="admin-model-viewer"
            ></model-viewer>
          </div>
          <div class="logo-meta">
            <span class="file-badge" id="glb-badge-status">Model 3D Standar Aktif</span>
            <span class="file-path" id="glb-path-text">/assets/3d/freeks.glb</span>
            <span class="file-size-info" id="glb-size-text">Ukuran: ~414 KB</span>
          </div>
        </div>
        <div class="logo-upload-controls">
          <label for="glb-file-input" class="btn btn-primary btn-sm btn-upload-logo">
            <Icon name="upload" size={15} />
            <span>Unggah File .GLB</span>
          </label>
          <input type="file" id="glb-file-input" accept=".glb, model/gltf-binary" style="display: none;" />
          <button type="button" id="btn-reset-glb" class="btn btn-secondary btn-sm" title="Kembalikan model 3D default">
            <Icon name="rotate-ccw" size={14} />
            <span>Reset Default</span>
          </button>
        </div>
        <p class="logo-help-text">
          Dukungan format: <strong>.GLB (Binary glTF 3D)</strong>. Model 3D baru akan disimpan dan otomatis tampil berputar interaktif di halaman Beranda website.
        </p>
      </div>

      <!-- Live Preview Simulator -->
      <div class="card preview-card">
        <div class="card-header-sm">
          <Icon name="eye" size={18} />
          <h4>Pratinjau Langsung (Live Preview)</h4>
        </div>
        <p class="preview-hint">Perubahan data akan langsung ter-render di pratinjau berikut:</p>

        <!-- Simulated Header Component -->
        <div class="sim-box">
          <div class="sim-label">Simulasi Header & Brand</div>
          <div class="sim-header">
            <img src="/assets/logo-freeks.webp" width="36" height="32" alt="Logo" style="object-fit: contain;" />
            <div>
              <div id="sim-brand-title" class="sim-title">{school.name}</div>
              <div id="sim-brand-sub" class="sim-sub">{school.foundation}</div>
            </div>
          </div>
        </div>

        <!-- Simulated Footer Component -->
        <div class="sim-box">
          <div class="sim-label">Simulasi Footer Kontak</div>
          <div class="sim-footer">
            <div class="sim-contact-row">
              <Icon name="map-pin" size={14} />
              <span id="sim-footer-addr">{school.address}</span>
            </div>
            <div class="sim-contact-row">
              <Icon name="phone" size={14} />
              <span id="sim-footer-phone">{school.phone}</span>
            </div>
            <div class="sim-contact-row">
              <Icon name="whatsapp" size={14} />
              <span id="sim-footer-wa">{school.whatsapp}</span>
            </div>
            <div class="sim-contact-row">
              <Icon name="mail" size={14} />
              <span id="sim-footer-email">{school.email}</span>
            </div>
          </div>
        </div>
          </div>
        </div>

        <div class="action-footer">
          <button type="button" id="btn-save-settings-2" class="btn btn-primary btn-block">
            <Icon name="check" size={18} />
            <span>Simpan Pengaturan</span>
          </button>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>

<style>
  .page-header-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--admin-ink-300);
  }

  @media (min-width: 768px) {
    .page-header-wrap {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .module-tag {
    font-size: 11px;
    font-weight: 800;
    color: var(--admin-green-700);
    letter-spacing: 0.8px;
    margin-bottom: 6px;
  }

  .page-header-wrap h1 {
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-size: 0.9rem;
    color: var(--admin-ink-500);
    max-width: 75ch;
  }

  .header-action-group {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background-color: var(--admin-green-700);
    color: #FFFFFF;
    border: none;
  }

  .btn-primary:hover {
    background-color: var(--admin-green-800);
    box-shadow: 0 4px 12px rgba(27, 122, 47, 0.25);
  }

  .btn-secondary {
    background-color: #FFFFFF;
    color: var(--admin-ink-900);
    border: 1px solid var(--admin-ink-300);
  }

  .btn-secondary:hover {
    background-color: var(--admin-ink-100);
  }

  .btn-sm {
    padding: 7px 12px;
    font-size: 12px;
  }

  .btn-block {
    width: 100%;
    justify-content: center;
  }

  /* Cards */
  .card {
    background-color: #FFFFFF;
    border: 1px solid var(--admin-ink-300);
    border-radius: 12px;
    padding: 24px;
