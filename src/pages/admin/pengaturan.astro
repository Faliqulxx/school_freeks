  // ==========================================
  // THEME COLOR CUSTOMIZER SCRIPT
  // ==========================================
  const THEME_PRESETS: Record<string, any> = {
    emerald: {
      preset: 'emerald',
      primary: '#1B7A2F',
      primaryDark: '#0B3B16',
      primaryMid: '#0F4D1C',
      primaryLight: '#3DA352',
      primaryBorder: '#CDE8B5',
      primarySoft: '#F1F8EA'
    },
    blue: {
      preset: 'blue',
      primary: '#2563EB',
      primaryDark: '#0F172A',
      primaryMid: '#1E40AF',
      primaryLight: '#60A5FA',
      primaryBorder: '#BFDBFE',
      primarySoft: '#EFF6FF'
    },
    purple: {
      preset: 'purple',
      primary: '#7C3AED',
      primaryDark: '#1E1B4B',
      primaryMid: '#5B21B6',
      primaryLight: '#A78BFA',
      primaryBorder: '#DDD6FE',
      primarySoft: '#F5F3FF'
    },
    amber: {
      preset: 'amber',
      primary: '#EA580C',
      primaryDark: '#431407',
      primaryMid: '#9A3412',
      primaryLight: '#FB923C',
      primaryBorder: '#FED7AA',
      primarySoft: '#FFF7ED'
    },
    teal: {
      preset: 'teal',
      primary: '#0D9488',
      primaryDark: '#042F2E',
      primaryMid: '#115E59',
      primaryLight: '#2DD4BF',
      primaryBorder: '#99F6E4',
      primarySoft: '#F0FDFA'
    },
    slate: {
      preset: 'slate',
      primary: '#334155',
      primaryDark: '#0F172A',
      primaryMid: '#1E293B',
      primaryLight: '#64748B',
      primaryBorder: '#CBD5E1',
      primarySoft: '#F8FAFC'
    },
    crimson: {
      preset: 'crimson',
      primary: '#DC2626',
      primaryDark: '#450A0A',
      primaryMid: '#991B1B',
      primaryLight: '#F87171',
      primaryBorder: '#FECACA',
      primarySoft: '#FEF2F2'
    }
  };

  function hexToHsl(hex: string): [number, number, number] {
    hex = hex.replace(/^#/, '');
    if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
    const num = parseInt(hex, 16);
    const r = (num >> 16) / 255;
    const g = ((num >> 8) & 255) / 255;
    const b = (num & 255) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0;
    const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }

  function hslToHex(h: number, s: number, l: number): string {
    s /= 100;
    l /= 100;
    const k = (n: number) => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    const toHex = (x: number) => {
      const hex = Math.round(x * 255).toString(16);
      return hex.length === 1 ? '0' + hex : hex;
    };
    return `#${toHex(f(0))}${toHex(f(8))}${toHex(f(4))}`;
  }

  function buildPaletteFromHex(baseHex: string, presetName: string = 'custom') {
    const [h, s, l] = hexToHsl(baseHex);
    return {
      preset: presetName,
      primary: baseHex,
      primaryDark: hslToHex(h, Math.min(s + 15, 100), Math.max(10, l - 30)),
      primaryMid: hslToHex(h, s, Math.max(18, l - 15)),
      primaryLight: hslToHex(h, s, Math.min(68, l + 16)),
      primaryBorder: hslToHex(h, Math.min(s, 55), 85),
      primarySoft: hslToHex(h, Math.min(s, 45), 96)
    };
  }

  let currentTheme = THEME_PRESETS.emerald;

  const colorPicker = document.getElementById('input-theme-color') as HTMLInputElement | null;
  const hexInput = document.getElementById('input-theme-hex') as HTMLInputElement | null;
  const resetBtn = document.getElementById('btn-reset-color');
  const presetChips = document.querySelectorAll('.preset-chip');
  const sampleBtn = document.getElementById('sample-btn');
  const sampleChip = document.getElementById('sample-chip');
  const sampleNav = document.getElementById('sample-nav');

  function applyThemeToPage(theme: any) {
    if (!theme || !theme.primary) return;
    const root = document.documentElement;
    root.style.setProperty('--green-700', theme.primary);
    root.style.setProperty('--green-900', theme.primaryDark || theme.primary);
    root.style.setProperty('--green-800', theme.primaryMid || theme.primary);
    root.style.setProperty('--green-500', theme.primaryLight || theme.primary);
    root.style.setProperty('--green-200', theme.primaryBorder || '#CBD2D9');
    root.style.setProperty('--green-50', theme.primarySoft || '#F8FAFC');

    root.style.setProperty('--admin-green-700', theme.primary);
    root.style.setProperty('--admin-green-900', theme.primaryDark || theme.primary);
    root.style.setProperty('--admin-green-800', theme.primaryMid || theme.primary);
    root.style.setProperty('--admin-green-500', theme.primaryLight || theme.primary);

    if (sampleBtn) {
      sampleBtn.style.backgroundColor = theme.primary;
    }
    if (sampleChip) {
      sampleChip.style.backgroundColor = theme.primarySoft;
      sampleChip.style.color = theme.primary;
      sampleChip.style.borderColor = theme.primaryBorder;
    }
    if (sampleNav) {
      sampleNav.style.backgroundColor = theme.primaryDark;
    }
  }

  function syncThemeControls(theme: any) {
    currentTheme = theme;
    applyThemeToPage(theme);

    if (colorPicker) colorPicker.value = theme.primary;
    if (hexInput) hexInput.value = theme.primary.replace(/^#/, '').toUpperCase();

    presetChips.forEach(chip => {
      const chipPreset = chip.getAttribute('data-preset');
      if (chipPreset === theme.preset) {
        chip.classList.add('active');
      } else {
        chip.classList.remove('active');
      }
    });
  }

  // Load initial theme from localStorage if exists
  try {
    const savedTheme = localStorage.getItem('freeks_theme');
    if (savedTheme) {
      syncThemeControls(JSON.parse(savedTheme));
    }
  } catch (e) {}

  // Preset chips event
  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const presetKey = chip.getAttribute('data-preset');
      if (presetKey && THEME_PRESETS[presetKey]) {
        syncThemeControls(THEME_PRESETS[presetKey]);
      }
    });
  });

  // Color picker event
  colorPicker?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    const palette = buildPaletteFromHex(val, 'custom');
    syncThemeControls(palette);
  });

  // Hex input event
  hexInput?.addEventListener('input', (e) => {
    let val = (e.target as HTMLInputElement).value.trim();
    if (!val.startsWith('#')) val = '#' + val;
    if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
      const palette = buildPaletteFromHex(val, 'custom');
      syncThemeControls(palette);
    }
  });

  // Reset button event
  resetBtn?.addEventListener('click', () => {
    syncThemeControls(THEME_PRESETS.emerald);
  });

  // --- LOGO UPLOAD & MANAGEMENT ---
  const logoFileInput = document.getElementById('logo-file-input') as HTMLInputElement | null;
  const adminLogoPreview = document.getElementById('admin-logo-preview') as HTMLImageElement | null;
  const logoBadgeStatus = document.getElementById('logo-badge-status');
  const logoPathText = document.getElementById('logo-path-text');
  const btnResetLogo = document.getElementById('btn-reset-logo');

  function updatePageLogos(src: string, isCustom: boolean, fileName?: string) {
    if (adminLogoPreview) adminLogoPreview.src = src;

    const pageLogos = document.querySelectorAll('.school-logo-img, .sim-header img, .brand-logo, .preview-logo-img') as NodeListOf<HTMLImageElement>;
    pageLogos.forEach(img => {
      if (img) img.src = src;
    });

    const favicons = document.querySelectorAll("link[rel*='icon']") as NodeListOf<HTMLLinkElement>;
    favicons.forEach(fav => {
      if (fav) fav.href = src;
    });

    if (logoBadgeStatus) {
      if (isCustom) {
        logoBadgeStatus.textContent = 'Logo Kustom Aktif';
        logoBadgeStatus.style.background = '#059669';
        logoBadgeStatus.style.color = '#ffffff';
      } else {
        logoBadgeStatus.textContent = 'Logo Standar Aktif';
        logoBadgeStatus.style.background = '';
        logoBadgeStatus.style.color = '';
      }
    }

    if (logoPathText) {
      if (isCustom) {
        logoPathText.textContent = fileName || 'Tersimpan di Browser (DataURL)';
      } else {
        logoPathText.textContent = '/assets/logo-freeks.webp';
      }
    }
  }

  // Load initial custom logo from localStorage if exists
  try {
    const savedLogo = localStorage.getItem('freeks_custom_logo');
    if (savedLogo) {
      const savedLogoName = localStorage.getItem('freeks_custom_logo_name') || 'Logo Kustom Sekolah';
      updatePageLogos(savedLogo, true, savedLogoName);
    }
  } catch (e) {}

  // File upload handler
  logoFileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];
    if (!file) return;

    if (file.size > 3 * 1024 * 1024) {
      alert('Ukuran file logo terlalu besar. Harap gunakan file gambar maksimal 3MB.');
      target.value = '';
      return;
    }

    const reader = new FileReader();
    reader.onload = (event) => {
      const dataUrl = event.target?.result as string;
      if (dataUrl) {
        try {
          localStorage.setItem('freeks_custom_logo', dataUrl);
          localStorage.setItem('freeks_custom_logo_name', file.name);
          updatePageLogos(dataUrl, true, file.name);

          if (toast) {
            toast.hidden = false;
            const toastP = toast.querySelector('p');
            if (toastP) toastP.textContent = 'Logo resmi sekolah berhasil diunggah dan langsung aktif di seluruh website!';
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        } catch (err) {
          alert('Penyimpanan browser penuh. Harap kompres gambar atau gunakan resolusi lebih kecil.');
        }
      }
    };
    reader.readAsDataURL(file);
  });

  // Reset logo handler
  btnResetLogo?.addEventListener('click', () => {
    const msg = 'Apakah Anda yakin ingin mengembalikan logo sekolah ke logo standar (default)?';
    const doReset = () => {
      try {
        localStorage.removeItem('freeks_custom_logo');
        localStorage.removeItem('freeks_custom_logo_name');
        if (logoFileInput) logoFileInput.value = '';
        updatePageLogos('/assets/logo-freeks.webp', false);

        if (toast) {
          toast.hidden = false;
          const toastP = toast.querySelector('p');
          if (toastP) toastP.textContent = 'Logo sekolah telah dikembalikan ke logo standar.';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } catch (e) {}
    };

    if (typeof window.confirmDelete === 'function') {
      window.confirmDelete(msg, doReset, 'Konfirmasi Reset Logo');
    } else if (confirm(msg)) {
      doReset();
    }
  });

  // ==========================================
  // 3D MODEL (.GLB) IndexedDB Management
  // ==========================================
  const glbFileInput = document.getElementById('glb-file-input') as HTMLInputElement | null;
  const btnResetGlb = document.getElementById('btn-reset-glb');
  const adminGlbPreview = document.getElementById('admin-glb-preview') as any;
  const glbBadgeStatus = document.getElementById('glb-badge-status');
  const glbPathText = document.getElementById('glb-path-text');
  const glbSizeText = document.getElementById('glb-size-text');

  function open3DDB(): Promise<IDBDatabase> {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open('freeks_3d_db', 1);
      req.onupgradeneeded = (e: any) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains('models')) {
          db.createObjectStore('models', { keyPath: 'id' });
        }
      };
      req.onsuccess = (e: any) => resolve(e.target.result);
      req.onerror = (e: any) => reject(e.target.error);
    });
  }

  async function loadInitial3DModel() {
    try {
      const db = await open3DDB();
      const tx = db.transaction('models', 'readonly');
      const store = tx.objectStore('models');
      const req = store.get('active_glb');
      req.onsuccess = () => {
        if (req.result && req.result.data) {
          const blobUrl = URL.createObjectURL(req.result.data);
          if (adminGlbPreview) adminGlbPreview.src = blobUrl;
          if (glbBadgeStatus) {
            glbBadgeStatus.textContent = 'Model Kustom Aktif';
            glbBadgeStatus.style.backgroundColor = '#D97706';
          }
          if (glbPathText) glbPathText.textContent = req.result.filename || 'model_kustom.glb';
          if (glbSizeText) glbSizeText.textContent = 'Ukuran: ' + (req.result.size ? (req.result.size / 1024).toFixed(1) + ' KB' : 'Tersimpan');
        }
      };
    } catch (e) {}
  }

  loadInitial3DModel();

  glbFileInput?.addEventListener('change', async (e) => {
    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];
    if (!file) return;

    if (!file.name.toLowerCase().endsWith('.glb')) {
      alert('Mohon unggah file 3D dengan format .glb');
      target.value = '';
      return;
    }

    if (file.size > 20 * 1024 * 1024) {
      alert('Ukuran file .glb maksimal 20 MB.');
      target.value = '';
      return;
    }

    try {
      const db = await open3DDB();
      const tx = db.transaction('models', 'readwrite');
      const store = tx.objectStore('models');
      store.put({
        id: 'active_glb',
        data: file,
        filename: file.name,
        size: file.size,
        updatedAt: Date.now()
      });

      tx.oncomplete = () => {
        const blobUrl = URL.createObjectURL(file);
        if (adminGlbPreview) adminGlbPreview.src = blobUrl;
        if (glbBadgeStatus) {
          glbBadgeStatus.textContent = 'Model Kustom Aktif';
          glbBadgeStatus.style.backgroundColor = '#D97706';
        }
        if (glbPathText) glbPathText.textContent = file.name;
        if (glbSizeText) glbSizeText.textContent = 'Ukuran: ' + (file.size / 1024).toFixed(1) + ' KB';

        if (toast) {
          toast.hidden = false;
          const toastP = toast.querySelector('p');
          if (toastP) toastP.textContent = 'Model 3D (.GLB) berhasil diperbarui dan langsung aktif di halaman Beranda!';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      };
    } catch (err: any) {
      alert('Gagal menyimpan file 3D ke penyimpanan browser: ' + (err?.message || err));
    }
  });

  btnResetGlb?.addEventListener('click', async () => {
    const resetMsg = 'Apakah Anda yakin ingin mengembalikan model 3D ke model standar bawaan sekolah (/assets/3d/freeks.glb)?';
    const doResetGlb = async () => {
      try {
        const db = await open3DDB();
        const tx = db.transaction('models', 'readwrite');
        const store = tx.objectStore('models');
        store.delete('active_glb');

        tx.oncomplete = () => {
          if (glbFileInput) glbFileInput.value = '';
          if (adminGlbPreview) adminGlbPreview.src = '/assets/3d/freeks.glb';
          if (glbBadgeStatus) {
            glbBadgeStatus.textContent = 'Model 3D Standar Aktif';
            glbBadgeStatus.style.backgroundColor = 'var(--admin-green-700)';
          }
          if (glbPathText) glbPathText.textContent = '/assets/3d/freeks.glb';
          if (glbSizeText) glbSizeText.textContent = 'Ukuran: ~414 KB';

          if (toast) {
            toast.hidden = false;
            const toastP = toast.querySelector('p');
            if (toastP) toastP.textContent = 'Model 3D berhasil dikembalikan ke standar bawaan sekolah.';
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        };
      } catch (err: any) {
        alert('Gagal mereset model 3D: ' + (err?.message || err));
      }
    };

    if (typeof window.confirmDelete === 'function') {
      window.confirmDelete(resetMsg, doResetGlb, 'Konfirmasi Reset Model 3D');
    } else if (confirm(resetMsg)) {
      doResetGlb();
    }
  });

  // Construct current data object from inputs
  function getFormData() {
    const formData = new FormData(form);
    return {
      dummy: false,
      school: {
        name: (formData.get('name') as string) || '',
        shortName: (formData.get('shortName') as string) || '',
        foundation: (formData.get('foundation') as string) || '',
        slogan: (formData.get('slogan') as string) || '',
        npsn: (formData.get('npsn') as string) || '',
        accreditation: (formData.get('accreditation') as string) || 'B',
        address: (formData.get('address') as string) || '',
        mapsUrl: (formData.get('mapsUrl') as string) || '',
        coordinates: {
          lat: parseFloat(formData.get('lat') as string) || -6.913685,
          lng: parseFloat(formData.get('lng') as string) || 112.5527886
        },
        phone: (formData.get('phone') as string) || '',
        whatsapp: (formData.get('whatsapp') as string) || '',
        whatsappRaw: (formData.get('whatsappRaw') as string) || '',
        whatsappMessage: (formData.get('whatsappMessage') as string) || '',
        email: (formData.get('email') as string) || '',
        officeHours: (formData.get('officeHours') as string) || '',
        socials: {
          instagram: '@freeks.id',
          instagramUrl: (formData.get('instagramUrl') as string) || '',
          youtube: 'FREEKS.id School',
          youtubeUrl: (formData.get('youtubeUrl') as string) || '',
          facebook: 'FREEKS.id School',
          facebookUrl: (formData.get('facebookUrl') as string) || ''
        }
      },
      theme: currentTheme
    };
  }

  // Handle Save
  function handleSave() {
    const data = getFormData();
    try {
      localStorage.setItem('freeks_theme', JSON.stringify(currentTheme));
      localStorage.setItem('mts_siteData', JSON.stringify(data));
      if (toast) {
        toast.hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    } catch (e) {
      alert('Pengaturan disimpan ke memori!');
    }
  }

  saveBtn?.addEventListener('click', handleSave);
  saveBtn2?.addEventListener('click', handleSave);

  toastClose?.addEventListener('click', () => {
    if (toast) toast.hidden = true;
  });

  // Export updated siteData.json file
  exportBtn?.addEventListener('click', () => {
    const data = getFormData();
    const jsonStr = JSON.stringify(data, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'siteData.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>

