    color: #FFFFFF;
  }

  .btn-primary:hover {
    background-color: var(--admin-green-800);
  }

  .btn-secondary {
    background-color: #FFFFFF;
    color: var(--admin-ink-700);
    border-color: var(--admin-ink-300);
  }

  .btn-secondary:hover {
    background-color: var(--admin-ink-100);
    color: var(--admin-ink-900);
  }

  .flex-align-center {
    display: flex;
    align-items: center;
  }

  .gap-2 {
    gap: 8px;
  }
</style>

<script is:inline>
  function initBeranda() {
    // State management for Testimonials
    let testimonialsState = [
      {
        id: "testi-1",
        name: "Ibu Sri Wahyuni",
        role: "Wali Murid Grade 8",
        initials: "SW",
        quote: "Anak saya yang awalnya pemalu kini sangat percaya diri melakukan pitching presentasi dan antusias merakit proyek coding di rumah. Perkembangan karakter dan logikanya luar biasa di FREEKS.id School."
      },
      {
        id: "testi-2",
        name: "Bapak Hendra Pratama",
        role: "Wali Murid Grade 7",
        initials: "HP",
        quote: "Kurikulum berbasis proyeknya benar-benar terasa relevan dengan era sekarang. Siswa tidak stres menghafal rumus semata, tetapi paham cara menerapkannya dalam inovasi teknologi nyata."
      },
      {
        id: "testi-3",
        name: "Rafi Pratama",
        role: "Alumni Angkatan 2024",
        initials: "RP",
        quote: "Pengalaman di Maker Space FREEKS.id School dan bimbingan mentor 3D design membuat portofolio saya diakui saat kompetisi teknologi. Fondasi computational thinking di sini sangat bernilai."
      }
    ];

    // Load from localStorage if present
    const savedBeranda = localStorage.getItem('mts_cms_beranda_data');
    if (savedBeranda) {
      try {
        const parsed = JSON.parse(savedBeranda);
        if (parsed.testimonials && parsed.testimonials.length > 0) {
          const hasOldText = parsed.testimonials.some(t => t.quote && (t.quote.includes('MTs Islamiyah') || t.quote.includes('shalat')));
          if (!hasOldText) {
            testimonialsState = parsed.testimonials;
          }
        }
        if (parsed.hero) {
          if (parsed.hero.title && parsed.hero.title.includes('MTs Islamiyah')) {
            parsed.hero.title = 'FREEKS.id School';
            parsed.hero.subtitle = 'Membentuk Generasi Inovator & Digital Leader Berakhlak Mulia';
          }
          if (document.getElementById('input-hero-title')) document.getElementById('input-hero-title').value = parsed.hero.title || '';
          if (document.getElementById('input-hero-subtitle')) document.getElementById('input-hero-subtitle').value = parsed.hero.subtitle || '';
          if (document.getElementById('input-hero-cta-text')) document.getElementById('input-hero-cta-text').value = parsed.hero.ctaText || '';
          if (document.getElementById('input-hero-cta-url')) document.getElementById('input-hero-cta-url').value = parsed.hero.ctaUrl || '';
          if (document.getElementById('input-hero-sec-text')) document.getElementById('input-hero-sec-text').value = parsed.hero.secondaryText || '';
          if (document.getElementById('input-hero-sec-url')) document.getElementById('input-hero-sec-url').value = parsed.hero.secondaryUrl || '';
        }
        if (parsed.sambutan) {
          if (document.getElementById('input-sambutan-name')) document.getElementById('input-sambutan-name').value = parsed.sambutan.name || '';
          if (document.getElementById('input-sambutan-role')) document.getElementById('input-sambutan-role').value = parsed.sambutan.role || '';
          if (document.getElementById('input-sambutan-arabic')) document.getElementById('input-sambutan-arabic').value = parsed.sambutan.arabicGreeting || '';
          if (document.getElementById('input-sambutan-quote')) document.getElementById('input-sambutan-quote').value = parsed.sambutan.shortQuote || '';
        }
        if (parsed.ppdb) {
          if (document.getElementById('input-ppdb-status')) document.getElementById('input-ppdb-status').value = parsed.ppdb.status || '';
          if (document.getElementById('input-ppdb-wave-dates')) document.getElementById('input-ppdb-wave-dates').value = parsed.ppdb.waveDates || '';
          if (document.getElementById('input-ppdb-quota')) document.getElementById('input-ppdb-quota').value = parsed.ppdb.quota || '';
        }
      } catch (e) {
        console.error('Failed to parse saved beranda data:', e);
      }
    }

    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab');
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Preview mode pills
    const previewPills = document.querySelectorAll('#preview-tab-pills .pill-btn');
    const simViews = {
      hero: document.getElementById('sim-view-hero'),
      sambutan: document.getElementById('sim-view-sambutan'),
      stats: document.getElementById('sim-view-stats')
    };

    previewPills.forEach(pill => {
      pill.addEventListener('click', () => {
        previewPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const mode = pill.getAttribute('data-preview-mode');
        Object.keys(simViews).forEach(k => {
          if (simViews[k]) simViews[k].style.display = (k === mode) ? 'block' : 'none';
        });
      });
    });

    // Real-time synchronization
    function syncLivePreview() {
      // Hero
      const titleInput = document.getElementById('input-hero-title');
      const subtitleInput = document.getElementById('input-hero-subtitle');
      const ctaTextInput = document.getElementById('input-hero-cta-text');
      const secTextInput = document.getElementById('input-hero-sec-text');

      if (titleInput && document.getElementById('sim-hero-title')) {
        document.getElementById('sim-hero-title').textContent = titleInput.value;
      }
      if (subtitleInput && document.getElementById('sim-hero-subtitle')) {
        document.getElementById('sim-hero-subtitle').textContent = subtitleInput.value;
      }
      if (ctaTextInput && document.getElementById('sim-hero-cta')) {
        document.getElementById('sim-hero-cta').textContent = ctaTextInput.value + ' →';
      }
      if (secTextInput && document.getElementById('sim-hero-sec')) {
        document.getElementById('sim-hero-sec').textContent = secTextInput.value;
      }

      // PPDB Strip
      const statusInput = document.getElementById('input-ppdb-status');
      const waveInput = document.getElementById('input-ppdb-wave-dates');
      const quotaInput = document.getElementById('input-ppdb-quota');

      if (statusInput && document.getElementById('sim-ppdb-status')) {
        document.getElementById('sim-ppdb-status').textContent = statusInput.value;
      }
      if (waveInput && document.getElementById('sim-ppdb-dates')) {
        document.getElementById('sim-ppdb-dates').textContent = waveInput.value;
      }
      if (quotaInput && document.getElementById('sim-ppdb-quota')) {
        document.getElementById('sim-ppdb-quota').textContent = quotaInput.value;
      }

      // Sambutan
      const sambutanName = document.getElementById('input-sambutan-name');
      const sambutanRole = document.getElementById('input-sambutan-role');
      const sambutanArabic = document.getElementById('input-sambutan-arabic');
      const sambutanQuote = document.getElementById('input-sambutan-quote');

      if (sambutanName && document.getElementById('sim-sambutan-name')) {
        document.getElementById('sim-sambutan-name').textContent = sambutanName.value;
      }
      if (sambutanRole && document.getElementById('sim-sambutan-role')) {
        document.getElementById('sim-sambutan-role').textContent = sambutanRole.value;
      }
      if (sambutanArabic && document.getElementById('sim-sambutan-arabic')) {
        document.getElementById('sim-sambutan-arabic').textContent = sambutanArabic.value;
      }
      if (sambutanQuote && document.getElementById('sim-sambutan-quote')) {
        document.getElementById('sim-sambutan-quote').textContent = '"' + sambutanQuote.value + '"';
      }
      const sambutanPhoto = document.getElementById('input-sambutan-photo');
      const simSambutanImg = document.getElementById('sim-sambutan-img');
      if (sambutanPhoto && simSambutanImg) {
        simSambutanImg.src = sambutanPhoto.value;
      }
    }

    const formInputs = document.querySelectorAll('#beranda-form input, #beranda-form textarea');
    formInputs.forEach(input => {
      input.addEventListener('input', syncLivePreview);
    });

    // Testimonials CRUD Management
    const testiListEl = document.getElementById('testimonials-list');
    const modalEl = document.getElementById('modal-testimoni');
    const btnAddTesti = document.getElementById('btn-add-testimoni');
    const btnCancelTesti = document.getElementById('btn-cancel-testi');
    const btnSaveTestiItem = document.getElementById('btn-save-testi-item');

    let editingIndex = -1;

    function renderTestimonialsList() {
      if (!testiListEl) return;
      testiListEl.innerHTML = '';

      if (testimonialsState.length === 0) {
        testiListEl.innerHTML = `
          <div class="testi-empty-state">
            <p>Belum ada testimoni. Klik tombol <strong>+ Tambah Testimoni</strong> di atas untuk menambahkan testimoni baru.</p>
          </div>
        `;
        return;
      }

      testimonialsState.forEach((t, idx) => {
        const card = document.createElement('div');
        card.className = 'testi-admin-card';
        card.setAttribute('data-id', t.id);

        card.innerHTML = `
          <div class="testi-admin-header">
            <div class="avatar-badge">${t.initials || 'TS'}</div>
            <div class="testi-author-info">
              <div class="testi-name-row">
                <strong class="testi-name">${t.name}</strong>
                <span class="role-tag">${t.role}</span>
              </div>
              <div class="testi-rating-stars">★★★★★</div>
            </div>
            <div class="testi-item-actions">
              <button type="button" class="btn-action-edit btn-edit-testi" data-idx="${idx}" title="Edit Testimoni">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                <span>Edit</span>
              </button>
              <button type="button" class="btn-action-delete btn-delete-testi" data-idx="${idx}" title="Hapus Testimoni">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                <span>Hapus</span>
              </button>
            </div>
          </div>
          <div class="testi-quote-box">
            <div class="quote-mark-icon">“</div>
            <p class="testi-admin-quote">${t.quote}</p>
          </div>
        `;

        testiListEl.appendChild(card);
      });

      // Bind edit and delete handlers
      document.querySelectorAll('.btn-edit-testi').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(btn.getAttribute('data-idx'), 10);
          openEditModal(idx);
        });
      });

      document.querySelectorAll('.btn-delete-testi').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(btn.getAttribute('data-idx'), 10);
          const item = testimonialsState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus testimoni dari "${item.name}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              testimonialsState.splice(idx, 1);
              renderTestimonialsList();
            });
          } else if (confirm(msg)) {
            testimonialsState.splice(idx, 1);
            renderTestimonialsList();
          }
        });
      });

      // Update simulation single testimonial if present
      if (testimonialsState.length > 0) {
        const first = testimonialsState[0];
        if (document.getElementById('sim-testi-avatar')) document.getElementById('sim-testi-avatar').textContent = first.initials;
        if (document.getElementById('sim-testi-name')) document.getElementById('sim-testi-name').textContent = first.name;
        if (document.getElementById('sim-testi-role')) document.getElementById('sim-testi-role').textContent = first.role;
        if (document.getElementById('sim-testi-quote')) document.getElementById('sim-testi-quote').textContent = '"' + first.quote + '"';
      }
    }

    function openEditModal(idx) {
      editingIndex = idx;
      const t = testimonialsState[idx];
      document.getElementById('modal-testi-title').textContent = 'Edit Testimoni';
      document.getElementById('input-testi-id').value = t.id;
      document.getElementById('input-testi-name').value = t.name;
      document.getElementById('input-testi-role').value = t.role;
      document.getElementById('input-testi-initials').value = t.initials;
      document.getElementById('input-testi-quote').value = t.quote;
      modalEl.style.display = 'block';
      modalEl.scrollIntoView({ behavior: 'smooth' });
    }

    function openAddModal() {
      editingIndex = -1;
      document.getElementById('modal-testi-title').textContent = 'Tambah Testimoni Baru';
      document.getElementById('input-testi-id').value = 'testi-' + Date.now();
      document.getElementById('input-testi-name').value = '';
      document.getElementById('input-testi-role').value = '';
      document.getElementById('input-testi-initials').value = '';
      document.getElementById('input-testi-quote').value = '';
      modalEl.style.display = 'block';
      modalEl.scrollIntoView({ behavior: 'smooth' });
    }

    if (btnAddTesti) btnAddTesti.addEventListener('click', openAddModal);
    if (btnCancelTesti) btnCancelTesti.addEventListener('click', () => { modalEl.style.display = 'none'; });

    if (btnSaveTestiItem) {
      btnSaveTestiItem.addEventListener('click', () => {
        const name = document.getElementById('input-testi-name').value.trim();
        const role = document.getElementById('input-testi-role').value.trim();
        let initials = document.getElementById('input-testi-initials').value.trim().toUpperCase();
        const quote = document.getElementById('input-testi-quote').value.trim();
        const id = document.getElementById('input-testi-id').value || ('testi-' + Date.now());

        if (!name || !role || !quote) {
          alert('Mohon lengkapi Nama, Peran, dan Isi Testimoni!');
          return;
        }

        if (!initials) {
          initials = name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
        }

        const newObj = { id, name, role, initials, quote };

        if (editingIndex >= 0) {
          testimonialsState[editingIndex] = newObj;
        } else {
          testimonialsState.push(newObj);
        }

        modalEl.style.display = 'none';
        renderTestimonialsList();
      });
    }

    // Auto calculate initials when typing name
    const inputTestiName = document.getElementById('input-testi-name');
    if (inputTestiName) {
      inputTestiName.addEventListener('blur', () => {
        const initialsField = document.getElementById('input-testi-initials');
        if (initialsField && !initialsField.value.trim()) {
          const parts = inputTestiName.value.trim().split(' ');
          initialsField.value = parts.map(p => p[0]).slice(0, 2).join('').toUpperCase();
        }
      });
    }

    // Save Beranda Handler
    function handleSave() {
      // Gather stats
      const statItems = document.querySelectorAll('.stat-edit-item');
      const statsData = [];
      statItems.forEach(el => {
        const val = el.querySelector('.stat-input-value')?.value || '';
        const lbl = el.querySelector('.stat-input-label')?.value || '';
        const note = el.querySelector('.stat-input-note')?.value || '';
        statsData.push({ label: lbl, value: val, note: note });
      });

      const payload = {
        updatedAt: new Date().toISOString(),
        hero: {
          title: document.getElementById('input-hero-title')?.value || '',
          subtitle: document.getElementById('input-hero-subtitle')?.value || '',
          ctaText: document.getElementById('input-hero-cta-text')?.value || '',
          ctaUrl: document.getElementById('input-hero-cta-url')?.value || '',
          secondaryText: document.getElementById('input-hero-sec-text')?.value || '',
          secondaryUrl: document.getElementById('input-hero-sec-url')?.value || '',
          image: {
            src: document.getElementById('input-hero-bg-src')?.value || '/assets/gedung-mts-islamiyah.webp',
            alt: "Gedung FREEKS.id School"
          }
        },
        sambutan: {
          name: document.getElementById('input-sambutan-name')?.value || 'FREEKS.ID',
          role: document.getElementById('input-sambutan-role')?.value || 'Head of School / Principal',
          photo: {
            src: document.getElementById('input-sambutan-photo')?.value || '/assets/guru-freeks.webp',
            alt: `Foto ${document.getElementById('input-sambutan-name')?.value || 'FREEKS.ID'} - Head of School / Principal`
          },
          arabicGreeting: document.getElementById('input-sambutan-arabic')?.value || '',
          shortQuote: document.getElementById('input-sambutan-quote')?.value || ''
        },
        ppdb: {
          status: document.getElementById('input-ppdb-status')?.value || '',
          waveDates: document.getElementById('input-ppdb-wave-dates')?.value || '',
          quota: document.getElementById('input-ppdb-quota')?.value || '',
          reqs: document.getElementById('input-ppdb-reqs')?.value || '',
          banner: {
            chip: document.getElementById('input-banner-chip')?.value || '',
            title: document.getElementById('input-banner-title')?.value || '',
            desc: document.getElementById('input-banner-desc')?.value || ''
          }
        },
        stats: statsData,
        testimonials: testimonialsState
      };

      localStorage.setItem('mts_cms_beranda_data', JSON.stringify(payload));

      // Show toast
      const toast = document.getElementById('save-toast');
      if (toast) {
        toast.hidden = false;
        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    const btnSave1 = document.getElementById('btn-save-beranda');
    const btnSave2 = document.getElementById('btn-save-beranda-side');
    if (btnSave1) btnSave1.addEventListener('click', handleSave);
    if (btnSave2) btnSave2.addEventListener('click', handleSave);

    const toastClose = document.getElementById('toast-close');
    if (toastClose) {
      toastClose.addEventListener('click', () => {
        document.getElementById('save-toast').hidden = true;
      });
    }

    // Export JSON
    const btnExport = document.getElementById('btn-export-beranda-json');
    if (btnExport) {
      btnExport.addEventListener('click', () => {
        const saved = localStorage.getItem('mts_cms_beranda_data');
        let dataToExport;
        if (saved) {
          dataToExport = JSON.parse(saved);
        } else {
          dataToExport = {
            heroSambutan: {
              hero: {
                title: document.getElementById('input-hero-title')?.value,
                subtitle: document.getElementById('input-hero-subtitle')?.value
              },
              sambutan: {
                name: document.getElementById('input-sambutan-name')?.value,
                role: document.getElementById('input-sambutan-role')?.value
              }
            },
            testimonials: testimonialsState
          };
        }

        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(dataToExport, null, 2));
        const downloadAnchor = document.createElement('a');
        downloadAnchor.setAttribute('href', dataStr);
        downloadAnchor.setAttribute('download', `beranda-cms-${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
      });
    }

    // Initial render
    renderTestimonialsList();
    syncLivePreview();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBeranda);
  } else {
    initBeranda();
  }
</script>

