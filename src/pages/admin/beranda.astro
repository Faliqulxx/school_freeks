---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import heroSambutanData from '../../data/heroSambutan.json';
import angkaSekolahData from '../../data/angkaSekolah.json';
import testimoniData from '../../data/testimoni.json';
import ppdbData from '../../data/ppdb.json';
import siteData from '../../data/siteData.json';

const { hero, sambutan } = heroSambutanData;
const { stats } = angkaSekolahData;
const { testimonials } = testimoniData;
const { school } = siteData;
---

<AdminLayout title="Manajemen Beranda & Hero Section (Modul 2)" activeMenu="beranda">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 2 DARI 8</div>
      <h1>Manajemen Halaman Beranda</h1>
      <p class="page-subtitle">
        Kelola headline Hero, visual gedung & siswa, info cepat PPDB, sambutan Head of School / Principal, statistik angka sekolah, dan testimoni wali murid.
      </p>
    </div>

    <div class="header-action-group">
      <a href="/" target="_blank" class="btn btn-secondary">
        <Icon name="external-link" size={16} />
        <span>Buka Web Publik</span>
      </a>
      <button type="button" id="btn-export-beranda-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-beranda" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Perubahan Beranda Berhasil Disimpan!</strong>
      <p>Data beranda telah tersimpan secara lokal di browser Anda. Anda juga dapat mengunduh berkas JSON terbaru.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <!-- Tab Navigation for Sections -->
  <div class="section-tabs-bar" role="tablist">
    <button type="button" class="tab-btn active" data-tab="tab-hero" role="tab" aria-selected="true">
      <Icon name="home" size={16} />
      <span>1. Hero & Banner Visual</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-ppdb" role="tab" aria-selected="false">
      <Icon name="calendar" size={16} />
      <span>2. Info PPDB & Banner</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-sambutan" role="tab" aria-selected="false">
      <Icon name="award" size={16} />
      <span>3. Sambutan Pimpinan</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-stats" role="tab" aria-selected="false">
      <Icon name="bar-chart-2" size={16} />
      <span>4. Angka Kunci</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-testimoni" role="tab" aria-selected="false">
      <Icon name="users" size={16} />
      <span>5. Testimoni (CRUD)</span>
    </button>
  </div>

  <div class="beranda-layout-grid">
    <!-- Left Column: Forms -->
    <div class="form-container">
      <form id="beranda-form" onsubmit="return false;">

        <!-- ========================================== -->
        <!-- TAB 1: HERO & VISUAL -->
        <!-- ========================================== -->
        <div class="tab-panel active" id="tab-hero">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="home" size={20} />
              </div>
              <div>
                <h3>Hero Section Utama</h3>
                <p class="card-desc">Teks tajuk selamat datang, motto Sekolah, dan tombol aksi pembuka di bagian paling atas beranda.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-hero-title">Judul Utama Hero (Headline) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-hero-title"
                  name="heroTitle"
                  value={hero.title}
                  required
                  class="form-control"
                />
                <span class="form-help">Nama Sekolah yang tampil tebal pada headline pembuka.</span>
              </div>

              <div class="form-group col-span-2">
                <label for="input-hero-subtitle">Sub-headline / Deskripsi Ringkas <span class="req">*</span></label>
                <textarea
                  id="input-hero-subtitle"
                  name="heroSubtitle"
                  rows="3"
                  required
                  class="form-control"
                >{hero.subtitle}</textarea>
                <span class="form-help">Pengantar filosofi belajar di bawah naungan FREEKS Foundation.</span>
              </div>

              <div class="form-group">
                <label for="input-hero-cta-text">Teks Tombol Utama (CTA 1) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-hero-cta-text"
                  name="heroCtaText"
                  value={hero.ctaText}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-hero-cta-url">Tautan Tombol Utama (URL) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-hero-cta-url"
                  name="heroCtaUrl"
                  value={hero.ctaUrl}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-hero-sec-text">Teks Tombol Sekunder (CTA 2) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-hero-sec-text"
                  name="heroSecText"
                  value={hero.secondaryText}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-hero-sec-url">Tautan Tombol Sekunder (URL) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-hero-sec-url"
                  name="heroSecUrl"
                  value={hero.secondaryUrl}
                  required
                  class="form-control"
                />
              </div>
            </div>
          </div>

          <!-- Hero Visual & Images -->
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="image" size={20} />
              </div>
              <div>
                <h3>Aset Visual Hero Section</h3>
                <p class="card-desc">Latar gedung kampus dan kartu komposit foto kegiatan siswa.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-hero-bg-src">Path Foto Background gedung kampus <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-hero-bg"
                    src="/assets/gedung-mts-islamiyah.webp"
                    alt="Latar Gedung"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input
                      type="text"
                      id="input-hero-bg-src"
                      name="heroBgSrc"
                      value="/assets/gedung-mts-islamiyah.webp"
                      required
                      class="form-control"
                    />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Gedung</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-hero-bg-src" data-target-preview="img-prev-hero-bg" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                    <span class="form-help">Foto latar gedung bertingkat FREEKS.id School dengan pola islami transparan.</span>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label for="input-hero-card-1">Foto Kartu Siswa Belajar <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-card-1"
                    src="/assets/hero-siswa-belajar.webp"
                    alt="Siswa Belajar"
                    class="asset-thumb-sq"
                  />
                  <div class="asset-details">
                    <input
                      type="text"
                      id="input-hero-card-1"
                      name="heroCard1"
                      value="/assets/hero-siswa-belajar.webp"
                      required
                      class="form-control"
                    />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-hero-card-1" data-target-preview="img-prev-card-1" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label for="input-hero-card-2">Foto Kartu Siswa di Halaman <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-card-2"
                    src="/assets/hero-siswa-berjalan.webp"
                    alt="Siswa Berjalan"
                    class="asset-thumb-sq"
                  />
                  <div class="asset-details">
                    <input
                      type="text"
                      id="input-hero-card-2"
                      name="heroCard2"
                      value="/assets/hero-siswa-berjalan.webp"
                      required
                      class="form-control"
                    />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-hero-card-2" data-target-preview="img-prev-card-2" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: INFO CEPAT PPDB & BANNER -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-ppdb">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="calendar" size={20} />
              </div>
              <div>
                <h3>Info Cepat PPDB (Strip Beranda)</h3>
                <p class="card-desc">Bar informasi ringkas di bawah hero yang menunjukkan jadwal dan kuota pendaftaran kepada calon siswa.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-ppdb-status">Status Pendaftaran (Badge) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-ppdb-status"
                  name="ppdbStatus"
                  value={ppdbData.status}
                  required
                  class="form-control"
                />
                <span class="form-help">Contoh: "Dibuka s.d. 28 Februari 2027"</span>
              </div>

              <div class="form-group">
                <label for="input-ppdb-wave-dates">Jadwal Gelombang 1 <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-ppdb-wave-dates"
                  name="ppdbWaveDates"
                  value={ppdbData.waves[0].registration}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-ppdb-quota">Daya Tampung / Total Kuota <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-ppdb-quota"
                  name="ppdbQuota"
                  value={`${ppdbData.quota.total} Siswa`}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-ppdb-reqs">Syarat Masuk Ringkas <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-ppdb-reqs"
                  name="ppdbReqs"
                  value="Lulus SD/MI & Tes Baca Al-Qur'an"
                  required
                  class="form-control"
                />
                <span class="form-help">Syarat utama yang tampil langsung di strip info cepat beranda.</span>
              </div>
            </div>
          </div>

          <!-- Banner Ajakan PPDB Bawah -->
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="user-plus" size={20} />
              </div>
              <div>
                <h3>Banner Ajakan PPDB (Bagian Bawah Beranda)</h3>
                <p class="card-desc">Banner promosi berlatar hijau gelap dengan tombol ajakan mendaftar online.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-banner-chip">Teks Label Tahun Ajaran <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-banner-chip"
                  name="bannerChip"
                  value="Tahun Ajaran 2027/2028"
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-banner-title">Judul Utama Banner <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-banner-title"
                  name="bannerTitle"
                  value="Pendaftaran Siswa Baru FREEKS.id School Telah Dibuka"
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-banner-desc">Deskripsi Ajakan Banner <span class="req">*</span></label>
                <textarea
                  id="input-banner-desc"
                  name="bannerDesc"
                  rows="2"
                  required
                  class="form-control"
                >Kuota terbatas untuk 128 siswa. Dapatkan kemudahan pendaftaran online, potongan infaq beasiswa, dan lingkungan belajar ramah siswa.</textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 3: SAMBUTAN Head of School / Principal -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-sambutan">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="award" size={20} />
              </div>
              <div>
                <h3>Sambutan Head of School / Principal</h3>
                <p class="card-desc">Profil pimpinan, foto resmi berseragam batik, dan kutipan pengantar silaturahmi kepada wali murid.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-sambutan-name">Nama Lengkap Head of School / Principal <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-sambutan-name"
                  name="sambutanName"
                  value={sambutan.name}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-sambutan-role">Jabatan Resmi <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-sambutan-role"
                  name="sambutanRole"
                  value={sambutan.role}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-sambutan-photo">Foto Resmi Head of School / Principal <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-sambutan"
                    src={sambutan.photo.src}
                    alt={sambutan.photo.alt}
                    class="asset-thumb-leader"
                  />
                  <div class="asset-details">
                    <input
                      type="text"
                      id="input-sambutan-photo"
                      name="sambutanPhoto"
                      value={sambutan.photo.src}
                      required
                      class="form-control"
                    />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Pimpinan</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-sambutan-photo" data-target-preview="img-prev-sambutan" data-sim-preview="sim-sambutan-img" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                    <span class="form-help">Foto resmi pose berwibawa dengan format WebP.</span>
                  </div>
                </div>
              </div>

              <div class="form-group col-span-2">
                <label for="input-sambutan-arabic">Salam Pembuka Bahasa Arab <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-sambutan-arabic"
                  name="sambutanArabic"
                  value={sambutan.arabicGreeting}
                  dir="rtl"
                  required
                  class="form-control font-arabic"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-sambutan-quote">Kutipan Ringkas di Beranda (Short Quote) <span class="req">*</span></label>
                <textarea
                  id="input-sambutan-quote"
                  name="sambutanQuote"
                  rows="4"
                  required
                  class="form-control"
                >{sambutan.shortQuote}</textarea>
                <span class="form-help">Teks kutipan yang tampil dalam tanda petik pada kartu sambutan di beranda.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 4: STATISTIK ANGKA KUNCI SEKOLAH -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-stats">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="bar-chart-2" size={20} />
              </div>
              <div>
                <h3>5 Angka Kunci / Statistik Sekolah</h3>
                <p class="card-desc">Angka pencapaian terverifikasi yang tampil pada strip hijau gelap di halaman beranda.</p>
              </div>
            </div>

            <div class="stats-edit-list" id="stats-edit-container">
              {stats.map((s, idx) => (
                <div class="stat-edit-item" data-stat-idx={idx}>
                  <div class="stat-badge-idx">#{idx + 1}</div>
                  <div class="stat-fields-row">
                    <div class="form-group stat-val-group">
                      <label>Nilai / Angka</label>
                      <input
                        type="text"
                        class="form-control stat-input-value"
                        value={s.value}
                        data-key="value"
                      />
                    </div>
                    <div class="form-group stat-lbl-group">
                      <label>Label Indikator</label>
                      <input
                        type="text"
                        class="form-control stat-input-label"
                        value={s.label}
                        data-key="label"
                      />
                    </div>
                    <div class="form-group stat-note-group">
                      <label>Keterangan Tambahan</label>
                      <input
                        type="text"
                        class="form-control stat-input-note"
                        value={s.note}
                        data-key="note"
                      />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 5: TESTIMONI (CRUD LENGKAP) -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-testimoni">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="users" size={20} />
                </div>
                <div>
                  <h3>Testimoni Wali Murid & Alumni</h3>
                  <p class="card-desc">Kelola apresiasi, kesan, dan pengalaman nyata dari wali murid dan alumni FREEKS.id School.</p>
                </div>
              </div>
              <button type="button" id="btn-add-testimoni" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>+ Tambah Testimoni</span>
              </button>
            </div>

            <!-- List of Testimonials -->
            <div class="testimonials-admin-list" id="testimonials-list">
              <!-- Dynamically populated via JavaScript, initial server rendered fallback -->
              {testimonials.map((t, idx) => (
                <div class="testi-admin-card" data-id={t.id}>
                  <div class="testi-admin-header">
                    <div class="avatar-badge">{t.initials}</div>
                    <div class="testi-author-info">
                      <div class="testi-name-row">
                        <strong class="testi-name">{t.name}</strong>
                        <span class="role-tag">{t.role}</span>
                      </div>
                      <div class="testi-rating-stars">★★★★★</div>
                    </div>
                    <div class="testi-item-actions">
                      <button type="button" class="btn-action-edit btn-edit-testi" data-idx={idx} title="Edit Testimoni">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-testi" data-idx={idx} title="Hapus Testimoni">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                  <div class="testi-quote-box">
                    <div class="quote-mark-icon">“</div>
                    <p class="testi-admin-quote">{t.quote}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Add / Edit Modal or Inline Card -->
          <div class="form-card card" id="modal-testimoni" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-testi-title">Tambah Testimoni Baru</h3>
                <p class="card-desc">Pastikan nama dan peran sesuai ketentuan (inisial otomatis dihasilkan).</p>
              </div>
            </div>

            <div class="form-grid">
              <input type="hidden" id="input-testi-id" value="" />
              <div class="form-group">
                <label for="input-testi-name">Nama Lengkap <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-testi-name"
                  placeholder="Contoh: Ibu Sri Wahyuni"
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-testi-role">Peran / Status <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-testi-role"
                  placeholder="Contoh: Wali murid kelas VIII / Alumni 2024"
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-testi-initials">Inisial Avatar (Maks 2 Huruf) <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-testi-initials"
                  maxlength="3"
                  placeholder="SW"
                  class="form-control"
                  style="text-transform: uppercase;"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-testi-quote">Isi Kutipan / Pengalaman <span class="req">*</span></label>
                <textarea
                  id="input-testi-quote"
                  rows="3"
                  placeholder="Tuliskan pengalaman positif dan kesan bersekolah di FREEKS.id School..."
                  class="form-control"
                ></textarea>
              </div>

              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-testi" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-testi-item" class="btn btn-primary">Simpan Testimoni</button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Interactive Live Preview & Quick Actions -->
