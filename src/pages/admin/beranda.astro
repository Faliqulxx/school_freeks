              </div>
              <p id="sim-testi-quote" class="sim-testi-text">"{testimonials[0].quote}"</p>
            </div>
          </div>

          <div class="preview-footer-action">
            <button type="button" id="btn-save-beranda-side" class="btn btn-primary btn-block">
              <Icon name="check" size={18} />
              <span>Simpan Perubahan Beranda</span>
            </button>
          </div>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>

