---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import kesiswaanData from '../../data/kesiswaan.json';
import ekskulData from '../../data/ekskul.json';

const { rules, osis, alumni } = kesiswaanData;
const { extracurriculars } = ekskulData;
---

<AdminLayout title="Manajemen Kesiswaan & OSIS (Modul 5)" activeMenu="kesiswaan">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 5 DARI 8</div>
      <h1>Manajemen Kesiswaan & OSIS</h1>
      <p class="page-subtitle">
        Kelola kabinet pengurus OSIS, kegiatan ekstrakurikuler siswa, tata tertib & etika siswa, dan direktori penelusuran jejak alumni (tracer study).
      </p>
    </div>

    <div class="header-action-group">
      <a href="/kesiswaan/osis" target="_blank" class="btn btn-secondary">
        <Icon name="external-link" size={16} />
        <span>Buka Web Publik</span>
      </a>
      <button type="button" id="btn-export-kesiswaan-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-kesiswaan" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Perubahan Kesiswaan Berhasil Disimpan!</strong>
      <p>Data OSIS, ekskul, tata tertib, dan direktori alumni telah tersimpan secara lokal di browser Anda.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <!-- Sub-Modul Tab Navigation -->
  <div class="section-tabs-bar" role="tablist">
    <button type="button" class="tab-btn active" data-tab="tab-osis" role="tab" aria-selected="true">
      <Icon name="users" size={16} />
      <span>1. OSIS & MPK</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-ekskul" role="tab" aria-selected="false">
      <Icon name="activity" size={16} />
      <span>2. Ekstrakurikuler</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-tatatertib" role="tab" aria-selected="false">
      <Icon name="file-text" size={16} />
      <span>3. Tata Tertib Siswa</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-alumni" role="tab" aria-selected="false">
      <Icon name="award" size={16} />
      <span>4. Direktori Alumni</span>
    </button>
  </div>

  <div class="kesiswaan-layout-grid">
    <!-- Left Column: Forms -->
    <div class="form-container">
      <form id="kesiswaan-form" onsubmit="return false;">

        <!-- ========================================== -->
        <!-- SUB-MODUL 1: OSIS & MPK -->
        <!-- ========================================== -->
        <div class="tab-panel active" id="tab-osis">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="users" size={20} />
              </div>
              <div>
                <h3>Informasi Kabinet OSIS</h3>
                <p class="card-desc">Periode masa bakti dan nama kabinet kepengurusan siswa intra Sekolah.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-osis-period">Periode Masa Bakti <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-osis-period"
                  value={osis.period}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group">
                <label for="input-osis-cabinet">Nama Kabinet OSIS <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-osis-cabinet"
                  value={osis.cabinet}
                  required
                  class="form-control"
                />
              </div>
            </div>
          </div>

          <!-- CRUD Pengurus Inti OSIS -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="user-check" size={20} />
                </div>
                <div>
                  <h3>Pengurus Inti OSIS (CRUD)</h3>
                  <p class="card-desc">Ketua, Wakil, Sekretaris, Bendahara, dan pengurus harian.</p>
                </div>
              </div>
              <button type="button" id="btn-add-osis-member" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Pengurus</span>
              </button>
            </div>

            <div class="osis-members-list" id="osis-members-container">
              {osis.structure.map((st, idx) => (
                <div class="osis-member-row" data-idx={idx}>
                  <div class="osis-role-badge">{st.role}</div>
                  <input type="text" class="form-control osis-name-input" value={st.name} />
                  <button type="button" class="btn-action-delete btn-del-osis-m" data-idx={idx} title="Hapus Pengurus">
                    <Icon name="trash-2" size={14} />
                    <span>Hapus</span>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <!-- CRUD Departemen & Proker OSIS -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="layers" size={20} />
                </div>
                <div>
                  <h3>Departemen & Program Kerja OSIS (CRUD)</h3>
                  <p class="card-desc">Divisi teknologi & inovasi digital, media kreatif, olahraga & e-sports, serta sosial lingkungan.</p>
                </div>
              </div>
              <button type="button" id="btn-add-osis-dept" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Departemen</span>
              </button>
            </div>

            <div class="osis-dept-list" id="osis-dept-container">
              {osis.departments.map((dept, idx) => (
                <div class="osis-dept-card" data-idx={idx}>
                  <div class="dept-header-row">
                    <input type="text" class="form-control dept-name-input" value={dept.name} />
                    <button type="button" class="btn-action-delete btn-del-dept" data-idx={idx} title="Hapus Departemen">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                  <textarea rows="2" class="form-control dept-prog-input">{dept.programs}</textarea>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 2: EKSTRAKURIKULER -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-ekskul">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="activity" size={20} />
                </div>
                <div>
                  <h3>Daftar Ekstrakurikuler (CRUD)</h3>
                  <p class="card-desc">Robotics, Coding Guild, 3D Art & Game Design, Podcast, English Debate, Futsal.</p>
                </div>
              </div>
              <button type="button" id="btn-add-ekskul" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Ekskul</span>
              </button>
            </div>

            <div class="ekskul-admin-grid" id="ekskul-list-container">
              {extracurriculars.map((ek, idx) => (
                <div class="ekskul-admin-card" data-idx={idx}>
                  <div class="ekskul-thumb-wrap">
                    <img src={ek.image.src} alt={ek.name} class="ekskul-thumb" onerror="this.src='/assets/dummy/ekskul-hadrah.svg'" />
                  </div>
                  <div class="ekskul-body">
                    <span class="cat-pill">{ek.category}</span>
                    <h4>{ek.name}</h4>
                    <p class="ekskul-sched">
                      <Icon name="clock" size={13} />
                      <span>{ek.schedule}</span>
                    </p>
                    <p class="ekskul-mentor">Pelatih: <strong>{ek.mentor}</strong></p>
                    <p class="ekskul-desc">{ek.description}</p>
                    <div class="ekskul-card-actions">
                      <button type="button" class="btn-action-edit btn-edit-ek" data-idx={idx} title="Edit Ekskul">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-ek" data-idx={idx} title="Hapus Ekskul">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Ekskul -->
          <div class="form-card card" id="modal-ekskul" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-ek-title">Tambah / Edit Ekstrakurikuler</h3>
                <p class="card-desc">Lengkapi nama kegiatan, jadwal latihan, pembina, dan foto visual.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-ek-id" value="" />
              <div class="form-group">
                <label for="input-ek-name">Nama Ekstrakurikuler <span class="req">*</span></label>
                <input type="text" id="input-ek-name" placeholder="Contoh: Hadrah dan Qasidah" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ek-cat">Kategori Kegiatan <span class="req">*</span></label>
                <select id="input-ek-cat" class="form-control">
                  <option value="Seni Keagamaan">Seni Keagamaan</option>
                  <option value="Kepramukaan">Kepramukaan</option>
                  <option value="Olahraga">Olahraga</option>
                  <option value="Sains">Sains & Penelitian</option>
                  <option value="Bahasa">Bahasa Asing</option>
                  <option value="Keterampilan">Keterampilan & Kesenian</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-ek-schedule">Hari & Jam Latihan <span class="req">*</span></label>
                <input type="text" id="input-ek-schedule" placeholder="Contoh: Rabu 14.00 WIB" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ek-mentor">Nama Pembina / Pelatih <span class="req">*</span></label>
                <input type="text" id="input-ek-mentor" placeholder="Contoh: Ust. Laila M." class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-ek-desc">Deskripsi & Aktivitas Latihan <span class="req">*</span></label>
                <textarea id="input-ek-desc" rows="3" class="form-control" placeholder="Uraian manfaat dan materi latihan ekskul..."></textarea>
              </div>
              <div class="form-group col-span-2">
                <label for="input-ek-img">Foto Kegiatan Ekskul (WebP / SVG) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-ek"
                    src="/assets/dummy/ekskul-hadrah.svg"
                    alt="Pratinjau Ekskul"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-ek-img" value="/assets/dummy/ekskul-hadrah.svg" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Ekskul</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-ek-img" data-target-preview="img-prev-ek" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-ek" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-ek-item" class="btn btn-primary">Simpan Ekskul</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 3: TATA TERTIB SISWA -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-tatatertib">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="file-text" size={20} />
              </div>
              <div>
                <h3>Pedoman & Tata Tertib Siswa</h3>
                <p class="card-desc">Aturan kedisiplinan, jam kehadiran, pakaian seragam, dan tata krama pergaulan.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-rules-title">Judul Dokumen Tata Tertib <span class="req">*</span></label>
                <input type="text" id="input-rules-title" value={rules.title} required class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-rules-updated">Bulan & Tahun Pembaruan <span class="req">*</span></label>
                <input type="text" id="input-rules-updated" value={rules.updated} required class="form-control" />
              </div>
            </div>
          </div>

          <!-- CRUD Bab-Bab Tata Tertib -->
          <div class="rules-chapters-list" id="rules-chapters-container">
            {rules.chapters.map((ch, chIdx) => (
              <div class="form-card card rule-chapter-card" data-ch-idx={chIdx}>
                <div class="card-header justify-between">
                  <div class="header-icon-title">
                    <div class="header-icon-wrap">
                      <Icon name="bookmark" size={18} />
                    </div>
                    <div>
                      <input type="text" class="form-control chapter-title-input" value={ch.chapter} />
                    </div>
                  </div>
                </div>

                <div class="chapter-items-list" data-ch-idx={chIdx}>
                  {ch.items.map((item, itIdx) => (
                    <div class="rule-item-row" data-it-idx={itIdx}>
                      <textarea rows="2" class="form-control rule-item-input">{item}</textarea>
                      <button type="button" class="btn-action-delete btn-delete-rule-item" title="Hapus Butir">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  ))}
                </div>

                <button type="button" class="btn btn-secondary btn-sm btn-add-rule-item mt-2" data-ch-idx={chIdx}>
                  <Icon name="plus" size={14} />
                  <span>Tambah Butir Aturan</span>
                </button>
              </div>
            ))}
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 4: DIREKTORI ALUMNI -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-alumni">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="award" size={20} />
              </div>
              <div>
                <h3>Statistik Penelusuran Alumni (Tracer Study)</h3>
                <p class="card-desc">Data jumlah alumni terdata dan tautan kuesioner pelacakan karir.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="input-alumni-count">Total Alumni Terdata <span class="req">*</span></label>
                <input type="number" id="input-alumni-count" value={alumni.totalRegistered} required class="form-control" />
              </div>

              <div class="form-group">
                <label for="input-tracer-link">Tautan Formulir Tracer Study Online</label>
                <input type="text" id="input-tracer-link" value="https://forms.gle/tracer-study-freeks-school" class="form-control" />
              </div>
            </div>
          </div>

          <!-- CRUD Kisah & Testimoni Alumni -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="message-square" size={20} />
                </div>
                <div>
                  <h3>Kisah Inspiratif & Testimoni Alumni (CRUD)</h3>
                  <p class="card-desc">Pengalaman alumni yang telah berkarya di industri teknologi, melanjutkan studi favorit, atau memenangkan kompetisi.</p>
                </div>
              </div>
              <button type="button" id="btn-add-alumni-story" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Kisah</span>
              </button>
            </div>

            <div class="alumni-stories-list" id="alumni-stories-container">
              {alumni.stories.map((st, idx) => (
                <div class="alumni-story-card" data-idx={idx}>
                  <div class="alumni-story-header">
                    <div class="alumni-avatar">{st.name.charAt(0)}</div>
                    <div class="alumni-meta">
                      <strong>{st.name}</strong>
                      <span class="alumni-yr">{st.year}</span>
                      <small class="alumni-current">{st.current}</small>
                    </div>
                    <div class="alumni-actions">
                      <button type="button" class="btn-action-edit btn-edit-alumni" data-idx={idx} title="Edit Kisah">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-alumni" data-idx={idx} title="Hapus Kisah">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                  <blockquote class="alumni-testi-text">"{st.testimony}"</blockquote>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Alumni -->
          <div class="form-card card" id="modal-alumni" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-alumni-title">Tambah / Edit Kisah Alumni</h3>
                <p class="card-desc">Lengkapi nama alumni, tahun kelulusan, aktivitas saat ini, dan kesan pesan.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-alumni-id" value="" />
              <div class="form-group">
                <label for="input-al-name">Nama Lengkap Alumni <span class="req">*</span></label>
                <input type="text" id="input-al-name" placeholder="Contoh: Rafi Pratama" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-al-year">Tahun Angkatan <span class="req">*</span></label>
                <input type="text" id="input-al-year" placeholder="Contoh: Alumni 2024" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-al-current">Aktivitas / Sekolah Lanjutan / Profesi <span class="req">*</span></label>
                <input type="text" id="input-al-current" placeholder="Contoh: Juara Robotika / Software Engineer" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-al-testi">Kutipan Pengalaman & Kesan <span class="req">*</span></label>
                <textarea id="input-al-testi" rows="3" class="form-control" placeholder="Pondasi inovasi dan teknologi di Sekolah Contoh Indonesia sangat membantu saya..."></textarea>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-alumni" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-alumni-item" class="btn btn-primary">Simpan Kisah</button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Interactive Live Preview -->
    <aside class="preview-container">
      <div class="preview-sticky-wrap">
        <div class="card preview-card">
          <div class="card-header-sm">
            <div class="flex-align-center gap-2">
              <Icon name="eye" size={18} />
              <h4>Pratinjau Kesiswaan</h4>
            </div>
            <div class="preview-mode-pills" id="kesiswaan-preview-pills">
              <button type="button" class="pill-btn active" data-mode="osis">OSIS</button>
              <button type="button" class="pill-btn" data-mode="ekskul">Ekskul</button>
              <button type="button" class="pill-btn" data-mode="rules">Aturan</button>
              <button type="button" class="pill-btn" data-mode="alumni">Alumni</button>
            </div>
          </div>

          <!-- Preview 1: OSIS -->
          <div id="sim-kes-osis" class="sim-kes-view active">
            <div class="sim-osis-box">
              <span class="sim-osis-pill" id="sim-osis-period">{osis.period}</span>
              <h4 id="sim-osis-cabinet">{osis.cabinet}</h4>
              <p class="sim-osis-leader">Ketua: <strong id="sim-osis-leader-name">{osis.structure[0].name}</strong></p>
              <div class="sim-dept-preview">
                <small>Departemen Unggulan:</small>
                <strong id="sim-first-dept-name">{osis.departments[0].name}</strong>
              </div>
            </div>
          </div>

          <!-- Preview 2: Ekskul -->
          <div id="sim-kes-ekskul" class="sim-kes-view" style="display: none;">
            <div class="sim-ekskul-card">
              <img id="sim-ekskul-thumb" src={extracurriculars[0].image.src} alt="Ekskul" class="sim-ek-img" />
              <div class="sim-ek-body">
                <span class="sim-cat-tag">{extracurriculars[0].category}</span>
                <h4 id="sim-ek-title">{extracurriculars[0].name}</h4>
                <p id="sim-ek-sched" class="sim-sched-text">{extracurriculars[0].schedule}</p>
                <small id="sim-ek-mentor">Pelatih: {extracurriculars[0].mentor}</small>
              </div>
            </div>
          </div>

          <!-- Preview 3: Rules -->
          <div id="sim-kes-rules" class="sim-kes-view" style="display: none;">
            <div class="sim-rules-box">
              <h4 id="sim-rules-title">{rules.title}</h4>
              <span class="sim-updated-tag" id="sim-rules-updated">Pembaruan: {rules.updated}</span>
              <div class="sim-rule-sample">
                <strong>{rules.chapters[0].chapter}</strong>
                <p id="sim-first-rule-item">{rules.chapters[0].items[0]}</p>
              </div>
            </div>
          </div>

          <!-- Preview 4: Alumni -->
          <div id="sim-kes-alumni" class="sim-kes-view" style="display: none;">
            <div class="sim-alumni-box">
              <div class="sim-alumni-head">
                <div class="sim-avatar-circle" id="sim-al-avatar">{alumni.stories[0].name.charAt(0)}</div>
                <div>
                  <h4 id="sim-al-name">{alumni.stories[0].name}</h4>
                  <span id="sim-al-yr" class="sim-al-yr">{alumni.stories[0].year}</span>
                </div>
              </div>
              <p id="sim-al-testi" class="sim-al-quote">"{alumni.stories[0].testimony}"</p>
            </div>
          </div>

          <div class="preview-footer-action">
            <button type="button" id="btn-save-kesiswaan-side" class="btn btn-primary btn-block">
