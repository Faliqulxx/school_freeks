    if (btnSaveEkItem) {
      btnSaveEkItem.addEventListener('click', () => {
        const id = document.getElementById('input-ek-id').value || ('ek-' + Date.now());
        const name = document.getElementById('input-ek-name').value.trim();
        const category = document.getElementById('input-ek-cat').value;
        const schedule = document.getElementById('input-ek-schedule').value.trim();
        const mentor = document.getElementById('input-ek-mentor').value.trim();
        const description = document.getElementById('input-ek-desc').value.trim();
        const src = document.getElementById('input-ek-img').value.trim();
        if (!name || !schedule) {
          alert('Mohon lengkapi nama ekskul dan jadwal latihan!');
          return;
        }
        const obj = { id, name, category, schedule, mentor, description, image: { src, alt: name, width: 800, height: 500 } };
        if (editingEkIdx >= 0) {
          ekskulState[editingEkIdx] = obj;
        } else {
          ekskulState.push(obj);
        }
        modalEkskul.style.display = 'none';
        renderEkskulList();
      });
