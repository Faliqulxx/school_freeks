          modalEkskul.style.display = 'block';
          modalEkskul.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-ek-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = ekskulState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus ekstrakurikuler "${item.name}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              ekskulState.splice(idx, 1);
              renderEkskulList();
