      if (!ekskulContainer) return;
      ekskulContainer.innerHTML = '';
      ekskulState.forEach((ek, idx) => {
        const card = document.createElement('div');
        card.className = 'ekskul-admin-card';
        card.innerHTML = `
          <div class="ekskul-thumb-wrap">
            <img src="${ek.image?.src || '/assets/dummy/ekskul-hadrah.svg'}" alt="${ek.name}" class="ekskul-thumb" onerror="this.src='/assets/dummy/ekskul-hadrah.svg'" />
