    if (btnSaveAlumniItem) {
      btnSaveAlumniItem.addEventListener('click', () => {
        const id = document.getElementById('input-alumni-id').value || ('alumni-' + Date.now());
        const name = document.getElementById('input-al-name').value.trim();
        const year = document.getElementById('input-al-year').value.trim();
        const current = document.getElementById('input-al-current').value.trim();
        const testimony = document.getElementById('input-al-testi').value.trim();
        if (!name || !testimony) {
          alert('Mohon lengkapi nama alumni dan kutipan testimoni!');
          return;
        }
        const obj = { id, name, year, current, testimony };
        if (editingAlumniIdx >= 0) {
          alumniStoriesState[editingAlumniIdx] = obj;
        } else {
          alumniStoriesState.push(obj);
        }
        modalAlumni.style.display = 'none';
        renderAlumniStories();
      });
    }

    // Dynamic Rule Items
    document.querySelectorAll('.btn-add-rule-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const chIdx = btn.getAttribute('data-ch-idx');
        const list = document.querySelector(`.chapter-items-list[data-ch-idx="${chIdx}"]`);
        if (list) {
          const row = document.createElement('div');
          row.className = 'rule-item-row';
          row.innerHTML = `
            <textarea rows="2" class="form-control rule-item-input" placeholder="Tuliskan butir aturan baru..."></textarea>
            <button type="button" class="btn-action-delete btn-delete-rule-item" title="Hapus Butir">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          `;
          row.querySelector('.btn-delete-rule-item').addEventListener('click', () => row.remove());
          list.appendChild(row);
        }
      });
    });

    document.querySelectorAll('.btn-delete-rule-item').forEach(b => {
      b.addEventListener('click', () => {
        b.closest('.rule-item-row')?.remove();
      });
    });

    // Save All Kesiswaan
    function handleSaveKesiswaan() {
      // Gather rules
      const chaptersData = [];
      document.querySelectorAll('.rule-chapter-card').forEach(card => {
        const chTitle = card.querySelector('.chapter-title-input')?.value || '';
        const items = [];
        card.querySelectorAll('.rule-item-input').forEach(inp => {
          if (inp.value.trim()) items.push(inp.value.trim());
        });
        chaptersData.push({ chapter: chTitle, items });
      });

      const payload = {
        updatedAt: new Date().toISOString(),
        period: document.getElementById('input-osis-period')?.value || '2026/2027',
        cabinet: document.getElementById('input-osis-cabinet')?.value || 'Kabinet Sinergi Inovasi',
        osisMembers: osisMembersState,
        osisDept: osisDeptState,
        ekskul: ekskulState,
        rulesTitle: document.getElementById('input-rules-title')?.value || '',
        rulesUpdated: document.getElementById('input-rules-updated')?.value || '',
        rulesChapters: chaptersData,
        alumniTotal: parseInt(document.getElementById('input-alumni-count')?.value, 10) || 1420,
        alumniStories: alumniStoriesState
      };

      localStorage.setItem('mts_cms_kesiswaan_data', JSON.stringify(payload));

      const toast = document.getElementById('save-toast');
      if (toast) {
        toast.hidden = false;
        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    const btnSave1 = document.getElementById('btn-save-kesiswaan');
    const btnSave2 = document.getElementById('btn-save-kesiswaan-side');
    if (btnSave1) btnSave1.addEventListener('click', handleSaveKesiswaan);
    if (btnSave2) btnSave2.addEventListener('click', handleSaveKesiswaan);

    const toastClose = document.getElementById('toast-close');
    if (toastClose) toastClose.addEventListener('click', () => { document.getElementById('save-toast').hidden = true; });

    // Export JSON
    const btnExport = document.getElementById('btn-export-kesiswaan-json');
    if (btnExport) {
      btnExport.addEventListener('click', () => {
        const saved = localStorage.getItem('mts_cms_kesiswaan_data');
        const dataObj = saved ? JSON.parse(saved) : { osis: { members: osisMembersState, departments: osisDeptState }, ekskul: ekskulState, alumni: alumniStoriesState };
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(dataObj, null, 2));
        const a = document.createElement('a');
        a.setAttribute('href', dataStr);
        a.setAttribute('download', `kesiswaan-cms-${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Initial render
    renderOsisMembers();
    renderOsisDept();
    renderEkskulList();
    renderAlumniStories();
    syncKesiswaanPreview();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKesiswaan);
  } else {
    initKesiswaan();
  }
</script>

