      { id: "alumni-3", name: "Ahmad Dani", year: "Alumni 2023", current: "Peraih Beasiswa Sains Internasional", testimony: "Penguasaan Bahasa Inggris aktif dan bimbingan computational thinking di sekolah ini membuka gerbang kesempatan internasional bagi saya." }
    ];

    // Load from localStorage with migration
    const savedKesiswaan = localStorage.getItem('mts_cms_kesiswaan_data');
    if (savedKesiswaan) {
      try {
        const parsed = JSON.parse(savedKesiswaan);
        const hasLegacyData = parsed.ekskul && parsed.ekskul.some(e => e.name && e.name.toLowerCase().includes('hadrah'));
        if (hasLegacyData) {
          localStorage.removeItem('mts_cms_kesiswaan_data');
        } else {
          if (parsed.osisMembers && parsed.osisMembers.length) osisMembersState = parsed.osisMembers;
          if (parsed.osisDept && parsed.osisDept.length) osisDeptState = parsed.osisDept;
          if (parsed.ekskul && parsed.ekskul.length) ekskulState = parsed.ekskul;
          if (parsed.alumniStories && parsed.alumniStories.length) alumniStoriesState = parsed.alumniStories;
          if (parsed.period && document.getElementById('input-osis-period')) document.getElementById('input-osis-period').value = parsed.period;
          if (parsed.cabinet && document.getElementById('input-osis-cabinet')) document.getElementById('input-osis-cabinet').value = parsed.cabinet;
          if (parsed.rulesTitle && document.getElementById('input-rules-title')) document.getElementById('input-rules-title').value = parsed.rulesTitle;
          if (parsed.rulesUpdated && document.getElementById('input-rules-updated')) document.getElementById('input-rules-updated').value = parsed.rulesUpdated;
        }
      } catch (e) {
        console.error('Failed to parse saved kesiswaan:', e);
      }
    }

    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab');
        tabBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Preview mode switcher
    const previewPills = document.querySelectorAll('#kesiswaan-preview-pills .pill-btn');
    const simViews = {
      osis: document.getElementById('sim-kes-osis'),
      ekskul: document.getElementById('sim-kes-ekskul'),
      rules: document.getElementById('sim-kes-rules'),
      alumni: document.getElementById('sim-kes-alumni')
    };

    previewPills.forEach(pill => {
      pill.addEventListener('click', () => {
        previewPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const mode = pill.getAttribute('data-mode');
        Object.keys(simViews).forEach(k => {
          if (simViews[k]) simViews[k].style.display = (k === mode) ? 'block' : 'none';
        });
      });
    });

    // Live preview sync
    function syncKesiswaanPreview() {
      const pInput = document.getElementById('input-osis-period');
      const cInput = document.getElementById('input-osis-cabinet');
      if (pInput && document.getElementById('sim-osis-period')) {
        document.getElementById('sim-osis-period').textContent = pInput.value;
      }
      if (cInput && document.getElementById('sim-osis-cabinet')) {
        document.getElementById('sim-osis-cabinet').textContent = cInput.value;
      }

      const rtInput = document.getElementById('input-rules-title');
      const ruInput = document.getElementById('input-rules-updated');
      if (rtInput && document.getElementById('sim-rules-title')) {
        document.getElementById('sim-rules-title').textContent = rtInput.value;
      }
      if (ruInput && document.getElementById('sim-rules-updated')) {
        document.getElementById('sim-rules-updated').textContent = `Pembaruan: ${ruInput.value}`;
      }
    }

    const liveInputs = document.querySelectorAll('#kesiswaan-form input, #kesiswaan-form textarea');
    liveInputs.forEach(i => i.addEventListener('input', syncKesiswaanPreview));

    // CRUD Pengurus OSIS
    const osisMembersContainer = document.getElementById('osis-members-container');
    const btnAddOsisMember = document.getElementById('btn-add-osis-member');

    function renderOsisMembers() {
      if (!osisMembersContainer) return;
      osisMembersContainer.innerHTML = '';
      osisMembersState.forEach((st, idx) => {
        const row = document.createElement('div');
        row.className = 'osis-member-row';
        row.setAttribute('data-idx', idx);
        row.innerHTML = `
          <div class="osis-role-badge">${st.role}</div>
          <input type="text" class="form-control osis-name-input" value="${st.name}" />
          <button type="button" class="btn-action-delete btn-del-osis-m" data-idx="${idx}" title="Hapus Pengurus">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span>Hapus</span>
          </button>
        `;
        osisMembersContainer.appendChild(row);
      });

      osisMembersContainer.querySelectorAll('.osis-name-input').forEach((inp, idx) => {
        inp.addEventListener('input', () => {
          if (osisMembersState[idx]) osisMembersState[idx].name = inp.value;
          if (idx === 0 && document.getElementById('sim-osis-leader-name')) {
            document.getElementById('sim-osis-leader-name').textContent = inp.value;
          }
        });
      });

      document.querySelectorAll('.btn-del-osis-m').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = osisMembersState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus pengurus "${item.role}" (${item.name})?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              osisMembersState.splice(idx, 1);
              renderOsisMembers();
            });
          } else if (confirm(msg)) {
            osisMembersState.splice(idx, 1);
            renderOsisMembers();
          }
        });
      });

      if (osisMembersState.length > 0 && document.getElementById('sim-osis-leader-name')) {
        document.getElementById('sim-osis-leader-name').textContent = osisMembersState[0].name;
      }
    }

    if (btnAddOsisMember) {
      btnAddOsisMember.addEventListener('click', () => {
        const role = prompt('Masukkan Jabatan OSIS (contoh: Head of Innovation & Tech):', 'Head of Division');
        if (role) {
          osisMembersState.push({ role, name: 'Nama Siswa (Grade 7/8)' });
          renderOsisMembers();
        }
      });
    }

