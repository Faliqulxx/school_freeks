        document.getElementById('input-ach-title-val').value = '';
        document.getElementById('input-ach-student').value = '';
        document.getElementById('input-ach-year').value = '2026';
        document.getElementById('input-ach-organizer').value = '';
        document.getElementById('input-ach-img').value = '/assets/berita-prestasi-sains.webp';
        const prevAchImg = document.getElementById('img-prev-ach');
        if (prevAchImg) prevAchImg.src = '/assets/berita-prestasi-sains.webp';
        modalAch.style.display = 'block';
        modalAch.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelAch = document.getElementById('btn-cancel-ach');
    if (btnCancelAch) btnCancelAch.addEventListener('click', () => { modalAch.style.display = 'none'; });

    const btnSaveAchItem = document.getElementById('btn-save-ach-item');
    if (btnSaveAchItem) {
      btnSaveAchItem.addEventListener('click', () => {
        const id = document.getElementById('input-ach-id').value || ('prestasi-' + Date.now());
        const title = document.getElementById('input-ach-title-val').value.trim();
        const student = document.getElementById('input-ach-student').value.trim();
        const level = document.getElementById('input-ach-level').value;
        const year = parseInt(document.getElementById('input-ach-year').value, 10) || 2026;
        const organizer = document.getElementById('input-ach-organizer').value.trim();
        const src = document.getElementById('input-ach-img').value.trim();
        if (!title || !student) {
          alert('Mohon lengkapi judul kejuaraan dan nama siswa/tim!');
          return;
        }
        const obj = { id, title, student, level, year, organizer, image: { src, alt: title, width: 1200, height: 800 } };
        if (editingAchIdx >= 0) {
          achievementsState[editingAchIdx] = obj;
        } else {
          achievementsState.push(obj);
        }
        modalAch.style.display = 'none';
        renderPrestasiList();
      });
    }

    // CRUD Guru & Tendik
    const tcContainer = document.getElementById('teacher-list-container');
    const modalTc = document.getElementById('modal-teacher');
    let editingTcIdx = -1;

    function renderTeacherList() {
      if (!tcContainer) return;
      tcContainer.innerHTML = '';
      teachersState.forEach((tc, idx) => {
        const card = document.createElement('div');
        card.className = 'teacher-admin-card';
        card.innerHTML = `
          <div class="teacher-thumb-wrap">
            <img src="${tc.photo?.src || '/assets/guru-freeks.webp'}" alt="${tc.fullName}" class="teacher-thumb" onerror="this.src='/assets/guru-freeks.webp'" />
          </div>
          <div class="teacher-body">
            <span class="cat-pill">${tc.category}</span>
            <h4>${tc.fullName}</h4>
            <p class="teacher-subject">Mapel: <strong>${tc.subject}</strong></p>
            <p class="teacher-pos">${tc.position || tc.role}</p>
            <small class="teacher-ttl">${tc.birthPlaceDate}</small>
            <div class="teacher-card-actions">
              <button type="button" class="btn-action-edit btn-edit-tc-item" data-idx="${idx}" title="Edit Guru/Tendik">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                <span>Edit</span>
              </button>
              <button type="button" class="btn-action-delete btn-delete-tc-item" data-idx="${idx}" title="Hapus Guru/Tendik">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Hapus</span>
              </button>
            </div>
          </div>
        `;
        tcContainer.appendChild(card);
      });

      document.querySelectorAll('.btn-edit-tc-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingTcIdx = idx;
          const t = teachersState[idx];
          document.getElementById('modal-tc-title').textContent = 'Edit Guru / Tendik';
          document.getElementById('input-tc-id').value = t.id;
          document.getElementById('input-tc-name').value = t.name;
          document.getElementById('input-tc-fullname').value = t.fullName;
          document.getElementById('input-tc-category').value = t.category;
          document.getElementById('input-tc-role').value = t.role;
          document.getElementById('input-tc-subject').value = t.subject;
          document.getElementById('input-tc-ttl').value = t.birthPlaceDate;
          document.getElementById('input-tc-photo').value = t.photo?.src || '/assets/guru-freeks.webp';
          const prevTcImg = document.getElementById('img-prev-tc');
          if (prevTcImg) prevTcImg.src = t.photo?.src || '/assets/guru-freeks.webp';
          modalTc.style.display = 'block';
          modalTc.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-tc-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = teachersState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus data guru/tendik "${item.fullName}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              teachersState.splice(idx, 1);
              renderTeacherList();
            });
          } else if (confirm(msg)) {
            teachersState.splice(idx, 1);
            renderTeacherList();
          }
        });
      });

      if (teachersState.length > 0) {
        if (document.getElementById('sim-tc-name')) document.getElementById('sim-tc-name').textContent = teachersState[0].fullName;
        if (document.getElementById('sim-tc-sub')) document.getElementById('sim-tc-sub').textContent = teachersState[0].subject;
      }
    }

    const btnAddTc = document.getElementById('btn-add-teacher');
    if (btnAddTc) {
      btnAddTc.addEventListener('click', () => {
        editingTcIdx = -1;
        document.getElementById('modal-tc-title').textContent = 'Tambah Guru / Tendik Baru';
        document.getElementById('input-tc-id').value = 'tc-' + Date.now();
        document.getElementById('input-tc-name').value = 'Sekolah Contoh';
        document.getElementById('input-tc-fullname').value = 'Sekolah Contoh, S.Pd.';
        document.getElementById('input-tc-category').value = 'Mata Pelajaran';
        document.getElementById('input-tc-role').value = 'Guru Mata Pelajaran';
        document.getElementById('input-tc-subject').value = '';
        document.getElementById('input-tc-ttl').value = 'Gresik, ';
        document.getElementById('input-tc-photo').value = '/assets/guru-freeks.webp';
        const prevTcImg = document.getElementById('img-prev-tc');
        if (prevTcImg) prevTcImg.src = '/assets/guru-freeks.webp';
        modalTc.style.display = 'block';
        modalTc.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelTc = document.getElementById('btn-cancel-tc');
    if (btnCancelTc) btnCancelTc.addEventListener('click', () => { modalTc.style.display = 'none'; });

    const btnSaveTcItem = document.getElementById('btn-save-tc-item');
    if (btnSaveTcItem) {
      btnSaveTcItem.addEventListener('click', () => {
        const id = document.getElementById('input-tc-id').value || ('tc-' + Date.now());
        const name = document.getElementById('input-tc-name').value.trim();
        const fullName = document.getElementById('input-tc-fullname').value.trim();
        const category = document.getElementById('input-tc-category').value;
        const role = document.getElementById('input-tc-role').value.trim();
        const subject = document.getElementById('input-tc-subject').value.trim();
        const ttl = document.getElementById('input-tc-ttl').value.trim();
        const src = document.getElementById('input-tc-photo').value.trim();
        if (!fullName || !subject) {
          alert('Mohon lengkapi nama bergelar dan mata pelajaran!');
          return;
        }
        const obj = { id, name, fullName, birthPlaceDate: ttl, role, position: role, subject, category, photo: { src, alt: `Foto ${fullName}`, width: 765, height: 1024 } };
        if (editingTcIdx >= 0) {
          teachersState[editingTcIdx] = obj;
        } else {
          teachersState.push(obj);
        }
        modalTc.style.display = 'none';
        renderTeacherList();
      });
    }

    // CRUD Kalender
    const evContainer = document.getElementById('event-list-container');
    const modalEv = document.getElementById('modal-event');
    let editingEvIdx = -1;

    function renderEventsList() {
      if (!evContainer) return;
      evContainer.innerHTML = '';
      eventsState.forEach((ev, idx) => {
        const item = document.createElement('div');
        item.className = 'event-admin-item';
        item.innerHTML = `
          <div class="event-date-box">
            <strong>${ev.date}</strong>
            <span class="ev-cat-pill cat-${ev.categoryClass || 'academic'}">${ev.category}</span>
          </div>
          <div class="event-info-col">
            <h4>${ev.title}</h4>
            <p>${ev.description}</p>
            <small>Mulai: ${ev.startDate} s.d. ${ev.endDate}</small>
          </div>
          <div class="event-actions">
            <button type="button" class="btn-action-edit btn-edit-ev-item" data-idx="${idx}" title="Edit Agenda">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
              <span>Edit</span>
            </button>
            <button type="button" class="btn-action-delete btn-delete-ev-item" data-idx="${idx}" title="Hapus Agenda">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus</span>
            </button>
          </div>
        `;
        evContainer.appendChild(item);
      });

      document.querySelectorAll('.btn-edit-ev-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          editingEvIdx = idx;
          const ev = eventsState[idx];
          document.getElementById('modal-ev-title').textContent = 'Edit Agenda Kalender';
          document.getElementById('input-ev-id').value = ev.id;
          document.getElementById('input-ev-title-val').value = ev.title;
          document.getElementById('input-ev-date-label').value = ev.date;
          document.getElementById('input-ev-cat').value = `${ev.category}|${ev.categoryClass || 'academic'}`;
          document.getElementById('input-ev-start').value = ev.startDate;
          document.getElementById('input-ev-end').value = ev.endDate;
          document.getElementById('input-ev-desc').value = ev.description;
          modalEv.style.display = 'block';
          modalEv.scrollIntoView({ behavior: 'smooth' });
        });
      });

      document.querySelectorAll('.btn-delete-ev-item').forEach(b => {
        b.addEventListener('click', () => {
          const idx = parseInt(b.getAttribute('data-idx'), 10);
          const item = eventsState[idx];
          if (!item) return;
          const msg = `Apakah Anda yakin ingin menghapus agenda "${item.title}"?`;
          if (typeof window.confirmDelete === 'function') {
            window.confirmDelete(msg, () => {
              eventsState.splice(idx, 1);
              renderEventsList();
            });
          } else if (confirm(msg)) {
            eventsState.splice(idx, 1);
            renderEventsList();
          }
        });
      });
    }

    const btnAddEv = document.getElementById('btn-add-event');
    if (btnAddEv) {
      btnAddEv.addEventListener('click', () => {
        editingEvIdx = -1;
        document.getElementById('modal-ev-title').textContent = 'Tambah Agenda Baru';
        document.getElementById('input-ev-id').value = 'kal-' + Date.now();
        document.getElementById('input-ev-title-val').value = '';
        document.getElementById('input-ev-date-label').value = '';
        document.getElementById('input-ev-start').value = '';
        document.getElementById('input-ev-end').value = '';
        document.getElementById('input-ev-desc').value = '';
        modalEv.style.display = 'block';
        modalEv.scrollIntoView({ behavior: 'smooth' });
      });
    }

    const btnCancelEv = document.getElementById('btn-cancel-ev');
    if (btnCancelEv) btnCancelEv.addEventListener('click', () => { modalEv.style.display = 'none'; });

    const btnSaveEvItem = document.getElementById('btn-save-ev-item');
    if (btnSaveEvItem) {
      btnSaveEvItem.addEventListener('click', () => {
        const id = document.getElementById('input-ev-id').value || ('kal-' + Date.now());
        const title = document.getElementById('input-ev-title-val').value.trim();
        const date = document.getElementById('input-ev-date-label').value.trim();
        const catVal = document.getElementById('input-ev-cat').value.split('|');
        const category = catVal[0];
        const categoryClass = catVal[1] || 'academic';
        const startDate = document.getElementById('input-ev-start').value;
        const endDate = document.getElementById('input-ev-end').value;
        const description = document.getElementById('input-ev-desc').value.trim();
        if (!title || !date) {
          alert('Mohon lengkapi judul agenda dan tampilan tanggal!');
          return;
        }
        const obj = { id, title, date, category, categoryClass, startDate, endDate, description };
        if (editingEvIdx >= 0) {
          eventsState[editingEvIdx] = obj;
        } else {
          eventsState.push(obj);
        }
        modalEv.style.display = 'none';
        renderEventsList();
      });
    }

    // Save All Akademik
    function handleSaveAkademik() {
      const payload = {
        updatedAt: new Date().toISOString(),
        system: document.getElementById('input-kurikulum-system')?.value || '',
        description: document.getElementById('input-kurikulum-desc')?.value || '',
        p5pra: {
          title: document.getElementById('input-p5pra-title')?.value || '',
          description: document.getElementById('input-p5pra-desc')?.value || ''
        },
        subjects: subjectState,
        programs: programsState,
        achievements: achievementsState,
        teachers: teachersState,
        events: eventsState
      };

      localStorage.setItem('mts_cms_akademik_data', JSON.stringify(payload));

      const toast = document.getElementById('save-toast');
      if (toast) {
        toast.hidden = false;
        toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    const btnSave1 = document.getElementById('btn-save-akademik');
    const btnSave2 = document.getElementById('btn-save-akademik-side');
    if (btnSave1) btnSave1.addEventListener('click', handleSaveAkademik);
    if (btnSave2) btnSave2.addEventListener('click', handleSaveAkademik);

    const toastClose = document.getElementById('toast-close');
    if (toastClose) toastClose.addEventListener('click', () => { document.getElementById('save-toast').hidden = true; });

    // Export JSON
    const btnExport = document.getElementById('btn-export-akademik-json');
    if (btnExport) {
      btnExport.addEventListener('click', () => {
        const saved = localStorage.getItem('mts_cms_akademik_data');
        const dataObj = saved ? JSON.parse(saved) : { subjects: subjectState, programs: programsState, achievements: achievementsState, teachers: teachersState, events: eventsState };
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(dataObj, null, 2));
        const a = document.createElement('a');
        a.setAttribute('href', dataStr);
        a.setAttribute('download', `akademik-cms-${new Date().toISOString().split('T')[0]}.json`);
        document.body.appendChild(a);
        a.click();
        a.remove();
      });
    }

    // Initial render
    renderSubjectList();
    renderProgramsList();
    renderPrestasiList();
    renderTeacherList();
    renderEventsList();
    syncAkademikPreview();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAkademik);
  } else {
    initAkademik();
  }
</script>
