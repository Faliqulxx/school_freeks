---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import kurikulumData from '../../data/kurikulum.json';
import programUnggulanData from '../../data/programUnggulan.json';
import prestasiData from '../../data/prestasi.json';
import guruData from '../../data/guru.json';
import kalenderData from '../../data/kalender.json';

const { system, description: kurikulumDesc, subjectGroups, p5pra } = kurikulumData;
const { programs } = programUnggulanData;
const { achievements } = prestasiData;
const { teachers } = guruData;
const { events } = kalenderData;
---

<AdminLayout title="Manajemen Akademik & Guru (Modul 4)" activeMenu="akademik">
  <div class="page-header-wrap">
    <div>
      <div class="module-tag">MODUL 4 DARI 8</div>
      <h1>Manajemen Akademik & Dewan Guru</h1>
      <p class="page-subtitle">
        Kelola struktur mata pelajaran, kurikulum terpadu, program unggulan Sekolah, direktori dewan guru & tendik, arsip prestasi siswa, dan agenda kalender akademik.
      </p>
    </div>

    <div class="header-action-group">
      <a href="/akademik/kurikulum" target="_blank" class="btn btn-secondary">
        <Icon name="external-link" size={16} />
        <span>Buka Web Publik</span>
      </a>
      <button type="button" id="btn-export-akademik-json" class="btn btn-secondary">
        <Icon name="download" size={16} />
        <span>Unduh JSON</span>
      </button>
      <button type="button" id="btn-save-akademik" class="btn btn-primary">
        <Icon name="check" size={18} />
        <span>Simpan Perubahan</span>
      </button>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="save-toast" class="toast-notification" role="alert" aria-live="polite" hidden>
    <Icon name="check-circle" size={20} class="toast-icon" />
    <div class="toast-body">
      <strong>Perubahan Akademik Berhasil Disimpan!</strong>
      <p>Data kurikulum, program, prestasi, guru, dan kalender telah tersimpan secara lokal di browser Anda.</p>
    </div>
    <button type="button" id="toast-close" class="toast-close-btn" aria-label="Tutup notifikasi">
      <Icon name="x" size={16} />
    </button>
  </div>

  <!-- Sub-Modul Tab Navigation -->
  <div class="section-tabs-bar" role="tablist">
    <button type="button" class="tab-btn active" data-tab="tab-kurikulum" role="tab" aria-selected="true">
      <Icon name="book-open" size={16} />
      <span>1. Kurikulum & Mapel</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-program" role="tab" aria-selected="false">
      <Icon name="award" size={16} />
      <span>2. Program Unggulan</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-prestasi" role="tab" aria-selected="false">
      <Icon name="medal" size={16} />
      <span>3. Prestasi Siswa</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-guru" role="tab" aria-selected="false">
      <Icon name="users" size={16} />
      <span>4. Dewan Guru & Tendik</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-kalender" role="tab" aria-selected="false">
      <Icon name="calendar" size={16} />
      <span>5. Kalender Akademik</span>
    </button>
  </div>

  <div class="akademik-layout-grid">
    <!-- Left Column: Forms -->
    <div class="form-container">
      <form id="akademik-form" onsubmit="return false;">

        <!-- ========================================== -->
        <!-- SUB-MODUL 1: KURIKULUM & MAPEL -->
        <!-- ========================================== -->
        <div class="tab-panel active" id="tab-kurikulum">
          <div class="form-card card">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="book-open" size={20} />
              </div>
              <div>
                <h3>Sistem & Kerangka Kurikulum</h3>
                <p class="card-desc">Integrasi Kurikulum Merdeka Kemendikbud dan Kurikulum Keagamaan Kemenag RI.</p>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group col-span-2">
                <label for="input-kurikulum-system">Nama Sistem Kurikulum <span class="req">*</span></label>
                <input
                  type="text"
                  id="input-kurikulum-system"
                  value={system}
                  required
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-kurikulum-desc">Deskripsi Integrasi Pembelajaran <span class="req">*</span></label>
                <textarea
                  id="input-kurikulum-desc"
                  rows="3"
                  required
                  class="form-control"
                >{kurikulumDesc}</textarea>
              </div>

              <div class="form-group col-span-2">
                <label for="input-p5pra-title">Judul Projek Kokurikuler (P5-PPRA)</label>
                <input
                  type="text"
                  id="input-p5pra-title"
                  value={p5pra.title}
                  class="form-control"
                />
              </div>

              <div class="form-group col-span-2">
                <label for="input-p5pra-desc">Deskripsi Fokus Tema P5-PPRA</label>
                <textarea
                  id="input-p5pra-desc"
                  rows="2"
                  class="form-control"
                >{p5pra.description}</textarea>
              </div>
            </div>
          </div>

          <!-- CRUD Daftar Mata Pelajaran -->
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="layers" size={20} />
                </div>
                <div>
                  <h3>Struktur Mata Pelajaran (CRUD)</h3>
                  <p class="card-desc">Kelompok A (Umum & Kemenag) dan Kelompok B (Mulok & Keterampilan).</p>
                </div>
              </div>
              <button type="button" id="btn-add-subject" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Mapel</span>
              </button>
            </div>

            <!-- Subject list rendered dynamically -->
            <div class="subject-admin-list" id="subject-list-container">
              {subjectGroups.flatMap(g => g.subjects.map(s => ({ ...s, group: g.group }))).map((sub, idx) => (
                <div class="subject-admin-item" data-idx={idx}>
                  <div class="sub-code-tag">{sub.code}</div>
                  <div class="sub-info-col">
                    <strong>{sub.name}</strong>
                    <span class="sub-group-label">{sub.group}</span>
                    <p class="sub-desc-text">{sub.description}</p>
                  </div>
                  <div class="sub-hours-badge">{sub.hours} JP</div>
                  <div class="sub-actions">
                    <button type="button" class="btn-action-edit btn-edit-sub-item" data-idx={idx} title="Edit Mapel">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-sub-item" data-idx={idx} title="Hapus Mapel">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Mapel -->
          <div class="form-card card" id="modal-subject" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-sub-title">Tambah / Edit Mata Pelajaran</h3>
                <p class="card-desc">Lengkapi kode mapel, nama pelajaran, alokasi jam pelajaran, dan uraian materi.</p>
              </div>
            </div>
            <div class="form-grid">
              <div class="form-group">
                <label for="input-sub-code">Kode Mapel (3-4 Huruf) <span class="req">*</span></label>
                <input type="text" id="input-sub-code" placeholder="Contoh: IPA / MAT" class="form-control" style="text-transform: uppercase;" />
              </div>
              <div class="form-group">
                <label for="input-sub-name">Nama Mata Pelajaran <span class="req">*</span></label>
                <input type="text" id="input-sub-name" placeholder="Contoh: Ilmu Pengetahuan Alam" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-sub-group">Kelompok Kurikulum <span class="req">*</span></label>
                <select id="input-sub-group" class="form-control">
                  <option value="Kelompok A (Umum & Keagamaan Kemenag)">Kelompok A (Umum & Keagamaan Kemenag)</option>
                  <option value="Kelompok B (Keterampilan & Muatan Lokal)">Kelompok B (Keterampilan & Muatan Lokal)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-sub-hours">Alokasi Jam Pelajaran (JP) <span class="req">*</span></label>
                <input type="number" id="input-sub-hours" min="1" max="10" placeholder="Contoh: 4" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-sub-desc">Uraian Ringkas Materi <span class="req">*</span></label>
                <input type="text" id="input-sub-desc" placeholder="Capaian pembelajaran dan topik pokok..." class="form-control" />
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-sub" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-sub-item" class="btn btn-primary">Simpan Mapel</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 2: PROGRAM UNGGULAN -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-program">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="award" size={20} />
                </div>
                <div>
                  <h3>Program Unggulan Sekolah (CRUD)</h3>
                  <p class="card-desc">Program unggulan pembentuk karakter, tahfidz, bahasa asing, sains terapan, dan literasi.</p>
                </div>
              </div>
              <button type="button" id="btn-add-program" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Program</span>
              </button>
            </div>

            <div class="programs-admin-list" id="program-list-container">
              {programs.map((p, idx) => (
                <div class="program-admin-card" data-idx={idx}>
                  <div class="prog-thumb-wrap">
                    <img src={p.image.src} alt={p.title} class="prog-admin-thumb" onerror="this.src='/assets/hero-siswa-belajar.webp'" />
                  </div>
                  <div class="prog-admin-content">
                    <div class="prog-admin-header-row">
                      <h4>{p.title}</h4>
                      <span class="prog-admin-mentor">Pembina: {p.mentor}</span>
                    </div>
                    <p class="prog-admin-summary">{p.summary}</p>
                    <div class="prog-admin-meta">
                      <span class="prog-meta-badge">
                        <Icon name="clock" size={13} />
                        <span>{p.schedule}</span>
                      </span>
                    </div>
                  </div>
                  <div class="prog-item-actions">
                    <button type="button" class="btn-action-edit btn-edit-p" data-idx={idx} title="Edit Program">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-p" data-idx={idx} title="Hapus Program">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Program -->
          <div class="form-card card" id="modal-program" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-prog-title">Tambah / Edit Program Unggulan</h3>
                <p class="card-desc">Atur nama program, pembina (Sekolah Contoh), jadwal rutin, dan foto dokumentasi.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-prog-id" value="" />
              <div class="form-group">
                <label for="input-prog-title-val">Judul Program <span class="req">*</span></label>
                <input type="text" id="input-prog-title-val" placeholder="Contoh: Tahfidz Juz 30" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-prog-mentor">Pembina / Mentor <span class="req">*</span></label>
                <input type="text" id="input-prog-mentor" value="Sekolah Contoh" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-prog-schedule">Jadwal Pelaksanaan <span class="req">*</span></label>
                <input type="text" id="input-prog-schedule" placeholder="Contoh: Kelas VII–IX, Senin/Rabu/Kamis pukul 06.30 WIB" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-prog-summary">Ringkasan Singkat (Tampil di Kartu) <span class="req">*</span></label>
                <input type="text" id="input-prog-summary" placeholder="Deskripsi ringkas 1 kalimat..." class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-prog-desc">Deskripsi Lengkap Program <span class="req">*</span></label>
                <textarea id="input-prog-desc" rows="3" class="form-control" placeholder="Uraian metode bimbingan dan target capaian siswa..."></textarea>
              </div>
              <div class="form-group col-span-2">
                <label for="input-prog-img">Foto Dokumentasi Program (WebP) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-prog"
                    src="/assets/program-unggulan-tahfidz.webp"
                    alt="Pratinjau Program"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-prog-img" value="/assets/program-unggulan-tahfidz.webp" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Program</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-prog-img" data-target-preview="img-prev-prog" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-prog" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-prog-item" class="btn btn-primary">Simpan Program</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 3: PRESTASI SISWA -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-prestasi">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="medal" size={20} />
                </div>
                <div>
                  <h3>Direktori Prestasi Siswa (CRUD)</h3>
                  <p class="card-desc">Arsip medali, kejuaraan sains, seni kaligrafi, tilawah, dan olahraga santri.</p>
                </div>
              </div>
              <button type="button" id="btn-add-prestasi" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Prestasi</span>
              </button>
            </div>

            <div class="prestasi-admin-grid" id="prestasi-list-container">
              {achievements.map((ach, idx) => (
                <div class="prestasi-admin-card" data-idx={idx}>
                  <div class="prestasi-thumb-wrap">
                    <img src={ach.image.src} alt={ach.title} class="prestasi-thumb" onerror="this.src='/assets/berita-prestasi-sains.webp'" />
                  </div>
                  <div class="prestasi-body">
                    <div class="prestasi-badges-row">
                      <span class="level-chip">{ach.level}</span>
                      <span class="year-chip">{ach.year}</span>
                    </div>
                    <h4>{ach.title}</h4>
                    <p class="student-name">Peraih: <strong>{ach.student}</strong></p>
                    <p class="organizer-name">Penyelenggara: {ach.organizer}</p>
                    <div class="prestasi-card-actions">
                      <button type="button" class="btn-action-edit btn-edit-ach-item" data-idx={idx} title="Edit Prestasi">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-ach-item" data-idx={idx} title="Hapus Prestasi">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Prestasi -->
          <div class="form-card card" id="modal-prestasi" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-ach-title">Tambah / Edit Prestasi Siswa</h3>
                <p class="card-desc">Lengkapi nama kompetisi, peraih juara, tingkat, dan penyelenggara.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-ach-id" value="" />
              <div class="form-group">
                <label for="input-ach-title-val">Judul Kejuaraan <span class="req">*</span></label>
                <input type="text" id="input-ach-title-val" placeholder="Contoh: Juara 1 Olimpiade Sains" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ach-student">Nama Siswa / Tim Peraih <span class="req">*</span></label>
                <input type="text" id="input-ach-student" placeholder="Contoh: Aisyah Zahra (Kelas VIII)" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ach-level">Tingkat Kejuaraan <span class="req">*</span></label>
                <select id="input-ach-level" class="form-control">
                  <option value="Kecamatan">Tingkat Kecamatan</option>
                  <option value="Kabupaten">Tingkat Kabupaten</option>
                  <option value="Provinsi">Tingkat Provinsi</option>
                  <option value="Nasional">Tingkat Nasional</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-ach-year">Tahun Perolehan <span class="req">*</span></label>
                <input type="number" id="input-ach-year" value="2026" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-ach-organizer">Penyelenggara Kegiatan <span class="req">*</span></label>
                <input type="text" id="input-ach-organizer" placeholder="Contoh: MGMP IPA Kab. Gresik / Kemenag Jatim" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-ach-img">Foto Piala / Piagam / Prestasi (WebP) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-ach"
                    src="/assets/berita-prestasi-sains.webp"
                    alt="Pratinjau Prestasi"
                    class="asset-thumb-wide"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-ach-img" value="/assets/berita-prestasi-sains.webp" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Prestasi</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-ach-img" data-target-preview="img-prev-ach" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-ach" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-ach-item" class="btn btn-primary">Simpan Prestasi</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 4: DEWAN GURU & TENDIK -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-guru">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="users" size={20} />
                </div>
                <div>
                  <h3>Dewan Guru & Tenaga Kependidikan (CRUD)</h3>
                  <p class="card-desc">Kelola profil asatidz, mata pelajaran yang diampu, kualifikasi, dan foto formal.</p>
                </div>
              </div>
              <button type="button" id="btn-add-teacher" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Guru / Tendik</span>
              </button>
            </div>

            <div class="teachers-admin-grid" id="teacher-list-container">
              {teachers.map((tc, idx) => (
                <div class="teacher-admin-card" data-idx={idx}>
                  <div class="teacher-thumb-wrap">
                    <img src={tc.photo.src} alt={tc.fullName} class="teacher-thumb" onerror="this.src='/assets/guru-freeks.webp'" />
                  </div>
                  <div class="teacher-body">
                    <span class="cat-pill">{tc.category}</span>
                    <h4>{tc.fullName}</h4>
                    <p class="teacher-subject">Mapel: <strong>{tc.subject}</strong></p>
                    <p class="teacher-pos">{tc.position}</p>
                    <small class="teacher-ttl">{tc.birthPlaceDate}</small>
                    <div class="teacher-card-actions">
                      <button type="button" class="btn-action-edit btn-edit-tc-item" data-idx={idx} title="Edit Guru">
                        <Icon name="edit" size={14} />
                        <span>Edit</span>
                      </button>
                      <button type="button" class="btn-action-delete btn-delete-tc-item" data-idx={idx} title="Hapus Guru">
                        <Icon name="trash-2" size={14} />
                        <span>Hapus</span>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Guru -->
          <div class="form-card card" id="modal-teacher" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-tc-title">Tambah / Edit Guru & Tendik</h3>
                <p class="card-desc">Pastikan nama lengkap bergelar dan nama panggilan Sekolah Contoh sesuai panduan branding.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-tc-id" value="" />
              <div class="form-group">
                <label for="input-tc-name">Nama Panggilan / Brand <span class="req">*</span></label>
                <input type="text" id="input-tc-name" value="Sekolah Contoh" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-tc-fullname">Nama Lengkap + Gelar Resmi <span class="req">*</span></label>
                <input type="text" id="input-tc-fullname" placeholder="Contoh: Sekolah Contoh, S.Pd.I., M.Pd." class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-tc-category">Kategori Departemen <span class="req">*</span></label>
                <select id="input-tc-category" class="form-control">
                  <option value="Pimpinan">Pimpinan</option>
                  <option value="Kurikulum">Kurikulum</option>
                  <option value="Kesiswaan">Kesiswaan</option>
                  <option value="Mata Pelajaran">Mata Pelajaran</option>
                  <option value="Keagamaan">Keagamaan & Tahfidz</option>
                  <option value="Tata Usaha">Tata Usaha & Administrasi</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-tc-role">Jabatan Struktural <span class="req">*</span></label>
                <input type="text" id="input-tc-role" placeholder="Contoh: Waka Kurikulum / Guru Mapel" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-tc-subject">Mata Pelajaran / Tugas Pokok <span class="req">*</span></label>
                <input type="text" id="input-tc-subject" placeholder="Contoh: Matematika / IPA" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-tc-ttl">Tempat & Tanggal Lahir <span class="req">*</span></label>
                <input type="text" id="input-tc-ttl" placeholder="Contoh: Gresik, 14 Mei 1988" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-tc-photo">Foto Formal Guru & Staf (WebP) <span class="req">*</span></label>
                <div class="asset-preview-row">
                  <img
                    id="img-prev-tc"
                    src="/assets/guru-freeks.webp"
                    alt="Pratinjau Guru"
                    class="asset-thumb-leader"
                  />
                  <div class="asset-details">
                    <input type="text" id="input-tc-photo" value="/assets/guru-freeks.webp" class="form-control" />
                    <div class="asset-upload-bar">
                      <label class="btn-upload-file">
                        <Icon name="upload" size={13} />
                        <span>Unggah Foto Guru</span>
                        <input type="file" accept="image/*" class="asset-file-uploader" data-target-input="input-tc-photo" data-target-preview="img-prev-tc" style="display: none;" />
                      </label>
                      <span class="upload-file-status"></span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-tc" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-tc-item" class="btn btn-primary">Simpan Profil Guru</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- SUB-MODUL 5: KALENDER AKADEMIK -->
        <!-- ========================================== -->
        <div class="tab-panel" id="tab-kalender">
          <div class="form-card card">
            <div class="card-header justify-between">
              <div class="header-icon-title">
                <div class="header-icon-wrap">
                  <Icon name="calendar" size={20} />
                </div>
                <div>
                  <h3>Agenda Kalender Akademik (CRUD)</h3>
                  <p class="card-desc">Jadwal ujian tengah semester, libur Sekolah, awal semester, dan gelombang PPDB.</p>
                </div>
              </div>
              <button type="button" id="btn-add-event" class="btn btn-primary btn-sm">
                <Icon name="plus" size={16} />
                <span>Tambah Agenda</span>
              </button>
            </div>

            <div class="events-admin-list" id="event-list-container">
              {events.map((ev, idx) => (
                <div class="event-admin-item" data-idx={idx}>
                  <div class="event-date-box">
                    <strong>{ev.date}</strong>
                    <span class={`ev-cat-pill cat-${ev.categoryClass}`}>{ev.category}</span>
                  </div>
                  <div class="event-info-col">
                    <h4>{ev.title}</h4>
                    <p>{ev.description}</p>
                    <small>Mulai: {ev.startDate} s.d. {ev.endDate}</small>
                  </div>
                  <div class="event-actions">
                    <button type="button" class="btn-action-edit btn-edit-ev-item" data-idx={idx} title="Edit Agenda">
                      <Icon name="edit" size={14} />
                      <span>Edit</span>
                    </button>
                    <button type="button" class="btn-action-delete btn-delete-ev-item" data-idx={idx} title="Hapus Agenda">
                      <Icon name="trash-2" size={14} />
                      <span>Hapus</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Modal Edit Event -->
          <div class="form-card card" id="modal-event" style="display: none; border-color: var(--admin-green-500); background-color: var(--admin-green-50);">
            <div class="card-header">
              <div class="header-icon-wrap">
                <Icon name="edit" size={20} />
              </div>
              <div>
                <h3 id="modal-ev-title">Tambah / Edit Agenda Kalender</h3>
                <p class="card-desc">Atur rentang tanggal, kategori (Ujian/Libur/Akademik/PPDB), dan deskripsi agenda.</p>
              </div>
            </div>
            <div class="form-grid">
              <input type="hidden" id="input-ev-id" value="" />
              <div class="form-group col-span-2">
                <label for="input-ev-title-val">Nama Agenda Kegiatan <span class="req">*</span></label>
                <input type="text" id="input-ev-title-val" placeholder="Contoh: Penilaian Tengah Semester (PTS) Ganjil" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ev-date-label">Teks Tampilan Tanggal <span class="req">*</span></label>
                <input type="text" id="input-ev-date-label" placeholder="Contoh: 26 Okt – 6 Nov 2026" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ev-cat">Kategori Agenda <span class="req">*</span></label>
                <select id="input-ev-cat" class="form-control">
                  <option value="Ujian|exam">Ujian (PTS/PAS)</option>
                  <option value="Kegiatan|activity">Kegiatan Siswa</option>
                  <option value="Libur|holiday">Libur Semester</option>
                  <option value="Akademik|academic">Akademik Umum</option>
                  <option value="PPDB|ppdb">PPDB Online</option>
                </select>
              </div>
              <div class="form-group">
                <label for="input-ev-start">Tanggal Mulai (YYYY-MM-DD) <span class="req">*</span></label>
                <input type="date" id="input-ev-start" class="form-control" />
              </div>
              <div class="form-group">
                <label for="input-ev-end">Tanggal Selesai (YYYY-MM-DD) <span class="req">*</span></label>
                <input type="date" id="input-ev-end" class="form-control" />
              </div>
              <div class="form-group col-span-2">
                <label for="input-ev-desc">Deskripsi Agenda <span class="req">*</span></label>
                <textarea id="input-ev-desc" rows="2" class="form-control" placeholder="Keterangan pelaksanaan ujian atau kegiatan..."></textarea>
              </div>
              <div class="col-span-2 form-actions-row">
                <button type="button" id="btn-cancel-ev" class="btn btn-secondary">Batal</button>
                <button type="button" id="btn-save-ev-item" class="btn btn-primary">Simpan Agenda</button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>

    <!-- Right Column: Interactive Live Preview -->
    <aside class="preview-container">
      <div class="preview-sticky-wrap">
        <div class="card preview-card">
          <div class="card-header-sm">
            <div class="flex-align-center gap-2">
              <Icon name="eye" size={18} />
              <h4>Pratinjau Akademik</h4>
            </div>
            <div class="preview-mode-pills" id="akademik-preview-pills">
              <button type="button" class="pill-btn active" data-mode="kurikulum">Kurikulum</button>
              <button type="button" class="pill-btn" data-mode="program">Program</button>
              <button type="button" class="pill-btn" data-mode="prestasi">Prestasi</button>
              <button type="button" class="pill-btn" data-mode="guru">Guru</button>
            </div>
          </div>

          <!-- Preview 1: Kurikulum -->
          <div id="sim-ak-kurikulum" class="sim-ak-view active">
            <div class="sim-kurikulum-box">
              <span class="sim-tag-green">Kerangka Kurikulum</span>
              <h4 id="sim-kur-system">{system}</h4>
              <p id="sim-kur-desc" class="sim-desc">{kurikulumDesc}</p>
              <div class="sim-mapel-preview">
                <small>Contoh Mata Pelajaran Teratas:</small>
                <div class="sim-mapel-row">
                  <strong id="sim-first-mapel-name">{subjectGroups[0].subjects[0].name}</strong>
                  <span id="sim-first-mapel-hours" class="sim-jp">{subjectGroups[0].subjects[0].hours} JP</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Preview 2: Program Unggulan -->
          <div id="sim-ak-program" class="sim-ak-view" style="display: none;">
            <div class="sim-program-card">
              <img id="sim-prog-img" src={programs[0].image.src} alt={programs[0].title} class="sim-prog-thumb" />
              <div class="sim-prog-body">
                <span class="sim-prog-chip">Program Inti</span>
                <h4 id="sim-prog-title">{programs[0].title}</h4>
                <p id="sim-prog-summary">{programs[0].summary}</p>
                <div class="sim-prog-footer">
                  <small id="sim-prog-mentor">Pembina: {programs[0].mentor}</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Preview 3: Prestasi -->
          <div id="sim-ak-prestasi" class="sim-ak-view" style="display: none;">
            <div class="sim-prestasi-box">
              <span class="sim-trophy-badge">🏆 Juara Terverifikasi</span>
              <h4 id="sim-ach-title">{achievements[0].title}</h4>
              <p id="sim-ach-student">Peraih: <strong>{achievements[0].student}</strong></p>
              <small id="sim-ach-level">Tingkat {achievements[0].level} ({achievements[0].year})</small>
            </div>
          </div>

          <!-- Preview 4: Dewan Guru -->
          <div id="sim-ak-guru" class="sim-ak-view" style="display: none;">
            <div class="sim-guru-card">
              <img src="/assets/guru-freeks.webp" alt="Foto Guru" class="sim-guru-photo" />
              <div>
                <span class="sim-role-pill">Pimpinan</span>
                <h4 id="sim-tc-name">{teachers[0].fullName}</h4>
                <p id="sim-tc-sub">{teachers[0].subject}</p>
              </div>
            </div>
          </div>

          <div class="preview-footer-action">
            <button type="button" id="btn-save-akademik-side" class="btn btn-primary btn-block">
              <Icon name="check" size={18} />
              <span>Simpan Perubahan Akademik</span>
            </button>
          </div>
        </div>
      </div>
    </aside>
  </div>
</AdminLayout>

<style>
  .page-header-wrap {
