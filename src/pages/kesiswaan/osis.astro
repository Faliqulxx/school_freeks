---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import kesiswaanData from '../../data/kesiswaan.json';

const { osis } = kesiswaanData;

const breadcrumbItems = [
  { label: 'Kesiswaan', href: '/kesiswaan/ekstrakurikuler' },
  { label: 'Organisasi Siswa (OSIS)' }
];
---

<BaseLayout
  title="Student Council Sekolah Contoh – Periode 2026/2027"
  description="Struktur pengurus, program kerja divisi teknologi, media kreatif, olahraga, dan sosial Student Council Sekolah Contoh Indonesia."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">{osis.period} • {osis.cabinet}</span>
      </div>
      <h1 class="page-title">Student Council (OSIS) Sekolah Contoh</h1>
      <p class="page-description">
        Kawah kepemimpinan siswa dalam belajar manajemen tim, menyelenggarakan inisiatif inovasi, dan menggerakkan komunitas kesiswaan sekolah.
      </p>
    </div>
  </div>

  <div class="container-wide section">
    <!-- Inti Pengurus -->
    <section class="section-block">
      <div class="section-header">
        <h2>Badan Pengurus Harian (BPH) OSIS</h2>
        <div class="section-divider"></div>
      </div>

      <div class="bph-grid">
        {osis.structure.map((item) => (
          <div class="bph-card card">
            <div class="bph-icon-wrap">
              <Icon name="shield-check" size={24} />
            </div>
            <div>
              <span class="bph-role">{item.role}</span>
              <h3 class="bph-name">{item.name}</h3>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Departemen & Program Kerja -->
    <section class="section-block">
      <div class="section-header">
        <h2>Departemen & Rencana Aksi Program Kerja</h2>
        <div class="section-divider"></div>
        <p>Empat pilar program kerja yang berfokus pada keteladanan siswa, kebersihan lingkungan, dan kreativitas:</p>
      </div>

      <div class="departments-grid">
        {osis.departments.map((dept, idx) => (
          <div class="dept-card card">
            <div class="dept-header">
              <span class="dept-index">Pilar 0{idx + 1}</span>
              <h3 class="dept-title">{dept.name}</h3>
            </div>
            <div class="card-body">
              <h4 class="prog-title">Fokus Program:</h4>
              <p class="prog-desc">{dept.programs}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
  }

  .section-block {
    margin-bottom: var(--s-7);
  }

  /* BPH Grid: 1 col on mobile, 2 cols on tablet, 4 cols on desktop */
  .bph-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 641px) {
    .bph-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media (min-width: 1024px) {
    .bph-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bph-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    min-width: 0;
  }

  .bph-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background-color: var(--green-50);
    color: var(--green-700);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bph-role {
    display: block;
    font-size: var(--text-xs);
    color: var(--green-700);
    font-weight: 700;
    text-transform: uppercase;
  }

  .bph-name {
    font-size: 1.05rem;
    color: var(--green-900);
    margin: 2px 0 0 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Departments Grid: 1 col on mobile, 2 cols on tablet, 3 cols on desktop */
  .departments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 641px) {
    .departments-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 1024px) {
    .departments-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .dept-card {
    background-color: #FFFFFF;
    min-width: 0;
  }

  .dept-header {
    background-color: var(--green-50);
    padding: 12px 16px;
    border-bottom: 1px solid var(--green-200);
  }

  .dept-index {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: var(--green-700);
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .dept-title {
    font-size: 1.1rem;
    color: var(--green-900);
    margin: 0;
    overflow-wrap: break-word;
  }

  .card-body {
    padding: 14px 16px;
    min-width: 0;
  }

  .prog-title {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-600);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .prog-desc {
    font-size: var(--text-sm);
    color: var(--ink-900);
    line-height: 1.6;
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>

