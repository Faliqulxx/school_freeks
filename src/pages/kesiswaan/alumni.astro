---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import kesiswaanData from '../../data/kesiswaan.json';

const { alumni } = kesiswaanData;

const breadcrumbItems = [
  { label: 'Kesiswaan', href: '/kesiswaan/ekstrakurikuler' },
  { label: 'Keluarga Alumni' }
];
---

<BaseLayout
  title="Alumni Sekolah Contoh – Jejak Kiprah Inovator"
  description="Kisah inspiratif kiprah alumni Sekolah Contoh Indonesia dan formulir jejaring pendataan alumni."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">{alumni.totalRegistered}+ Alumni Terdata</span>
      </div>
      <h1 class="page-title">Kiprah & Jalinan Alumni</h1>
      <p class="page-description">
        Menghubungkan generasi talenta lulusan Sekolah Contoh Indonesia yang kini berkiprah di bidang teknologi, industri kreatif, startup, dan akademisi.
      </p>
    </div>
  </div>

  <div class="container-wide section">
    <div class="alumni-layout-grid">
      <!-- Kolom Cerita Alumni (PRD 8.4) -->
      <div class="alumni-stories-col">
        <div class="section-header">
          <h2>Kisah Jejak Siswa</h2>
          <div class="section-divider"></div>
          <p>Bagaimana bekal computational thinking dan karakter dari FREEKS menemani perjalanan masa depan para alumni:</p>
        </div>

        <div class="stories-list">
          {alumni.stories.map((story) => (
            <div class="story-card card">
              <div class="story-header">
                <div class="alumni-avatar">
                  {story.name.charAt(0)}
                </div>
                <div>
                  <h3 class="alumni-name">{story.name}</h3>
                  <span class="alumni-year">{story.year}</span>
                  <span class="alumni-current">{story.current}</span>
                </div>
              </div>
              <blockquote class="alumni-testimony">
                "{story.testimony}"
              </blockquote>
            </div>
          ))}
        </div>
      </div>

      <!-- Kolom Formulir Pendataan Alumni (PRD 8.4) -->
      <div class="alumni-form-col">
        <div class="alumni-form-box card">
          <div class="form-box-header">
            <h3 class="form-title">Formulir Pendataan Alumni</h3>
            <p class="form-desc">Yuk perbarui data dan pererat tali silaturahmi almamater.</p>
          </div>

          <form id="alumni-data-form" class="alumni-form" onsubmit="event.preventDefault(); document.getElementById('alumni-success').hidden = false; this.reset();">
            <div class="form-group">
              <label for="alumni-name">Nama Lengkap Siswa *</label>
              <input type="text" id="alumni-name" required placeholder="Contoh: Muhammad Irfan" />
            </div>

            <div class="form-group">
              <label for="alumni-grad-year">Tahun Kelulusan / Angkatan *</label>
              <input type="number" id="alumni-grad-year" required placeholder="Contoh: 2022" min="1987" max="2026" />
            </div>

            <div class="form-group">
              <label for="alumni-phone">Nomor WhatsApp Aktif *</label>
              <input type="tel" id="alumni-phone" required placeholder="08xxxxxxxxxx" inputmode="tel" />
            </div>

            <div class="form-group">
              <label for="alumni-current-activity">Aktivitas / Profesi Saat Ini *</label>
              <input type="text" id="alumni-current-activity" required placeholder="Contoh: Mahasiswa UIN / Wiraswasta" />
            </div>

            <div class="form-group">
              <label for="alumni-city">Domisili / Kota Tinggal</label>
              <input type="text" id="alumni-city" placeholder="Contoh: Gresik / Surabaya" />
            </div>

            <div class="form-group">
              <label for="alumni-message">Pesan untuk Adik-adik Siswa</label>
              <textarea id="alumni-message" rows="3" placeholder="Tuliskan motivasi atau doa Anda..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">
              <span>Kirim Pembaruan Data Alumni</span>
              <Icon name="send" size={16} />
            </button>
          </form>

          <div id="alumni-success" class="alumni-success-msg" hidden>
            <Icon name="check-circle" size={24} class="success-icon" />
            <div>
              <strong>Terima Kasih, Data Berhasil Dikirim!</strong>
              <p>Salam hangat kami untuk seluruh alumni Sekolah Contoh Indonesia.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
  }

  .alumni-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  @media (min-width: 1024px) {
    .alumni-layout-grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--s-7);
    }
  }

  /* Stories List: 1 col on mobile, 2 cols on tablet, column on desktop */
  .stories-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 641px) {
    .stories-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media (min-width: 1024px) {
    .stories-list {
      display: flex;
      flex-direction: column;
      gap: var(--s-5);
    }
  }

  .story-card {
    padding: var(--s-5);
    min-width: 0;
  }

  @media (max-width: 640px) {
    .story-card {
      padding: 16px;
    }
  }

  .story-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--s-3);
    min-width: 0;
  }

  .alumni-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--green-700);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .alumni-name {
    font-size: 1.05rem;
    color: var(--green-900);
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .alumni-year {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-700);
    display: inline-block;
    margin-right: 8px;
  }

  .alumni-current {
    font-size: var(--text-xs);
    color: var(--ink-600);
    overflow-wrap: break-word;
  }

  .alumni-testimony {
    font-size: var(--text-sm);
    color: var(--ink-900);
    line-height: 1.6;
    margin: 0;
    font-style: italic;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Form */
  .alumni-form-box {
    padding: var(--s-5);
    background-color: var(--bg-soft);
    min-width: 0;
  }

  @media (max-width: 640px) {
    .alumni-form-box {
      padding: 16px;
    }
  }

  .form-box-header {
    margin-bottom: var(--s-4);
  }

  .form-title {
    font-size: 1.15rem;
    color: var(--green-900);
    margin-bottom: 4px;
  }

  .form-desc {
    font-size: var(--text-xs);
    color: var(--ink-600);
    margin: 0;
  }

  .alumni-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .form-group label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-900);
  }

  .form-group input,
  .form-group textarea {
    padding: 10px 14px;
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-sm);
    font-size: 16px; /* Cegah auto zoom iOS */
    background-color: #FFFFFF;
    color: var(--ink-900);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--green-700);
    outline: none;
  }

  .alumni-success-msg {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background-color: #ECFDF3;
    border: 1px solid #A6F4C5;
    border-radius: var(--radius-sm);
    margin-top: 16px;
    color: #027A48;
    font-size: var(--text-sm);
  }

  .alumni-success-msg[hidden] {
    display: none !important;
  }

  .alumni-success-msg p {
    font-size: var(--text-xs);
    margin: 2px 0 0 0;
  }
</style>

