---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan (404) – Sekolah Contoh Indonesia"
  description="Halaman yang Anda tuju tidak ditemukan atau telah dipindahkan."
>
  <div class="container-wide section">
    <div class="notfound-card card">
      <div class="notfound-badge">404</div>
      <h1 class="notfound-title">Halaman Tidak Ditemukan</h1>
      <p class="notfound-desc">
        Mohon maaf, tautan yang Anda buka mungkin salah ketik, sudah dipindahkan, atau tidak lagi tersedia di website Sekolah Contoh Indonesia.
      </p>

      <!-- Search bar inside 404 (PRD 8.9) -->
      <form action="/pencarian" method="GET" class="notfound-search-form">
        <Icon name="search" size={20} class="search-ico" />
        <input
          type="search"
          name="q"
          placeholder="Cari halaman, berita, atau syarat PPDB..."
          class="notfound-search-input"
          required
        />
        <button type="submit" class="btn btn-primary btn-sm">Cari</button>
      </form>

      <!-- 4 Tautan Populer (PRD 8.9: PPDB, Berita, Kontak, Beranda) -->
      <div class="popular-links-box">
        <h2 class="popular-title">Atau kunjungi halaman populer berikut:</h2>
        <div class="popular-grid">
          <a href="/ppdb" class="pop-card">
            <Icon name="user-plus" size={20} class="pop-icon" />
            <div>
              <strong>Informasi PPDB</strong>
              <span>Jadwal, syarat, dan biaya pendaftaran</span>
            </div>
          </a>

          <a href="/informasi/berita" class="pop-card">
            <Icon name="newspaper" size={20} class="pop-icon" />
            <div>
              <strong>Kabar Sekolah</strong>
              <span>Berita dan kegiatan siswa terbaru</span>
            </div>
          </a>

          <a href="/kontak" class="pop-card">
            <Icon name="map-pin" size={20} class="pop-icon" />
            <div>
              <strong>Kontak & Alamat</strong>
              <span>Lokasi sekolah dan WhatsApp admission</span>
            </div>
          </a>

          <a href="/" class="pop-card">
            <Icon name="home" size={20} class="pop-icon" />
            <div>
              <strong>Beranda Utama</strong>
              <span>Kembali ke halaman awal sekolah</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound-card {
    max-width: 760px;
    margin: var(--s-6) auto;
    padding: var(--s-7) var(--s-5);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 640px) {
    .notfound-card {
      padding: var(--s-8) var(--s-6);
    }
  }

  .notfound-badge {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 2.5rem + 3vw, 5rem);
    font-weight: 800;
    color: var(--green-700);
    line-height: 1;
    margin-bottom: var(--s-3);
  }

  .notfound-title {
    font-size: var(--h2);
    color: var(--green-900);
    margin-bottom: var(--s-3);
  }

  .notfound-desc {
    font-size: var(--text-base);
    color: var(--ink-600);
    max-width: 48ch;
    margin-bottom: var(--s-6);
  }

  .notfound-search-form {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    max-width: 480px;
    margin-bottom: var(--s-7);
    gap: 8px;
  }

  .search-ico {
    position: absolute;
    left: 14px;
    color: var(--ink-600);
  }

  .notfound-search-input {
    width: 100%;
    height: 48px;
    padding-left: 44px;
    padding-right: 14px;
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-md);
    font-size: 16px;
    color: var(--ink-900);
    background-color: #FFFFFF;
  }

  .notfound-search-input:focus {
    border-color: var(--green-700);
    outline: none;
  }

  .popular-links-box {
    width: 100%;
    border-top: 1px solid var(--ink-300);
    padding-top: var(--s-6);
    text-align: left;
  }

  .popular-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--green-900);
    margin-bottom: var(--s-4);
  }

  .popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  @media (max-width: 640px) {
    .pop-card {
      padding: 10px !important;
      gap: 8px !important;
    }
    .pop-icon-wrap {
      width: 32px !important;
      height: 32px !important;
    }
    .pop-card strong {
      font-size: 0.85rem !important;
    }
  }

  @media (min-width: 640px) {
    .popular-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }

  .pop-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background-color: var(--bg-soft);
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink-900);
    transition: background-color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease);
  }

  .pop-card:hover {
    background-color: var(--green-50);
    border-color: var(--green-700);
  }

  .pop-icon {
    color: var(--green-700);
    flex-shrink: 0;
  }

  .pop-card strong {
    display: block;
    font-size: var(--text-xs);
    color: var(--green-900);
  }

  .pop-card span {
    font-size: 11px;
    color: var(--ink-600);
  }
</style>
