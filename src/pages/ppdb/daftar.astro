    padding: 6px 14px;
    background-color: #FFFFFF;
    border: 1px solid var(--green-700);
    color: var(--green-700);
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .file-preview-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--green-900);
    font-weight: 600;
