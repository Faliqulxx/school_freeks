  .file-remove-btn {
    border: none;
    background: none;
    color: var(--danger);
    cursor: pointer;
    padding: 2px;
  }

  /* Review Box */
  .review-box {
    background-color: var(--bg-soft);
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-md);
    padding: var(--s-5);
    margin-bottom: var(--s-5);
