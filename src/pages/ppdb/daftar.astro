  }

  .reg-number {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--green-900);
    letter-spacing: 1px;
    display: block;
  }

  .reg-timestamp {
    display: block;
    font-size: 11px;
    color: var(--ink-600);
    margin-top: 4px;
  }

  .slip-data-summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--ink-300);
  }

  .slip-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .slip-label {
    color: var(--ink-600);
  }

  .slip-instructions h4 {
    font-size: var(--text-sm);
    color: var(--green-900);
    margin-bottom: 6px;
  }

  .slip-instructions ol {
    margin: 0;
    padding-left: 20px;
    font-size: var(--text-xs);
    color: var(--ink-900);
    line-height: 1.6;
  }

  .success-action-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
  }
</style>

<script>
  // PPDB Multi-Step Wizard & Autosave Controller
  const STORAGE_KEY = 'mts_ppdb_draft_v1';
  let currentStep = 1;

  const form = document.getElementById('ppdb-form') as HTMLFormElement | null;
  const panes = [
    document.getElementById('pane-step-1'),
    document.getElementById('pane-step-2'),
    document.getElementById('pane-step-3'),
    document.getElementById('pane-step-4')
  ];
  const stepIndicatorText = document.getElementById('step-indicator-text');
  const progressBar = document.getElementById('progress-bar');
  const stepPills = document.querySelectorAll('.step-nav-btn');
  const errorBox = document.getElementById('error-summary');
  const errorList = document.getElementById('error-summary-list');
  const successScreen = document.getElementById('ppdb-success-screen');
  const wizardHeader = document.getElementById('wizard-header');

  const stepTitles = [
    'Langkah 1 dari 4: Data Calon Siswa',
    'Langkah 2 dari 4: Data Orang Tua / Wali',
    'Langkah 3 dari 4: Data Asal Sekolah',
    'Langkah 4 dari 4: Unggah Berkas & Tinjau'
  ];

  // 1. Restore Autosaved Draft
  function loadDraft() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return;
      const data = JSON.parse(saved);
      Object.keys(data).forEach((key) => {
        const input = document.querySelector(`[name="${key}"]`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        if (input && input.type !== 'file') {
          input.value = data[key];
        }
      });
      updateReviewSummary();
    } catch (e) {
      // Ignored
    }
  }

  // 2. Save Draft to LocalStorage
  function saveDraft() {
    if (!form) return;
    const formData = new FormData(form);
    const obj: Record<string, string> = {};
    formData.forEach((val, key) => {
      if (typeof val === 'string') obj[key] = val;
    });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(obj));
    updateReviewSummary();
  }

  // 3. Validation per step
  function validateStep(stepNum: number): boolean {
    const pane = panes[stepNum - 1];
    if (!pane) return true;

    const requiredInputs = pane.querySelectorAll('input[required], select[required], textarea[required]') as NodeListOf<HTMLInputElement>;
    const errors: string[] = [];

    requiredInputs.forEach((input) => {
      const fieldId = input.id;
      const errEl = document.getElementById(`err-${fieldId}`);
      let hasError = false;

      if (!input.value.trim()) {
        hasError = true;
        const label = input.closest('.form-group')?.querySelector('label')?.textContent || input.name;
        errors.push(`${label.replace('*', '').trim()} wajib diisi.`);
      } else if (input.id === 'siswa-nisn' && !/^[0-9]{10}$/.test(input.value.trim())) {
        hasError = true;
        errors.push('NISN harus berupa 10 digit angka.');
      } else if (input.id === 'siswa-nik' && !/^[0-9]{16}$/.test(input.value.trim())) {
        hasError = true;
        errors.push('NIK harus berupa 16 digit angka.');
      }

      if (errEl) {
        if (hasError) {
          errEl.textContent = 'Harap periksa isian ini.';
          errEl.classList.add('visible');
        } else {
          errEl.textContent = '';
          errEl.classList.remove('visible');
        }
      }
    });

    if (stepNum === 4) {
      const consent = document.getElementById('consent-check') as HTMLInputElement | null;
      const errConsent = document.getElementById('err-consent');
      if (consent && !consent.checked) {
        errors.push('Anda harus mencentang persetujuan kebenaran data & privasi.');
        if (errConsent) {
          errConsent.textContent = 'Wajib dicentang untuk melanjutkan.';
          errConsent.classList.add('visible');
        }
      }
    }

    if (errorBox && errorList) {
      if (errors.length > 0) {
        errorList.innerHTML = errors.map(e => `<li>${e}</li>`).join('');
        errorBox.hidden = false;
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
      } else {
        errorBox.hidden = true;
      }
    }

    return true;
  }

  // 4. Step Transition
  function goToStep(stepNum: number) {
    panes.forEach((p, idx) => {
      if (idx === stepNum - 1) {
        p?.classList.add('active');
      } else {
        p?.classList.remove('active');
      }
    });

    stepPills.forEach((pill, idx) => {
      if (idx + 1 === stepNum) {
        pill.classList.add('active');
      } else if (idx + 1 < stepNum) {
        pill.classList.remove('active');
        pill.classList.add('completed');
      } else {
        pill.classList.remove('active', 'completed');
      }
    });

    if (stepIndicatorText) stepIndicatorText.textContent = stepTitles[stepNum - 1];
    if (progressBar) progressBar.style.width = `${(stepNum / 4) * 100}%`;

    currentStep = stepNum;
    window.scrollTo({ top: wizardHeader?.offsetTop ? wizardHeader.offsetTop - 80 : 0, behavior: 'smooth' });
    saveDraft();
  }

  // 5. Update Review Summary
  function updateReviewSummary() {
    const getValue = (id: string) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      return el ? el.value : '';
    };

    const setReview = (targetId: string, val: string, fallback = '-') => {
      const el = document.getElementById(targetId);
      if (el) el.textContent = val || fallback;
    };

    setReview('rev-nama', getValue('siswa-nama'));
    setReview('rev-nisn', getValue('siswa-nisn'));
    setReview('rev-nik', getValue('siswa-nik'));
    setReview('rev-gender', getValue('siswa-gender'));
    setReview('rev-ttl', `${getValue('siswa-tempat-lahir')}, ${getValue('siswa-tanggal-lahir')}`);
    setReview('rev-alamat', getValue('siswa-alamat'));
    setReview('rev-ayah', getValue('ortu-ayah'));
    setReview('rev-ibu', getValue('ortu-ibu'));
    setReview('rev-pekerjaan', getValue('ortu-pekerjaan'));
    setReview('rev-wa', getValue('ortu-wa'));
    setReview('rev-sekolah', getValue('sekolah-asal'));
    setReview('rev-status-lulus', getValue('sekolah-status-lulus'));
  }

  // File picker handler
  ['file-kk', 'file-akta', 'file-foto'].forEach((fileId) => {
    const input = document.getElementById(fileId) as HTMLInputElement | null;
    const preview = document.getElementById(`preview-${fileId.replace('file-', '')}`);
    if (!input || !preview) return;

    input.addEventListener('change', () => {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const nameSpan = preview.querySelector('.file-name-text');
        if (nameSpan) nameSpan.textContent = `${file.name} (${Math.round(file.size / 1024)} KB)`;
        preview.hidden = false;

        const revId = `rev-${fileId}`;
        const revEl = document.getElementById(revId);
        if (revEl) revEl.textContent = `Tersedia: ${file.name}`;
      }
    });
  });

  // Remove file button
  document.querySelectorAll('.file-remove-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetInputId = btn.getAttribute('data-remove');
      if (!targetInputId) return;
      const input = document.getElementById(targetInputId) as HTMLInputElement | null;
      const preview = btn.closest('.file-preview-status') as HTMLElement | null;
      if (input) input.value = '';
      if (preview) preview.hidden = true;

      const revId = `rev-${targetInputId}`;
      const revEl = document.getElementById(revId);
      if (revEl) revEl.textContent = 'Belum diunggah';
    });
  });

  // Next & Prev Buttons
  document.querySelectorAll('.next-step-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = parseInt(btn.getAttribute('data-target') || '1', 10);
      if (validateStep(currentStep)) {
        goToStep(target);
      }
    });
  });

  document.querySelectorAll('.prev-step-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = parseInt(btn.getAttribute('data-target') || '1', 10);
      goToStep(target);
    });
  });

  // Form input changes trigger draft autosave
  form?.addEventListener('input', () => {
    saveDraft();
  });

  // 6. Submit Final Form -> Show Success Screen (PRD 8.6.1)
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validateStep(4)) return;

    // Generate Registration Number (e.g. PPDB-2027-XXXX)
    const randomNum = Math.floor(1000 + Math.random() * 9000);
    const regNumber = `PPDB-2027-${randomNum}`;
    const studentName = (document.getElementById('siswa-nama') as HTMLInputElement)?.value || '';
    const studentNisn = (document.getElementById('siswa-nisn') as HTMLInputElement)?.value || '';
    const schoolFrom = (document.getElementById('sekolah-asal') as HTMLInputElement)?.value || '';
    const ortuWa = (document.getElementById('ortu-wa') as HTMLInputElement)?.value || '';

    // Populate Success Screen
    const regNumEl = document.getElementById('success-reg-num');
    const regTimeEl = document.getElementById('success-reg-time');
    const slipName = document.getElementById('slip-name');
    const slipNisn = document.getElementById('slip-nisn');
    const slipSchool = document.getElementById('slip-school');
    const slipWa = document.getElementById('slip-wa');
    const waLink = document.getElementById('success-wa-link') as HTMLAnchorElement | null;

    if (regNumEl) regNumEl.textContent = regNumber;
    if (regTimeEl) regTimeEl.textContent = `Waktu submit: ${new Date().toLocaleString('id-ID')}`;
    if (slipName) slipName.textContent = studentName;
    if (slipNisn) slipNisn.textContent = studentNisn;
    if (slipSchool) slipSchool.textContent = schoolFrom;
    if (slipWa) slipWa.textContent = ortuWa;

    // WA Link with Registration Number
    if (waLink) {
      const waMsg = `Halo Tim Admission FREEKS.id School. Saya telah mengisi formulir online atas nama ${studentName} dengan Nomor Registrasi: ${regNumber}. Mohon informasi tahapan verifikasi selanjutnya. Terima kasih.`;
      waLink.href = `https://wa.me/6281200000000?text=${encodeURIComponent(waMsg)}`;
    }

    // Hide form, show success
    if (form) form.hidden = true;
    if (wizardHeader) wizardHeader.hidden = true;
    if (errorBox) errorBox.hidden = true;
    if (successScreen) {
      successScreen.hidden = false;
      successScreen.scrollIntoView({ behavior: 'smooth' });
    }

    // Clear saved draft
    localStorage.removeItem(STORAGE_KEY);
  });

  // Init load draft on start
  loadDraft();
</script>

