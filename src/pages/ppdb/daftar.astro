---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import siteData from '../../data/siteData.json';
import ppdbData from '../../data/ppdb.json';

const { school } = siteData;

const breadcrumbItems = [
  { label: 'PPDB', href: '/ppdb' },
  { label: 'Formulir Pendaftaran Online' }
];
---

<BaseLayout
  title="Formulir Pendaftaran Online Admission 2027/2028 – FREEKS.id School"
  description="Pengisian formulir pendaftaran siswa baru 4 tahap dengan fitur simpan draft otomatis, unggah berkas, dan bukti registrasi."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-important">Tahun Ajaran {ppdbData.academicYear}</span>
      </div>
      <h1 class="page-title">Formulir Pendaftaran Siswa Baru</h1>
      <p class="page-description">
        Lengkapi 4 langkah data berikut. Draft tersimpan otomatis di perangkat Anda sehingga tidak akan hilang jika koneksi internet terputus.
      </p>
    </div>
  </div>

  <div class="container-wide section">
    <div class="wizard-container" id="ppdb-wizard">
      <!-- Wizard Progress Header (PRD 8.6.1) -->
      <div class="wizard-header card" id="wizard-header">
        <div class="wizard-status-row">
          <span class="wizard-step-indicator" id="step-indicator-text">Langkah 1 dari 4: Data Calon Siswa</span>
          <span class="wizard-saved-badge" id="autosave-status">
            <Icon name="check" size={14} />
            <span>Draft tersimpan otomatis</span>
          </span>
        </div>

        <div class="progress-bar-track" role="progressbar" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar-fill" id="progress-bar" style="width: 25%;"></div>
        </div>

        <!-- Step Pills -->
        <div class="step-nav-pills">
          <button type="button" class="step-nav-btn active" data-step="1">1. Calon Siswa</button>
          <button type="button" class="step-nav-btn" data-step="2">2. Orang Tua</button>
          <button type="button" class="step-nav-btn" data-step="3">3. Asal Sekolah</button>
          <button type="button" class="step-nav-btn" data-step="4">4. Berkas & Tinjau</button>
        </div>
      </div>

      <!-- Error Summary Box (PRD 7.5: ringkasan error di atas form saat gagal kirim) -->
      <div class="error-summary-box card" id="error-summary" hidden>
        <div class="error-head">
          <Icon name="alert-circle" size={20} class="error-icon" />
          <h4 id="error-summary-title">Mohon lengkapi isian berikut:</h4>
        </div>
        <ul id="error-summary-list" class="error-list"></ul>
      </div>

      <!-- Multi-step Form -->
      <form id="ppdb-form" class="wizard-form" novalidate>
        <!-- =================================================================
             LANGKAH 1: DATA CALON SISWA
             ================================================================= -->
        <div class="wizard-step-pane active" id="pane-step-1">
          <div class="card form-pane-card">
            <h2 class="pane-title">1. Data Calon Siswa</h2>
            <div class="section-divider"></div>

            <div class="form-grid">
              <div class="form-group full-col">
                <label for="siswa-nama">Nama Lengkap Siswa *</label>
                <input
                  type="text"
                  id="siswa-nama"
                  name="siswa_nama"
                  required
                  placeholder="Sesuai akta kelahiran, contoh: Muhammad Fajar Kurniawan"
                  autocomplete="name"
                />
                <span class="field-error" id="err-siswa-nama"></span>
              </div>

              <div class="form-group">
                <label for="siswa-nisn">NISN (Nomor Induk Siswa Nasional) *</label>
                <input
                  type="text"
                  id="siswa-nisn"
                  name="siswa_nisn"
                  required
                  inputmode="numeric"
                  pattern="[0-9]{10}"
                  maxlength="10"
                  placeholder="10 digit NISN dari SD/MI"
                />
                <span class="field-error" id="err-siswa-nisn"></span>
              </div>

              <div class="form-group">
                <label for="siswa-nik">NIK Siswa (Nomor Kartu Keluarga) *</label>
                <input
                  type="text"
                  id="siswa-nik"
                  name="siswa_nik"
                  required
                  inputmode="numeric"
                  maxlength="16"
                  placeholder="16 digit NIK pada KK"
                />
                <span class="field-error" id="err-siswa-nik"></span>
              </div>

              <div class="form-group">
                <label for="siswa-gender">Jenis Kelamin *</label>
                <select id="siswa-gender" name="siswa_gender" required>
                  <option value="">-- Pilih Jenis Kelamin --</option>
                  <option value="Laki-laki">Laki-laki</option>
                  <option value="Perempuan">Perempuan</option>
                </select>
                <span class="field-error" id="err-siswa-gender"></span>
              </div>

              <div class="form-group">
                <label for="siswa-tempat-lahir">Tempat Lahir *</label>
                <input
                  type="text"
                  id="siswa-tempat-lahir"
                  name="siswa_tempat_lahir"
                  required
                  placeholder="Kota / Kabupaten lahir"
                />
                <span class="field-error" id="err-siswa-tempat-lahir"></span>
              </div>

              <div class="form-group">
                <label for="siswa-tanggal-lahir">Tanggal Lahir *</label>
                <input
                  type="date"
                  id="siswa-tanggal-lahir"
                  name="siswa_tanggal_lahir"
                  required
                  autocomplete="bday"
                />
                <span class="field-error" id="err-siswa-tanggal-lahir"></span>
              </div>

              <div class="form-group full-col">
                <label for="siswa-alamat">Alamat Tempat Tinggal Lengkap *</label>
                <textarea
                  id="siswa-alamat"
                  name="siswa_alamat"
                  rows="3"
                  required
                  placeholder="Nama jalan, RT/RW, Dusun, Desa/Kelurahan, Kecamatan"
                  autocomplete="street-address"
                ></textarea>
                <span class="field-error" id="err-siswa-alamat"></span>
              </div>
            </div>

            <div class="wizard-nav-footer">
              <div></div>
              <button type="button" class="btn btn-primary next-step-btn" data-target="2">
                <span>Lanjut ke Data Orang Tua</span>
                <Icon name="arrow-right" size={16} />
              </button>
            </div>
          </div>
        </div>

        <!-- =================================================================
             LANGKAH 2: DATA ORANG TUA / WALI
             ================================================================= -->
        <div class="wizard-step-pane" id="pane-step-2">
          <div class="card form-pane-card">
            <h2 class="pane-title">2. Data Orang Tua / Wali</h2>
            <div class="section-divider"></div>

            <div class="form-grid">
              <div class="form-group">
                <label for="ortu-ayah">Nama Lengkap Ayah Kandung *</label>
                <input
                  type="text"
                  id="ortu-ayah"
                  name="ortu_ayah"
                  required
                  placeholder="Contoh: Ahmad Syafi'i"
                />
                <span class="field-error" id="err-ortu-ayah"></span>
              </div>

              <div class="form-group">
                <label for="ortu-ibu">Nama Lengkap Ibu Kandung *</label>
                <input
                  type="text"
                  id="ortu-ibu"
                  name="ortu_ibu"
                  required
                  placeholder="Contoh: Siti Nur Azizah"
                />
                <span class="field-error" id="err-ortu-ibu"></span>
              </div>

              <div class="form-group">
                <label for="ortu-pekerjaan">Pekerjaan Orang Tua / Wali *</label>
                <input
                  type="text"
                  id="ortu-pekerjaan"
                  name="ortu_pekerjaan"
                  required
                  placeholder="Contoh: Petani / Nelayan / Wiraswasta / Guru"
                />
                <span class="field-error" id="err-ortu-pekerjaan"></span>
              </div>

              <div class="form-group">
                <label for="ortu-wa">Nomor WhatsApp Aktif Wali Murid *</label>
                <input
                  type="tel"
                  id="ortu-wa"
                  name="ortu_wa"
                  required
                  inputmode="tel"
                  placeholder="08xxxxxxxxxx (untuk konfirmasi pendaftaran)"
                  autocomplete="tel"
                />
                <span class="field-error" id="err-ortu-wa"></span>
              </div>

              <div class="form-group full-col">
                <label for="ortu-penghasilan">Rentang Penghasilan Orang Tua (Opsional, untuk beasiswa)</label>
                <select id="ortu-penghasilan" name="ortu_penghasilan">
                  <option value="">-- Pilih Rentang Penghasilan --</option>
                  <option value="Kurang dari Rp1.000.000">Kurang dari Rp1.000.000 (Pemegang KIP/PKH)</option>
                  <option value="Rp1.000.000 - Rp2.500.000">Rp1.000.000 - Rp2.500.000</option>
                  <option value="Rp2.500.000 - Rp5.000.000">Rp2.500.000 - Rp5.000.000</option>
                  <option value="Lebih dari Rp5.000.000">Lebih dari Rp5.000.000</option>
                </select>
              </div>
            </div>

            <div class="wizard-nav-footer">
              <button type="button" class="btn btn-secondary prev-step-btn" data-target="1">
                <Icon name="arrow-left" size={16} />
                <span>Kembali ke Data Siswa</span>
              </button>
              <button type="button" class="btn btn-primary next-step-btn" data-target="3">
                <span>Lanjut ke Asal Sekolah</span>
                <Icon name="arrow-right" size={16} />
              </button>
            </div>
          </div>
        </div>

        <!-- =================================================================
             LANGKAH 3: ASAL SEKOLAH
             ================================================================= -->
        <div class="wizard-step-pane" id="pane-step-3">
          <div class="card form-pane-card">
            <h2 class="pane-title">3. Data Asal Sekolah (SD / MI)</h2>
            <div class="section-divider"></div>

            <div class="form-grid">
              <div class="form-group full-col">
                <label for="sekolah-asal">Nama SD / MI Asal *</label>
                <input
                  type="text"
                  id="sekolah-asal"
                  name="sekolah_asal"
                  required
                  placeholder="Contoh: SD Negeri / Swasta Asal"
                />
                <span class="field-error" id="err-sekolah-asal"></span>
              </div>

              <div class="form-group">
                <label for="sekolah-npsn">NPSN Sekolah Asal (Jika Mengetahui)</label>
                <input
                  type="text"
                  id="sekolah-npsn"
                  name="sekolah_npsn"
                  inputmode="numeric"
                  placeholder="8 digit NPSN SD/MI"
                />
              </div>

              <div class="form-group">
                <label for="sekolah-status-lulus">Status Kelulusan *</label>
                <select id="sekolah-status-lulus" name="sekolah_status_lulus" required>
                  <option value="Akan lulus tahun 2027">Akan lulus tahun 2027 (Kelas VI saat ini)</option>
                  <option value="Lulus tahun 2026 atau sebelumnya">Lulus tahun 2026 atau sebelumnya</option>
                </select>
              </div>

              <div class="form-group full-col">
                <label for="sekolah-alamat">Alamat / Kecamatan Asal Sekolah</label>
                <input
                  type="text"
                  id="sekolah-alamat"
                  name="sekolah_alamat"
                  placeholder="Contoh: Gresik, Surabaya, atau Kota Lain"
                />
              </div>
            </div>

            <div class="wizard-nav-footer">
              <button type="button" class="btn btn-secondary prev-step-btn" data-target="2">
                <Icon name="arrow-left" size={16} />
                <span>Kembali ke Data Orang Tua</span>
              </button>
              <button type="button" class="btn btn-primary next-step-btn" data-target="4">
                <span>Lanjut ke Berkas & Tinjau</span>
                <Icon name="arrow-right" size={16} />
              </button>
            </div>
          </div>
        </div>

        <!-- =================================================================
             LANGKAH 4: UNGGAH BERKAS & TINJAU (PRD 8.6.1)
             ================================================================= -->
        <div class="wizard-step-pane" id="pane-step-4">
          <div class="card form-pane-card">
            <h2 class="pane-title">4. Unggah Berkas & Tinjau Pendaftaran</h2>
            <div class="section-divider"></div>

            <!-- Upload Zone -->
            <div class="upload-section">
              <h3 class="upload-section-title">Unggah Foto / Dokumen Pendukung</h3>
              <p class="upload-note">
                Format yang diterima: JPG, PNG, atau PDF (Maks. 2 MB per berkas). Anda dapat mengambil foto langsung lewat kamera ponsel atau memilih berkas galeri.
              </p>

              <div class="upload-boxes-grid">
                <!-- File 1: KK -->
                <div class="file-upload-card" id="card-file-kk">
                  <div class="file-icon-wrap">
                    <Icon name="file" size={24} />
                  </div>
                  <div class="file-info-wrap">
                    <span class="file-label-name">Foto Kartu Keluarga (KK) *</span>
                    <input
                      type="file"
                      id="file-kk"
                      accept="image/*,application/pdf"
                      class="file-native-input"
                    />
                    <label for="file-kk" class="file-picker-btn">
                      <Icon name="upload" size={14} />
                      <span>Pilih Berkas KK</span>
                    </label>
                    <div class="file-preview-status" id="preview-kk" hidden>
                      <span class="file-name-text"></span>
                      <button type="button" class="file-remove-btn" data-remove="file-kk" aria-label="Hapus berkas KK">
                        <Icon name="x" size={14} />
                      </button>
                    </div>
                  </div>
                </div>

                <!-- File 2: Akta -->
                <div class="file-upload-card" id="card-file-akta">
                  <div class="file-icon-wrap">
                    <Icon name="file" size={24} />
                  </div>
                  <div class="file-info-wrap">
                    <span class="file-label-name">Foto Akta Kelahiran *</span>
                    <input
                      type="file"
                      id="file-akta"
                      accept="image/*,application/pdf"
                      class="file-native-input"
                    />
                    <label for="file-akta" class="file-picker-btn">
                      <Icon name="upload" size={14} />
                      <span>Pilih Berkas Akta</span>
                    </label>
                    <div class="file-preview-status" id="preview-akta" hidden>
                      <span class="file-name-text"></span>
                      <button type="button" class="file-remove-btn" data-remove="file-akta" aria-label="Hapus berkas Akta">
                        <Icon name="x" size={14} />
                      </button>
                    </div>
                  </div>
                </div>

                <!-- File 3: Pas Foto -->
                <div class="file-upload-card" id="card-file-foto">
                  <div class="file-icon-wrap">
                    <Icon name="image" size={24} />
                  </div>
                  <div class="file-info-wrap">
                    <span class="file-label-name">Pas Foto Siswa (3x4)</span>
                    <input
                      type="file"
                      id="file-foto"
                      accept="image/*"
                      class="file-native-input"
                    />
                    <label for="file-foto" class="file-picker-btn">
                      <Icon name="upload" size={14} />
                      <span>Pilih Pas Foto</span>
                    </label>
                    <div class="file-preview-status" id="preview-foto" hidden>
                      <span class="file-name-text"></span>
                      <button type="button" class="file-remove-btn" data-remove="file-foto" aria-label="Hapus pas foto">
                        <Icon name="x" size={14} />
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Review Summary Table (PRD 8.6.1: Halaman tinjau menampilkan seluruh data untuk dicek) -->
            <div class="review-box" id="review-summary-area">
              <h3 class="review-head-title">Tinjau Ringkasan Isian Anda</h3>
              <div class="review-grid">
                <div class="review-group">
                  <h4>Data Calon Siswa</h4>
                  <p><strong>Nama:</strong> <span id="rev-nama">-</span></p>
                  <p><strong>NISN:</strong> <span id="rev-nisn">-</span></p>
                  <p><strong>NIK:</strong> <span id="rev-nik">-</span></p>
                  <p><strong>Jenis Kelamin:</strong> <span id="rev-gender">-</span></p>
                  <p><strong>TTL:</strong> <span id="rev-ttl">-</span></p>
                  <p><strong>Alamat:</strong> <span id="rev-alamat">-</span></p>
                </div>

                <div class="review-group">
                  <h4>Data Orang Tua</h4>
                  <p><strong>Ayah:</strong> <span id="rev-ayah">-</span></p>
                  <p><strong>Ibu:</strong> <span id="rev-ibu">-</span></p>
                  <p><strong>Pekerjaan:</strong> <span id="rev-pekerjaan">-</span></p>
                  <p><strong>WhatsApp:</strong> <span id="rev-wa">-</span></p>
                </div>

                <div class="review-group">
                  <h4>Asal Sekolah & Berkas</h4>
                  <p><strong>Asal SD/MI:</strong> <span id="rev-sekolah">-</span></p>
                  <p><strong>Status:</strong> <span id="rev-status-lulus">-</span></p>
                  <p><strong>Berkas KK:</strong> <span id="rev-file-kk">Belum diunggah</span></p>
                  <p><strong>Berkas Akta:</strong> <span id="rev-file-akta">Belum diunggah</span></p>
                </div>
              </div>
            </div>

            <!-- Privacy Policy Notice (PRD 8.6.1 & 13.3) -->
            <div class="privacy-consent-box">
              <label class="consent-label">
                <input type="checkbox" id="consent-check" required />
                <span>
                  Saya menyatakan bahwa seluruh data yang diisikan adalah benar. Saya memahami bahwa data pribadi siswa di bawah umur dilindungi oleh kebijakan privasi FREEKS.id School dan hanya digunakan untuk keperluan seleksi administrasi admission.
                </span>
              </label>
              <span class="field-error" id="err-consent"></span>
            </div>

            <!-- Action buttons -->
            <div class="wizard-nav-footer">
              <button type="button" class="btn btn-secondary prev-step-btn" data-target="3">
                <Icon name="arrow-left" size={16} />
                <span>Kembali ke Asal Sekolah</span>
              </button>
              <button type="submit" class="btn btn-cta" id="btn-submit-ppdb">
                <span>Kirim Formulir Pendaftaran</span>
                <Icon name="check" size={18} />
              </button>
            </div>
          </div>
        </div>
      </form>

      <!-- =================================================================
           HALAMAN SUKSES PENDAFTARAN (PRD 8.6.1)
           ================================================================= -->
      <div id="ppdb-success-screen" class="success-screen card" hidden>
        <div class="success-icon-banner">
          <div class="success-circle">
            <Icon name="check" size={40} />
          </div>
          <h2>Pendaftaran Berhasil Terkirim!</h2>
          <p class="success-lead">
            Selamat, formulir pendaftaran siswa baru telah diterima oleh sistem admission FREEKS.id School.
          </p>
        </div>

        <div class="registration-slip-box" id="registration-slip">
          <div class="slip-header">
            <img src="/assets/logo-ypi.svg" alt="" width="48" height="48" />
            <div>
              <h3>BUKTI REGISTRASI PPDB 2027/2028</h3>
              <p>FREEKS.id School - Modern Tech & Creative Academy</p>
            </div>
          </div>

          <div class="reg-number-highlight">
            <span class="reg-label">Nomor Registrasi Pendaftaran:</span>
            <strong class="reg-number" id="success-reg-num">PPDB-2027-0184</strong>
            <span class="reg-timestamp" id="success-reg-time"></span>
          </div>

          <div class="slip-data-summary">
            <div class="slip-row">
              <span class="slip-label">Nama Calon Siswa:</span>
              <strong id="slip-name">-</strong>
            </div>
            <div class="slip-row">
              <span class="slip-label">NISN Siswa:</span>
              <span id="slip-nisn">-</span>
            </div>
            <div class="slip-row">
              <span class="slip-label">Asal Sekolah:</span>
              <span id="slip-school">-</span>
            </div>
            <div class="slip-row">
              <span class="slip-label">No. WhatsApp Wali:</span>
              <span id="slip-wa">-</span>
            </div>
            <div class="slip-row">
              <span class="slip-label">Status Verifikasi:</span>
              <span class="chip chip-important">Menunggu Verifikasi Administrasi</span>
            </div>
          </div>

          <div class="slip-instructions">
            <h4>Langkah Selanjutnya:</h4>
            <ol>
              <li>Simpan atau cetak nomor pendaftaran ini sebagai bukti registrasi.</li>
              <li>Konfirmasikan pendaftaran Anda ke panitia melalui tombol WhatsApp di bawah.</li>
              <li>Hadir pada pelaksanaan tes baca Al-Qur'an sesuai jadwal gelombang pendaftaran.</li>
            </ol>
          </div>
        </div>

        <!-- Success Actions (PRD 8.6.1) -->
        <div class="success-action-buttons btn-group-responsive">
          <button type="button" onclick="window.print()" class="btn btn-secondary btn-hero">
            <Icon name="printer" size={18} />
            <span>Cetak / Simpan PDF Bukti Pendaftaran</span>
          </button>
          <a
            id="success-wa-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-hero"
          >
            <Icon name="message-circle" size={18} />
            <span>Konfirmasi ke Panitia via WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
  }

  .wizard-container {
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Wizard Header */
  .wizard-header {
    padding: var(--s-5);
    margin-bottom: var(--s-5);
    background-color: #FFFFFF;
  }

  .wizard-status-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wizard-step-indicator {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--green-900);
  }

  .wizard-saved-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--green-700);
    font-weight: 600;
    background-color: var(--green-50);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .progress-bar-track {
    height: 8px;
    background-color: #E2E8F0;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: var(--s-4);
  }

  .progress-bar-fill {
    height: 100%;
    background-color: var(--green-700);
    transition: width var(--dur) var(--ease);
  }

