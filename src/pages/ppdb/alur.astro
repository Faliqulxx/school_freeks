---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import ppdbData from '../../data/ppdb.json';

const { steps } = ppdbData;

const breadcrumbItems = [
  { label: 'PPDB', href: '/ppdb' },
  { label: 'Alur Pendaftaran' }
];
---

<BaseLayout
  title="Alur Pendaftaran Admission – Sekolah Contoh Indonesia"
  description="Tahapan 4 langkah pendaftaran siswa baru Sekolah Contoh Indonesia: formulir online, verifikasi berkas, asesmen minat bakat logika dasar, dan daftar ulang."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">Panduan Pendaftaran</span>
      </div>
      <h1 class="page-title">Alur & Prosedur Pendaftaran Siswa Baru</h1>
      <p class="page-description">
        Ikuti 4 langkah terstruktur berikut untuk menyelesaikan proses pendaftaran secara mudah dan terpantau.
      </p>
    </div>
  </div>

  <div class="container-wide section">
    <!-- Stepper Vertikal di SEMUA ukuran layar (PRD 8.6) -->
    <div class="stepper-vertical-container">
      {steps.map((st, idx) => (
        <div class="stepper-step">
          <!-- Stepper Line and Marker -->
          <div class="stepper-track">
            <div class="stepper-circle">
              <span>{st.step}</span>
            </div>
            {idx < steps.length - 1 && <div class="stepper-line"></div>}
          </div>

          <!-- Stepper Content Card -->
          <div class="stepper-card card">
            <div class="stepper-card-header">
              <span class="step-num-label">Langkah Ke-{st.step}</span>
              <h2 class="step-card-title">{st.title}</h2>
            </div>

            <p class="step-card-summary">{st.summary}</p>

            <div class="step-documents-required">
              <span class="doc-label">
                <Icon name="file-text" size={16} />
                <span>Dokumen yang Dibutuhkan pada Tahap Ini:</span>
              </span>
              <ul class="doc-items-list">
                {st.documents.map((doc) => (
                  <li>
                    <Icon name="check-circle" size={14} class="doc-check-icon" />
                    <span>{doc}</span>
                  </li>
                ))}
              </ul>
            </div>

            {st.step === 1 && (
              <div class="step-action-row">
                <a href="/ppdb/daftar" class="btn btn-primary btn-sm">
                  <span>Buka Formulir Online Sekarang</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
  }

  /* Stepper Vertikal (PRD 8.6: Stepper vertikal di semua ukuran, bukan horizontal di HP) */
  .stepper-vertical-container {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
  }

  .stepper-step {
    display: flex;
    gap: 20px;
    position: relative;
    padding-bottom: var(--s-6);
  }

  @media (max-width: 640px) {
    .stepper-step {
      gap: 12px;
      padding-bottom: 20px;
    }
    .stepper-circle {
      width: 36px !important;
      height: 36px !important;
      font-size: 1rem !important;
    }
    .stepper-card {
      padding: 14px 16px !important;
    }
    .step-card-title {
      font-size: 1rem !important;
      line-height: 1.35 !important;
    }
    .step-card-summary {
      font-size: var(--text-sm) !important;
      line-height: 1.5 !important;
      margin-bottom: 10px !important;
    }
    .step-documents-required {
      padding: 10px 12px !important;
      margin-bottom: 10px !important;
    }
    .step-action-row a {
      width: 100%;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  .stepper-step:last-child {
    padding-bottom: 0;
  }

  .stepper-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .stepper-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--green-700);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 4px var(--green-50);
    z-index: 2;
  }

  .stepper-line {
    width: 3px;
    background-color: var(--green-200);
    flex: 1;
    margin-top: 8px;
  }

  .stepper-card {
    flex: 1;
    padding: var(--s-5);
    background-color: #FFFFFF;
  }

  .stepper-card-header {
    margin-bottom: var(--s-3);
  }

  .step-num-label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    color: var(--green-700);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .step-card-title {
    font-size: var(--h3);
    color: var(--green-900);
    margin: 0;
  }

  .step-card-summary {
    font-size: var(--text-base);
    color: var(--ink-900);
    line-height: 1.6;
    margin-bottom: var(--s-4);
  }

  .step-documents-required {
    background-color: var(--green-50);
    border: 1px solid var(--green-200);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    margin-bottom: var(--s-4);
  }

  .doc-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-900);
    margin-bottom: 8px;
  }

  .doc-items-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .doc-items-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--ink-900);
  }

  .doc-check-icon {
    color: var(--green-700);
    flex-shrink: 0;
  }

  .step-action-row {
    margin-top: var(--s-3);
  }
</style>

