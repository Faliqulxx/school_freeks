---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ModelViewer3D from '../components/ModelViewer3D.astro';

import siteData from '../data/siteData.json';
import heroSambutanData from '../data/heroSambutan.json';
import angkaSekolahData from '../data/angkaSekolah.json';
import programUnggulanData from '../data/programUnggulan.json';
import beritaData from '../data/berita.json';
import pengumumanData from '../data/pengumuman.json';
import galeriData from '../data/galeri.json';
import testimoniData from '../data/testimoni.json';
import ppdbData from '../data/ppdb.json';

const { school } = siteData;
const { hero, sambutan } = heroSambutanData;
const { stats } = angkaSekolahData;
const { programs } = programUnggulanData;
const latestNews = beritaData.articles.slice(0, 5);
const announcements = pengumumanData.announcements.slice(0, 4);
const featuredPhotos = galeriData.albums.flatMap(a => a.photos).slice(0, 8);
const testimonials = testimoniData.testimonials;

function formatNewsDate(dateStr: string, short = false) {
  const [y, m, d] = dateStr.split('-');
  const shortMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
  const fullMonths = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
  const months = short ? shortMonths : fullMonths;
  return `${parseInt(d, 10)} ${months[parseInt(m, 10) - 1]} ${y}`;
}
---

<BaseLayout
  title="Sekolah Contoh Indonesia - Empowering Future Thinkers, Creators & Innovators"
  description={hero.subtitle}
>
  <!-- =========================================================================
       1. HERO SECTION (PRD 8.1 #1)
       ========================================================================= -->
  <section class="hero-section section-soft islamic-pattern" aria-label="Bagian Utama">
    <div class="container-wide hero-container">
      <!-- Left Column: Hero Text & Actions -->
      <div class="hero-text-col">
        <div class="hero-meta">
          <span class="chip chip-primary">{school.foundation}</span>
        </div>
        <h1 class="hero-title">{hero.title}</h1>
        <p class="hero-subtitle">{hero.subtitle}</p>

        <div class="hero-buttons btn-group-responsive">
          <a href={hero.ctaUrl} class="btn btn-cta btn-hero">
            <span>{hero.ctaText}</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={hero.secondaryUrl} class="btn btn-secondary-outline btn-hero">
            <span>{hero.secondaryText}</span>
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>

      <!-- Right Column: Hero Visual Composite (Matching Reference Design) -->
      <div class="hero-image-col">
        <div class="hero-composite-wrap">
          <!-- Floating Slogan Badge on Top Right (Motto Resmi di Gedung Sekolah) -->
          <div class="hero-slogan-badge" aria-label="Slogan Sekolah: Empowering Future Thinkers, Creators & Innovators">
            <span class="slogan-line">Berilmu</span>
            <span class="slogan-line">Beramal</span>
            <span class="slogan-line">Berakhlak</span>
          </div>

          <!-- Decorative Floating Shapes -->
          <div class="hero-shape pill-yellow" aria-hidden="true"></div>
          <div class="hero-shape pill-green-left" aria-hidden="true"></div>
          <div class="hero-shape pill-green-right" aria-hidden="true"></div>

          <!-- Main Featured Card with Sloped Rounded Frame (Siswa Belajar) -->
          <div class="hero-main-card">
            <img
              src="/assets/hero-siswa-belajar.webp"
              alt="Siswa Sekolah Contoh Indonesia Belajar Kolaboratif"
              width="1200"
              height="800"
              class="hero-building-img"
              fetchpriority="high"
            />
          </div>

          <!-- Floating Card: Siswa Berjalan di Halaman Sekolah -->
          <div class="hero-floating-card card-bottom-right">
            <img
              src="/assets/hero-siswa-berjalan.webp"
              alt="Siswa Sekolah Contoh Indonesia di Area Sekolah"
              width="600"
              height="450"
              class="floating-img"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. INFO CEPAT PPDB (PRD 8.1 #3)
       ========================================================================= -->
  <section class="ppdb-strip-section" aria-label="Info Cepat PPDB">
    <div class="container-wide">
      <div class="ppdb-strip card">
        <div class="ppdb-strip-header">
          <div class="ppdb-strip-badge">
            <span class="pulse-dot"></span>
            <span>STATUS PPDB 2027/2028</span>
          </div>
          <h2 class="ppdb-strip-status">{ppdbData.status}</h2>
        </div>

        <div class="ppdb-strip-grid">
          <div class="strip-item">
            <div class="strip-icon-wrap">
              <Icon name="calendar" size={20} />
            </div>
            <div>
              <span class="strip-label">Gelombang 1</span>
              <span class="strip-value">{ppdbData.waves[0].registration}</span>
            </div>
          </div>

          <div class="strip-item">
            <div class="strip-icon-wrap">
              <Icon name="users" size={20} />
            </div>
            <div>
              <span class="strip-label">Daya Tampung</span>
              <span class="strip-value">{ppdbData.quota.total} Siswa</span>
            </div>
          </div>

          <div class="strip-item">
            <div class="strip-icon-wrap">
              <Icon name="check-circle" size={20} />
            </div>
            <div>
              <span class="strip-label">Syarat Masuk</span>
              <span class="strip-value">Lulus SD/MI & Tes Baca Al-Qur'an</span>
            </div>
          </div>

          <div class="strip-item strip-cta-col">
            <a href="/ppdb/syarat-biaya" class="btn btn-secondary btn-sm">
              <span>Rincian Biaya</span>
            </a>
            <a href="/ppdb/daftar" class="btn btn-primary btn-sm">
              <span>Daftar Online</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. LOGO 3D & IDENTITAS YAYASAN (PRD 8.1 #2 & Bagian 9)
       ========================================================================= -->
  <section class="section section-soft" aria-label="Identitas Yayasan dan Model 3D">
    <div class="container-wide">
      <div class="identity-grid">
        <div class="identity-3d-col">
          <div class="model-frame">
            <ModelViewer3D
              sizeDesktop={540}
              sizeTablet={440}
              sizeMobile={240}
              altText="Model 3 Dimensi Logo Resmi Sekolah Contoh Indonesia"
            />
          </div>
        </div>

        <div class="identity-text-col">
          <div class="section-header">
            <div class="header-tag">
              <span class="chip chip-primary">Naungan Yayasan</span>
            </div>
            <h2>Yayasan Inovasi Kreasi Digital (Yayasan Pendidikan Teladan Nusantara)</h2>
            <div class="section-divider"></div>
            <p>
              Berdedikasi mengembangkan potensi generasi muda, Yayasan Pendidikan Teladan Nusantara menaungi ekosistem pembelajaran modern berbasis riset, teknologi terapan, dan kreativitas masa depan.
            </p>
          </div>

          <div class="foundation-features">
            <div class="feat-item">
              <div class="feat-icon-wrap">
                <Icon name="award" size={22} />
              </div>
              <div class="feat-content">
                <h4>Integritas & Akhlak</h4>
                <p>Pembentukan moral integritas, etika digital, dan empati kepemimpinan dalam memecahkan masalah.</p>
              </div>
            </div>
            <div class="feat-item">
              <div class="feat-icon-wrap">
                <Icon name="book-open" size={22} />
              </div>
              <div class="feat-content">
                <h4>Kurikulum Terpadu</h4>
                <p>Memadukan capaian pembelajaran nasional dengan penguasaan computational thinking dan AI.</p>
              </div>
            </div>
          </div>

          <div class="foundation-action">
            <a href="/profil/yayasan" class="btn btn-secondary">
              <span>Pelajari Profil & Visi Yayasan</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. SAMBUTAN KEPALA SEKOLAH (PRD 8.1 #4)
       ========================================================================= -->
  <section class="section" aria-label="Sambutan Head of School">
    <div class="container-wide">
      <div class="sambutan-grid card">
        <div class="sambutan-photo-col">
          <div class="headmaster-photo-wrap">
            <img
              src={sambutan.photo.src}
              alt={sambutan.photo.alt}
              width={sambutan.photo.width}
              height={sambutan.photo.height}
              class="headmaster-img"
              loading="lazy"
            />
            <div class="headmaster-info">
              <h3 class="headmaster-name">{sambutan.name}</h3>
              <span class="headmaster-role">{sambutan.role}</span>
            </div>
          </div>
        </div>

        <div class="sambutan-text-col">
          <div class="section-header">
            <div class="header-tag">
              <span class="chip chip-primary">Pesan Pimpinan</span>
            </div>
            <h2>Bersinergi Menumbuhkan Generasi Berkarakter</h2>
            <div class="section-divider"></div>
          </div>

          <p class="text-arabic" lang="ar" dir="rtl">{sambutan.arabicGreeting}</p>

          <blockquote class="sambutan-quote">
            "{sambutan.shortQuote}"
          </blockquote>

          <div class="sambutan-action">
            <a href="/profil/sambutan" class="btn btn-secondary">
              <span>Baca Sambutan Lengkap</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. PROGRAM UNGGULAN (PRD 8.1 #5 - Asymmetric Grid Rhythm)
       ========================================================================= -->
  <section class="section section-soft" aria-label="Program Unggulan Sekolah">
    <div class="container-wide">
      <div class="section-header">
        <div class="header-tag">
          <span class="chip chip-primary">Keunggulan Inovasi</span>
        </div>
        <h2>Program Unggulan yang Berdampak Nyata</h2>
        <div class="section-divider"></div>
        <p>Dirancang untuk menyeimbangkan kecakapan spiritual, intelektual, dan pembentukan karakter kepemimpinan siswa.</p>
      </div>

      <!-- Asymmetric Rhythm: 1 Hero Big Card + 4 Smaller Stacked Cards -->
      <div class="programs-asymmetric-grid">
        <!-- Big Card: Tahfidz -->
        <div class="program-card-hero card">
          <div class="program-hero-img-wrap">
            <img
              src={programs[0].image.src}
              alt={programs[0].image.alt}
              width={programs[0].image.width}
              height={programs[0].image.height}
              class="program-hero-img"
              loading="lazy"
            />
            <span class="chip chip-important program-badge">Program Inti</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">
              <a href="/akademik/program-unggulan#{programs[0].id}">{programs[0].title}</a>
            </h3>
            <p class="program-summary">{programs[0].summary}</p>
            <p class="program-schedule">
              <Icon name="clock" size={16} />
              <span>{programs[0].schedule}</span>
            </p>
            <div class="program-footer">
              <span class="program-mentor">Pembina: {programs[0].mentor}</span>
              <a href="/akademik/program-unggulan" class="btn btn-primary btn-sm">Pelajari Target</a>
            </div>
          </div>
        </div>

        <!-- 4 Smaller Cards -->
        <div class="programs-side-grid">
          {programs.slice(1, 5).map((prog) => (
            <div class="program-card-small card">
              <div class="card-body">
                <div class="prog-small-header">
                  <h4 class="prog-small-title">
                    <a href={`/akademik/program-unggulan#${prog.id}`}>{prog.title}</a>
                  </h4>
                </div>
                <p class="prog-small-desc">{prog.summary}</p>
                <div class="prog-small-meta">
                  <span class="mentor-text">Pembina: {prog.mentor}</span>
                  <a href="/akademik/program-unggulan" class="prog-arrow-link" aria-label={`Detail ${prog.title}`}>
                    <Icon name="arrow-right" size={16} />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. ANGKA SEKOLAH (PRD 8.1 #6)
       ========================================================================= -->
  <section class="section section-dark islamic-pattern-dark" aria-label="Statistik Sekolah">
    <div class="container-wide">
      <div class="section-header">
        <div class="header-tag">
          <span class="chip chip-important">Data Terverifikasi</span>
        </div>
        <h2>Sekolah dalam Angka</h2>
        <div class="section-divider"></div>
        <p>Pertumbuhan dan dedikasi Sekolah Contoh Indonesia dalam membimbing generasi inovator masa depan.</p>
      </div>

      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-card">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
            <span class="stat-note">{s.note}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. BERITA TERBARU (PRD 8.1 #7)
       ========================================================================= -->
  <section class="section" aria-label="Berita dan Kabar Sekolah">
    <div class="container-wide">
      <div class="section-heading-row">
        <div class="section-header">
          <div class="header-tag">
            <span class="chip chip-primary">Kabar Sekolah</span>
          </div>
          <h2>Berita & Kegiatan Terbaru</h2>
          <div class="section-divider"></div>
        </div>
        <a href="/informasi/berita" class="btn btn-secondary view-all-btn">
          <span>Semua Berita</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <!-- Desktop: 1 Besar + 2 Kecil. Mobile: Horizontal scroll snap -->
      <div class="news-layout-grid">
        <!-- Berita Besar #1 -->
        <article class="news-card-featured card card-clickable">
          <div class="news-featured-img-wrap">
            <img
              src={latestNews[0].image.src}
              alt={latestNews[0].image.alt}
              width={latestNews[0].image.width}
              height={latestNews[0].image.height}
              class="news-featured-img"
              loading="lazy"
            />
            <span class="chip chip-important news-tag">{latestNews[0].category}</span>
          </div>
          <div class="card-body">
            <div class="card-meta">
              <time datetime={latestNews[0].date}>22 Oktober 2026</time>
              <span>•</span>
              <span>{latestNews[0].author}</span>
            </div>
            <h3 class="card-title">
              <a href={`/informasi/berita/${latestNews[0].slug}`}>{latestNews[0].title}</a>
            </h3>
            <p class="card-excerpt">{latestNews[0].excerpt}</p>
            <a href={`/informasi/berita/${latestNews[0].slug}`} class="btn-link">Baca Selengkapnya &rarr;</a>
          </div>
        </article>

        <!-- 4 Berita di Sisi Kanan (Memenuhi Ruang Seimbang) -->
        <div class="news-side-list">
          {latestNews.slice(1, 5).map((item) => (
            <article class="news-card-compact card card-clickable">
              <div class="compact-img-wrap">
                <img
                  src={item.image.src}
                  alt={item.image.alt}
                  width={item.image.width}
                  height={item.image.height}
                  class="compact-img"
                  loading="lazy"
                />
                <span class="chip chip-primary compact-category-badge">{item.category}</span>
              </div>
              <div class="card-body compact-body">
                <div class="card-meta compact-meta">
                  <Icon name="calendar" size={13} class="compact-meta-icon" />
                  <time datetime={item.date}>{formatNewsDate(item.date, true)}</time>
                </div>
                <h4 class="card-title compact-title">
                  <a href={`/informasi/berita/${item.slug}`}>{item.title}</a>
                </h4>
                <p class="card-excerpt compact-excerpt">{item.excerpt}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       8. PENGUMUMAN (PRD 8.1 #8)
       ========================================================================= -->
  <section class="section section-soft" aria-label="Pengumuman Resmi">
    <div class="container-wide">
      <div class="section-heading-row">
        <div class="section-header">
          <div class="header-tag">
            <span class="chip chip-primary">Papan Informasi</span>
          </div>
          <h2>Pengumuman Sekolah</h2>
          <div class="section-divider"></div>
        </div>
        <a href="/informasi/pengumuman" class="btn btn-secondary view-all-btn">
          <span>Semua Pengumuman</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="announcements-grid">
        {announcements.map((ann) => (
          <div class="announcement-card card">
            <div class="ann-date-box">
              <span class="ann-day">{ann.day}</span>
              <span class="ann-month">{ann.month}</span>
              <span class="ann-year">{ann.year}</span>
            </div>
            <div class="ann-content">
              <div class="ann-header">
                {ann.important && <span class="chip chip-important">Penting</span>}
                <h4 class="ann-title">
                  <a href="/informasi/pengumuman">{ann.title}</a>
                </h4>
              </div>
              <p class="ann-summary">{ann.summary}</p>
              {ann.attachment && (
                <div class="ann-attachment">
                  <Icon name="file-text" size={16} />
                  <span>Lampiran: {ann.attachment.name} ({ann.attachment.size})</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       9. GALERI FOTO (PRD 8.1 #9)
       ========================================================================= -->
  <section class="section" aria-label="Galeri Foto Kegiatan">
    <div class="container-wide">
      <div class="section-heading-row">
        <div class="section-header">
          <div class="header-tag">
            <span class="chip chip-primary">Dokumentasi</span>
          </div>
          <h2>Galeri Suasana Sekolah</h2>
          <div class="section-divider"></div>
        </div>
        <a href="/informasi/galeri" class="btn btn-secondary view-all-btn">
          <span>Lihat Semua Album</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="gallery-mosaic-grid">
        {featuredPhotos.map((photo) => (
          <div
            class="gallery-item"
            data-lightbox-src={photo.src}
            data-lightbox-alt={photo.alt}
            data-lightbox-caption={photo.caption}
            data-lightbox-group="home-gallery"
            tabindex="0"
            role="button"
            aria-label={`Buka gambar: ${photo.alt}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              class="gallery-thumb"
              loading="lazy"
            />
            <div class="gallery-overlay">
              <Icon name="maximize-2" size={20} class="gallery-zoom-icon" />
              <p class="gallery-item-caption">{photo.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       10. TESTIMONI (PRD 8.1 #10 - Dummy Marked)
       ========================================================================= -->
  <section class="section section-soft" aria-label="Testimoni Wali Murid & Alumni">
    <div class="container-wide">
      <div class="section-header">
        <div class="header-tag">
          <span class="chip chip-primary">Kata Mereka</span>
        </div>
        <h2>Testimoni Wali Murid & Alumni</h2>
        <div class="section-divider"></div>
        <p>Kesan nyata dari keluarga besar siswa yang telah mempercayakan pendidikan di Sekolah Contoh Indonesia.</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <div class="testimonial-card card">
            <div class="testi-header">
              <!-- Initials in green circle (PRD A.13: inisial bukan foto orang fiktif) -->
              <div class="initials-avatar">{t.initials}</div>
              <div>
                <h4 class="testi-name">{t.name}</h4>
                <span class="testi-role">{t.role}</span>
              </div>
            </div>
            <blockquote class="testi-quote">
              "{t.quote}"
            </blockquote>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       11. BANNER PPDB (PRD 8.1 #11)
       ========================================================================= -->
  <section class="banner-ppdb-section section-dark islamic-pattern-dark" aria-label="Ajakan Pendaftaran PPDB">
    <div class="container-wide">
      <div class="banner-ppdb-card">
        <div class="banner-ppdb-text">
          <span class="chip chip-important">Tahun Ajaran 2027/2028</span>
          <h2 class="banner-title">Pendaftaran Siswa Baru (Admission) Sekolah Contoh Indonesia Telah Dibuka</h2>
          <p class="banner-desc">
            Kuota terbatas untuk 128 siswa. Dapatkan kemudahan pendaftaran online, potongan infaq beasiswa, dan lingkungan belajar ramah siswa.
          </p>
        </div>
        <div class="banner-ppdb-actions btn-group-responsive">
          <a href="/ppdb/daftar" class="btn btn-cta btn-hero">
            <span>Daftar PPDB Sekarang</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/ppdb/syarat-biaya" class="btn btn-outline-white btn-hero">
            <span>Lihat Rincian Biaya</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       12. LOKASI DAN KONTAK (PRD 8.1 #12)
       ========================================================================= -->
  <section class="section" aria-label="Lokasi dan Kontak Sekolah">
    <div class="container-wide">
      <div class="contact-location-grid">
        <div class="contact-info-col card">
          <div class="card-body">
            <div class="section-header">
              <div class="header-tag">
                <span class="chip chip-primary">Kunjungi Sekolah</span>
              </div>
              <h2>Lokasi & Informasi Kontak</h2>
              <div class="section-divider"></div>
            </div>

            <div class="contact-detail-items">
              <div class="detail-box">
                <Icon name="map-pin" size={24} class="detail-icon" />
                <div>
                  <h4>Alamat Sekolah</h4>
                  <p>{school.address}</p>
                </div>
              </div>

              <div class="detail-box">
                <Icon name="clock" size={24} class="detail-icon" />
                <div>
                  <h4>Jam Layanan Sekretariat</h4>
                  <p>{school.officeHours}</p>
                </div>
              </div>

              <div class="detail-box">
                <Icon name="phone" size={24} class="detail-icon" />
                <div>
                  <h4>Telepon & WhatsApp</h4>
                  <p>Telepon: <a href={`tel:${school.phone}`}>{school.phone}</a></p>
                  <p>WhatsApp: <a href={`https://wa.me/${school.whatsappRaw}?text=${encodeURIComponent(school.whatsappMessage)}`} target="_blank" rel="noopener noreferrer">{school.whatsapp}</a></p>
                </div>
              </div>

              <div class="detail-box">
