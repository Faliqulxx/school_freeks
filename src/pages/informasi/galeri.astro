---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import galeriData from '../../data/galeri.json';

const { albums, videos } = galeriData;

const breadcrumbItems = [
  { label: 'Informasi', href: '/informasi/berita' },
  { label: 'Galeri Sekolah' }
];
---

<BaseLayout
  title="Galeri Foto & Video – Sekolah Contoh Indonesia"
  description="Dokumentasi album foto pameran showcase day, kejuaraan robotika, Student Council, dan video profil sekolah Sekolah Contoh Indonesia."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">Dokumentasi Kegiatan</span>
      </div>
      <h1 class="page-title">Galeri Foto & Video Siswa</h1>
      <p class="page-description">
        Merekam momen inovasi, eksplorasi teknologi, dan kebersamaan para siswa dalam berkegiatan di sekolah Sekolah Contoh Indonesia.
      </p>

      <!-- Media Type Tabs (PRD 8.5) -->
      <div class="gallery-tabs-row" role="tablist" aria-label="Pilihan Media Galeri">
        <button
          type="button"
          class="gallery-tab active"
          id="tab-btn-photos"
          role="tab"
          aria-selected="true"
          aria-controls="panel-photos"
        >
          <Icon name="image" size={18} />
          <span>Album Foto ({albums.length} Album)</span>
        </button>
        <button
          type="button"
          class="gallery-tab"
          id="tab-btn-videos"
          role="tab"
          aria-selected="false"
          aria-controls="panel-videos"
        >
          <Icon name="video" size={18} />
          <span>Video Kegiatan ({videos.length} Video)</span>
        </button>
      </div>
    </div>
  </div>

  <div class="container-wide section">
    <!-- PANEL 1: ALBUM FOTO -->
    <div id="panel-photos" class="gallery-panel active" role="tabpanel" aria-labelledby="tab-btn-photos">
      {albums.map((album) => (
        <section class="album-section">
          <div class="album-header">
            <div>
              <span class="chip chip-primary">{album.date}</span>
              <h2 class="album-title">{album.title}</h2>
            </div>
            <span class="album-count">
              <Icon name="camera" size={16} />
              <span>{album.photoCount} Foto Terdokumentasi</span>
            </span>
          </div>

          <!-- Masonry Grid: 2 kolom (xs-sm), 3 (md), 4 (lg+) (PRD 7.7) -->
          <div class="masonry-gallery-grid">
            {album.photos.map((photo) => (
              <div
                class="masonry-photo-card card"
                data-lightbox-src={photo.src}
                data-lightbox-alt={photo.alt}
                data-lightbox-caption={`${photo.caption} (${album.title})`}
                data-lightbox-group={album.id}
                role="button"
                tabindex="0"
                aria-label={`Buka foto: ${photo.alt}`}
              >
                <div class="masonry-img-wrap" style={`aspect-ratio: ${photo.ratio.replace(':', ' / ')};`}>
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    width={photo.width}
                    height={photo.height}
                    class="masonry-img"
                    loading="lazy"
                  />
                  <div class="masonry-hover-layer">
                    <Icon name="maximize-2" size={24} class="zoom-icon" />
                    <p class="masonry-caption-text">{photo.caption}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- PANEL 2: VIDEO DENGAN FACADE (PRD 7.7) -->
    <div id="panel-videos" class="gallery-panel" role="tabpanel" aria-labelledby="tab-btn-videos" hidden>
      <div class="video-grid">
        {videos.map((vid) => (
          <div class="video-facade-card card">
            <div class="video-player-wrap" data-yt-id={vid.youtubeId}>
              <img
                src={vid.thumbnail}
                alt={vid.title}
                width="640"
                height="360"
                class="video-thumbnail"
                loading="lazy"
              />
              <button
                type="button"
                class="video-play-btn"
                aria-label={`Putar video: ${vid.title}`}
              >
                <Icon name="play" size={28} />
              </button>
              <span class="video-duration">{vid.duration}</span>
            </div>
            <div class="card-body">
              <span class="video-date">{vid.date}</span>
              <h3 class="video-title">{vid.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
    margin-bottom: var(--s-5);
  }

  /* Tabs */
  .gallery-tabs-row {
    display: flex;
    gap: 12px;
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-300);
  }

  .gallery-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-md);
    background-color: #FFFFFF;
    border: 1px solid var(--ink-300);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink-900);
    cursor: pointer;
    min-height: 48px;
    transition: background-color var(--dur-fast) var(--ease),
                border-color var(--dur-fast) var(--ease),
                color var(--dur-fast) var(--ease);
  }

  .gallery-tab.active {
    background-color: var(--green-700);
    border-color: var(--green-700);
    color: #FFFFFF;
  }

  /* Album Sections */
  .album-section {
    margin-bottom: var(--s-8);
  }

  .album-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--ink-300);
  }

  @media (min-width: 640px) {
    .album-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .album-title {
    font-size: var(--h3);
    color: var(--green-900);
    margin-top: 6px;
    margin-bottom: 0;
  }

  .album-count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-600);
  }

  /* Masonry Grid (PRD 7.7) */
  .masonry-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  @media (min-width: 641px) {
    .masonry-gallery-grid {
      gap: var(--s-3);
    }
  }

  @media (min-width: 768px) {
    .masonry-gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-4);
    }
  }

  @media (min-width: 1024px) {
    .masonry-gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-tabs-row {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .gallery-tab {
      padding: 8px 12px;
      font-size: var(--text-xs);
      min-height: 44px;
      white-space: nowrap;
      flex: 1;
      justify-content: center;
    }
    .masonry-img-wrap {
      aspect-ratio: 1 / 1 !important; /* Uniform square ratio on mobile */
    }
    .masonry-caption-text {
      font-size: 10px;
      line-height: 1.3;
    }
    .album-header {
      gap: 4px;
      margin-bottom: var(--s-3);
    }
    .album-title {
      font-size: 1.15rem;
    }
  }

  .masonry-photo-card {
    cursor: pointer;
    overflow: hidden;
  }

  .masonry-img-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--bg-soft);
  }

  .masonry-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur) var(--ease);
  }

  .masonry-photo-card:hover .masonry-img {
    transform: scale(1.05);
  }

  .masonry-hover-layer {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 59, 22, 0.88) 0%, transparent 60%);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--s-4);
    color: #FFFFFF;
    transition: opacity var(--dur) var(--ease);
  }

  .masonry-photo-card:hover .masonry-hover-layer,
  .masonry-photo-card:focus .masonry-hover-layer {
    opacity: 1;
  }

  .zoom-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    color: var(--yellow-500);
  }

  .masonry-caption-text {
    font-size: var(--text-xs);
    line-height: 1.4;
    color: #FAFBF5;
    margin: 0;
  }

  /* Video Grid & Facade (PRD 7.7) */
  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  @media (min-width: 768px) {
    .video-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .video-facade-card {
    overflow: hidden;
  }

  .video-player-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background-color: #000000;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--yellow-500);
    color: var(--green-900);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform var(--dur-fast) var(--ease),
                background-color var(--dur-fast) var(--ease);
  }

  .video-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: var(--yellow-600);
  }

  .video-duration {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background-color: rgba(0, 0, 0, 0.75);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .video-date {
    font-size: var(--text-xs);
    color: var(--ink-600);
  }

  .video-title {
    font-size: 1.05rem;
    color: var(--green-900);
    margin: 4px 0 0 0;
  }
</style>

<script>
  // Tab Switching Logic
  const tabPhotos = document.getElementById('tab-btn-photos');
  const tabVideos = document.getElementById('tab-btn-videos');
  const panelPhotos = document.getElementById('panel-photos');
  const panelVideos = document.getElementById('panel-videos');

  tabPhotos?.addEventListener('click', () => {
    tabPhotos.classList.add('active');
    tabPhotos.setAttribute('aria-selected', 'true');
    tabVideos?.classList.remove('active');
    tabVideos?.setAttribute('aria-selected', 'false');

    if (panelPhotos) panelPhotos.hidden = false;
    if (panelVideos) panelVideos.hidden = true;
  });

  tabVideos?.addEventListener('click', () => {
    tabVideos.classList.add('active');
    tabVideos.setAttribute('aria-selected', 'true');
    tabPhotos?.classList.remove('active');
    tabPhotos?.setAttribute('aria-selected', 'false');

    if (panelVideos) panelVideos.hidden = false;
    if (panelPhotos) panelPhotos.hidden = true;
  });

  // Video Facade click-to-load YouTube (PRD 7.7: YouTube dimuat dengan facade)
  const videoWraps = document.querySelectorAll('.video-player-wrap');
  videoWraps.forEach((wrap) => {
    const playBtn = wrap.querySelector('.video-play-btn');
    playBtn?.addEventListener('click', () => {
      const ytId = wrap.getAttribute('data-yt-id');
      if (!ytId) return;

      wrap.innerHTML = `<iframe
        src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1"
        width="100%"
        height="100%"
        title="Pemutar Video Sekolah"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        style="width:100%;height:100%;position:absolute;top:0;left:0;"
      ></iframe>`;
    });
  });
</script>

