---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Icon from '../../../components/Icon.astro';
import beritaData from '../../../data/berita.json';

const { articles } = beritaData;

const breadcrumbItems = [
  { label: 'Informasi', href: '/informasi/berita' },
  { label: 'Berita & Kegiatan' }
];

const categories = ['Semua', 'Kegiatan', 'Prestasi', 'Akademik', 'Kesiswaan', 'Pengumuman'];

// First article is featured format (PRD 8.5)
const featuredArticle = articles[0];
const remainingArticles = articles.slice(1);
---

<BaseLayout
  title="Berita & Kegiatan – FREEKS.id School"
  description="Warta terkini kegiatan kampus, pameran inovasi, prestasi robotika, dan agenda FREEKS.id School."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">Warta Kampus</span>
      </div>
      <h1 class="page-title">Berita & kegiatan siswa</h1>
      <p class="page-description">
        Kumpulan liputan agenda kampus, pameran proyek inovasi, dan dokumentasi aktivitas eksplorasi teknologi siswa.
      </p>

      <!-- Search & Category Filters (PRD 8.5) -->
      <div class="news-filter-bar">
        <div class="search-input-wrap">
          <Icon name="search" size={18} class="search-input-icon" />
          <input
            type="search"
            id="news-search"
            class="news-search-input"
            placeholder="Cari berita atau kegiatan siswa..."
            aria-label="Cari berita kampus"
          />
        </div>

        <div class="category-chips-list" role="tablist" aria-label="Filter Kategori Berita">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-chip ${idx === 0 ? 'active' : ''}`}
              data-cat={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container-wide section">
    <!-- Featured Big Card (Only for First Article) (PRD 8.5) -->
    <article
      class="featured-news-card card card-clickable"
      id="featured-news"
      data-title={featuredArticle.title.toLowerCase()}
      data-category={featuredArticle.category}
    >
      <div class="featured-img-wrap">
        <img
          src={featuredArticle.image.src}
          alt={featuredArticle.image.alt}
          width={featuredArticle.image.width}
          height={featuredArticle.image.height}
          class="featured-img"
          loading="lazy"
        />
      </div>
      <div class="card-body featured-body">
        <div class="card-meta flex-wrap-meta">
          <span class="chip chip-important featured-cat-tag">{featuredArticle.category}</span>
          <time datetime={featuredArticle.date}>22 Oktober 2026</time>
          <span>•</span>
          <span>Oleh {featuredArticle.author}</span>
        </div>
        <h2 class="featured-title">
          <a href={`/informasi/berita/${featuredArticle.slug}`}>{featuredArticle.title}</a>
        </h2>
        <p class="featured-excerpt">{featuredArticle.excerpt}</p>
        <span class="btn btn-secondary btn-sm" style="width: fit-content; margin-top: auto;">
          Baca Artikel Lengkap &rarr;
        </span>
      </div>
    </article>

    <!-- Regular Grid: 3 cols desktop, 2 cols tablet, 1 col mobile (PRD 8.5) -->
    <div class="news-grid" id="news-grid">
      {remainingArticles.map((item) => (
        <article
          class="regular-news-card card card-clickable"
          data-title={item.title.toLowerCase()}
          data-category={item.category}
        >
          <div class="regular-img-wrap">
            <img
              src={item.image.src}
              alt={item.image.alt}
              width={item.image.width}
              height={item.image.height}
              class="regular-img"
              loading="lazy"
            />
          </div>

          <div class="card-body regular-body">
            <div class="card-meta flex-wrap-meta">
              <span class="chip chip-primary regular-cat-tag">{item.category}</span>
              <time datetime={item.date}>{item.date}</time>
            </div>
            <!-- Long title handling: clamped to 2 lines (PRD A.5 & A.16) -->
            <h3 class="regular-title">
              <a href={`/informasi/berita/${item.slug}`}>{item.title}</a>
            </h3>
            <p class="card-excerpt">{item.excerpt}</p>
            <span class="btn-link regular-more-link">Baca Selengkapnya &rarr;</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty state -->
    <div id="news-empty" class="news-empty card" hidden>
      <Icon name="search-x" size={40} class="empty-icon" />
      <h3>Tidak Ada Berita yang Cocok</h3>
      <p>Coba gunakan kata kunci lain atau pilih kategori Semua.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
    margin-bottom: var(--s-5);
  }

  .news-filter-bar {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--ink-300);
  }

  .search-input-wrap {
    position: relative;
    max-width: 440px;
  }

  .search-input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-600);
  }

  .news-search-input {
    width: 100%;
    height: 48px;
    padding-left: 44px;
    padding-right: 16px;
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-md);
    font-size: 16px;
    color: var(--ink-900);
    background-color: #FFFFFF;
  }

  .category-chips-list {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }

  .filter-chip {
    padding: 8px 16px;
    border-radius: 999px;
    background-color: #FFFFFF;
    border: 1px solid var(--ink-300);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-900);
    cursor: pointer;
    white-space: nowrap;
    min-height: 40px;
  }

  .filter-chip.active {
    background-color: var(--green-700);
    border-color: var(--green-700);
    color: #FFFFFF;
  }

  /* Featured Article Card (PRD 8.5: Berita pertama berformat besar) */
  .featured-news-card {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--s-7);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .featured-news-card {
      flex-direction: row;
    }
    .featured-img-wrap {
      width: 50%;
      flex-shrink: 0;
    }
    .featured-body {
      width: 50%;
      padding: var(--s-6);
    }
  }

  .featured-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flex-wrap-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--ink-600);
    margin-bottom: var(--s-3);
  }

  .featured-cat-tag,
  .regular-cat-tag {
    position: static;
  }

  .featured-title {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.8rem);
    color: var(--green-900);
    margin-bottom: var(--s-3);
    line-height: 1.3;
  }

  .featured-title a {
    color: var(--green-900);
    text-decoration: none;
  }

  .featured-excerpt {
    font-size: var(--text-base);
    color: var(--ink-600);
    line-height: 1.6;
    margin-bottom: var(--s-5);
  }

  /* Regular Grid: 1 col mobile, 2 cols from 640px (PRD 8.5) */
  .news-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (min-width: 640px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 1024px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .news-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .regular-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .regular-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .regular-body {
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* 2-line clamp for titles & excerpts (Anti-slop & test case A.5/A.16) */
  .regular-title {
    font-size: 1.05rem;
    color: var(--green-900);
    margin-bottom: 8px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-excerpt {
    font-size: var(--text-sm);
    color: var(--ink-600);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 12px;
  }

  @media (max-width: 640px) {
    .featured-title {
      font-size: 1.15rem;
      line-height: 1.3;
    }
    .featured-excerpt {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: var(--s-3);
      font-size: var(--text-sm);
    }
    .regular-body {
      padding: 14px 16px;
    }
    .regular-title {
      font-size: 1rem;
    }
  }

  .regular-more-link {
    margin-top: auto;
  }

  .news-empty {
    padding: var(--s-7);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .news-empty[hidden] {
    display: none !important;
  }

  .empty-icon {
    color: var(--ink-300);
  }
</style>

<script>
  const searchInput = document.getElementById('news-search') as HTMLInputElement | null;
  const chips = document.querySelectorAll('.filter-chip');
  const featured = document.getElementById('featured-news');
  const regularCards = document.querySelectorAll('.regular-news-card') as NodeListOf<HTMLElement>;
  const empty = document.getElementById('news-empty');

  let activeCat = 'Semua';
  let query = '';

  function filterNews() {
    let visible = 0;

    // Check featured
    if (featured) {
      const featTitle = featured.getAttribute('data-title') || '';
      const featCat = featured.getAttribute('data-category') || '';
      const matchSearch = !query || featTitle.includes(query);
      const matchCat = activeCat === 'Semua' || featCat === activeCat;
      if (matchSearch && matchCat) {
        featured.style.display = '';
        visible++;
      } else {
        featured.style.display = 'none';
      }
    }

    // Check regulars
    regularCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const cat = card.getAttribute('data-category') || '';
      const matchSearch = !query || title.includes(query);
      const matchCat = activeCat === 'Semua' || cat === activeCat;

      if (matchSearch && matchCat) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (empty) {
      empty.hidden = visible > 0;
      empty.style.display = visible > 0 ? 'none' : 'flex';
    }
  }

  // Initial call on page load
  filterNews();

  searchInput?.addEventListener('input', (e) => {
    query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterNews();
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      activeCat = chip.getAttribute('data-cat') || 'Semua';
      filterNews();
    });
  });
</script>
