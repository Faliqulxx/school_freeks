---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Icon from '../../../components/Icon.astro';
import beritaData from '../../../data/berita.json';

export function getStaticPaths() {
  return beritaData.articles.map((art) => ({
    params: { slug: art.slug },
    props: { article: art }
  }));
}

const { article } = Astro.props;
const relatedArticles = beritaData.articles.filter((a) => a.slug !== article.slug).slice(0, 3);

const breadcrumbItems = [
  { label: 'Informasi', href: '/informasi/berita' },
  { label: 'Berita', href: '/informasi/berita' },
  { label: article.title }
];

const currentUrl = new URL(Astro.url.pathname, Astro.site || 'https://sekolahcontoh.sch.id').href;
---

<BaseLayout
  title={`${article.title} – Sekolah Contoh Indonesia`}
  description={article.excerpt}
  image={article.image.src}
  type="article"
  publishedTime={article.date}
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">{article.category}</span>
      </div>
      <h1 class="article-detail-title">{article.title}</h1>
      
      <div class="article-meta-bar">
        <div class="meta-item">
          <Icon name="calendar" size={16} />
          <time datetime={article.date}>{article.date}</time>
        </div>
        <span>•</span>
        <div class="meta-item">
          <Icon name="user" size={16} />
          <span>Oleh {article.author}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container-wide section">
    <div class="article-layout-grid">
      <!-- Main Content Article (max-width: 68ch) -->
      <article class="article-main-col">
        <!-- Main Image (16:9, Lightbox supported) (PRD 8.5) -->
        <div class="article-featured-image card">
          <img
            src={article.image.src}
            alt={article.image.alt}
            width={article.image.width}
            height={article.image.height}
            class="article-img"
            data-lightbox-src={article.image.src}
            data-lightbox-alt={article.image.alt}
            data-lightbox-caption={article.title}
            data-lightbox-group="article-gallery"
            role="button"
            tabindex="0"
          />
          <div class="article-img-caption">
            <span>Foto: {article.image.alt} (Klik gambar untuk perbesar)</span>
          </div>
        </div>

        <!-- Article Prose Content (68ch line-length) -->
        <div class="prose-article">
          {article.content && article.content.map((block: any) => {
            if (block.type === 'paragraph') {
              return <p class="article-p">{block.text}</p>;
            }
            if (block.type === 'quote') {
              return (
                <blockquote class="article-quote">
                  <p>"{block.text}"</p>
                  {block.author && <cite class="quote-author">— {block.author}</cite>}
                </blockquote>
              );
            }
            if (block.type === 'table') {
              return (
                <div class="article-table-wrap">
                  {block.caption && <span class="table-caption">{block.caption}</span>}
                  <div class="table-wrapper">
                    <table class="data-table">
                      <thead>
                        <tr>
                          {block.headers.map((h: string) => (
                            <th>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row: string[]) => (
                          <tr>
                            {row.map((cell: string) => (
                              <td>{cell}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              );
            }
            return null;
          })}
        </div>

        <!-- Social Share Buttons (PRD 8.5) -->
        <div class="article-share-bar">
          <span class="share-label">Bagikan Berita Ini:</span>
          <div class="share-buttons">
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`${article.title} - ${currentUrl}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-share wa"
              aria-label="Bagikan ke WhatsApp"
            >
              <Icon name="whatsapp" size={16} />
              <span>WhatsApp</span>
            </a>
            <button
              type="button"
              id="btn-copy-link"
              class="btn-share copy"
              aria-label="Salin Tautan Artikel"
            >
              <Icon name="copy" size={16} />
              <span id="copy-btn-text">Salin Tautan</span>
            </button>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-share fb"
              aria-label="Bagikan ke Facebook"
            >
              <Icon name="facebook" size={16} />
              <span>Facebook</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Sidebar: 3 Related Articles (PRD 8.5) -->
      <aside class="article-sidebar" aria-label="Berita Terkait">
        <div class="sidebar-sticky card">
          <div class="sidebar-head">
            <h3 class="sidebar-head-title">Berita Terkait</h3>
            <div class="section-divider"></div>
          </div>

          <div class="related-list">
            {relatedArticles.map((rel) => (
              <div class="related-card">
                <img
                  src={rel.image.src}
                  alt={rel.image.alt}
                  width="90"
                  height="60"
                  class="related-img"
                  loading="lazy"
                />
                <div class="related-info">
                  <span class="related-date">{rel.date}</span>
                  <h4 class="related-title">
                    <a href={`/informasi/berita/${rel.slug}`}>{rel.title}</a>
                  </h4>
                </div>
              </div>
            ))}
          </div>

          <div class="sidebar-ppdb-box">
            <span class="chip chip-important">PPDB 2027/2028</span>
            <h4>Pendaftaran Telah Dibuka</h4>
            <p>Jadwal dan syarat gelombang 1 siswa baru.</p>
            <a href="/ppdb" class="btn btn-primary btn-sm">Lihat Info PPDB</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .article-detail-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-3);
    line-height: 1.25;
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .article-detail-title {
      font-size: clamp(1.35rem, 1.15rem + 1.5vw, 1.7rem);
      line-height: 1.3;
    }
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    color: var(--ink-600);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Layout 8:4 */
  .article-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  @media (min-width: 1024px) {
    .article-layout-grid {
      grid-template-columns: 8fr 4fr;
      gap: var(--s-7);
    }
  }

  .article-main-col {
    min-width: 0;
  }

  .article-featured-image {
    margin-bottom: var(--s-6);
    overflow: hidden;
    max-width: 100%;
    width: 100%;
    box-sizing: border-box;
  }

  .article-img {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    cursor: pointer;
  }

  .article-img-caption {
    padding: 8px 16px;
    font-size: var(--text-xs);
    color: var(--ink-600);
    background-color: var(--bg-soft);
    border-top: 1px solid var(--ink-300);
  }

  /* Prose Article (strict 68ch max width) */
  .prose-article {
    max-width: var(--content-max-ch);
    width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
    box-sizing: border-box;
  }

  .prose-article img,
  .prose-article iframe,
  .prose-article video,
  .prose-article embed {
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .prose-article {
      max-width: 100%;
    }
    .article-p {
      font-size: var(--text-base);
      line-height: 1.7;
    }
  }

  .article-p {
    font-size: var(--text-base);
    color: var(--ink-900);
    line-height: 1.75;
    margin-bottom: var(--s-4);
  }

  .article-quote {
    background-color: var(--green-50);
    border-left: 4px solid var(--green-700);
    padding: var(--s-5);
    margin: var(--s-5) 0;
    border-radius: var(--radius-sm);
  }

  .article-quote p {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--green-900);
    line-height: 1.5;
    margin-bottom: 6px;
  }

  .quote-author {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-700);
    font-style: normal;
  }

  .article-table-wrap {
    margin: var(--s-5) 0;
  }

  .table-caption {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-900);
    margin-bottom: 8px;
  }

  /* Share Bar */
  .article-share-bar {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--ink-300);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .article-share-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .share-label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--green-900);
  }

  .share-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .btn-share {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    min-height: 40px;
  }

  .btn-share.wa {
    background-color: #25D366;
    color: #FFFFFF;
  }

  .btn-share.copy {
    background-color: var(--bg-soft);
    border-color: var(--ink-300);
    color: var(--ink-900);
  }

  .btn-share.fb {
    background-color: #1877F2;
    color: #FFFFFF;
  }

  /* Sidebar */
  .sidebar-sticky {
    padding: var(--s-5);
    position: sticky;
    top: calc(var(--header-height-scrolled) + 24px);
  }

  .sidebar-head-title {
    font-size: 1.15rem;
    color: var(--green-900);
    margin: 0;
  }

  .related-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  @media (max-width: 640px) {
    .related-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: var(--s-4);
    }
    .related-card {
      display: flex;
      flex-direction: row;
      gap: 12px;
      align-items: center;
    }
    .related-img {
      width: 72px;
      height: 48px;
      flex-shrink: 0;
    }
    .share-buttons {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 6px !important;
      width: 100%;
    }
    .btn-share {
      padding: 8px 6px !important;
      font-size: 11px !important;
      justify-content: center !important;
      min-height: 44px !important;
    }
  }

  .related-card {
    display: flex;
    gap: 12px;
  }

  .related-img {
    width: 80px;
    height: 54px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .related-date {
    font-size: 11px;
    color: var(--ink-600);
  }

  .related-title {
    font-size: var(--text-xs);
    line-height: 1.35;
    margin: 2px 0 0 0;
  }

  .related-title a {
    color: var(--green-900);
    text-decoration: none;
  }

  .related-title a:hover {
    color: var(--green-700);
  }

  .sidebar-ppdb-box {
    background-color: var(--green-50);
    border: 1px dashed var(--green-500);
    border-radius: var(--radius-sm);
    padding: 16px;
  }

  .sidebar-ppdb-box h4 {
    font-size: 1rem;
    margin: 8px 0 4px 0;
  }

  .sidebar-ppdb-box p {
    font-size: var(--text-xs);
    color: var(--ink-600);
    margin-bottom: 12px;
  }
</style>

<script>
  // Copy link interaction
  const copyBtn = document.getElementById('btn-copy-link');
  const copyBtnText = document.getElementById('copy-btn-text');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyBtnText) copyBtnText.textContent = 'Tersalin!';
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = 'Salin Tautan';
      }, 2500);
    } catch (err) {
      // Fallback
    }
  });
</script>

