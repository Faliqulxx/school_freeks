---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import pengumumanData from '../../data/pengumuman.json';

const { announcements } = pengumumanData;

const breadcrumbItems = [
  { label: 'Informasi', href: '/informasi/berita' },
  { label: 'Pengumuman' }
];
---

<BaseLayout
  title="Pengumuman Resmi – FREEKS.id School"
  description="Papan pengumuman resmi jadwal project sprint, edaran kegiatan, starter pack apparel, dan agenda sekolah FREEKS.id School."
>
  <div class="page-header section-soft">
    <div class="container-wide">
      <Breadcrumb items={breadcrumbItems} />
      <div class="header-meta">
        <span class="chip chip-primary">Papan Informasi Resmi</span>
      </div>
      <h1 class="page-title">Pengumuman & Surat Edaran</h1>
      <p class="page-description">
        Informasi penting bagi seluruh siswa, mentor, dan orang tua seputar agenda sekolah serta pengumuman resmi akademik.
      </p>
    </div>
  </div>

  <div class="container-wide section">
    <div class="announcements-full-list">
      {announcements.map((ann) => (
        <article class="ann-item-card card">
          <div class="ann-date-column">
            <span class="ann-day">{ann.day}</span>
            <span class="ann-month">{ann.month}</span>
            <span class="ann-year">{ann.year}</span>
          </div>

          <div class="ann-body-column">
            <div class="ann-tags-row">
              {ann.important ? (
                <span class="chip chip-important">PENTING & WAJIB DIBACA</span>
              ) : (
                <span class="chip chip-secondary">PEMBERITAHUAN</span>
              )}
            </div>

            <h2 class="ann-full-title">{ann.title}</h2>
            <p class="ann-full-summary">{ann.summary}</p>

            {ann.attachment && (
              <div class="ann-attachment-box">
                <Icon name="file-text" size={20} class="att-icon" />
                <div class="att-info">
                  <span class="att-name">{ann.attachment.name}</span>
                  <span class="att-size">Ukuran: {ann.attachment.size} • Format PDF</span>
                </div>
                <a
                  href="/informasi/unduhan"
                  class="btn btn-secondary btn-sm att-btn"
                  aria-label={`Unduh berkas ${ann.attachment.name}`}
                >
                  <Icon name="download" size={14} />
                  <span>Unduh Berkas</span>
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--ink-300);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--s-3);
  }

  .page-title {
    font-size: var(--h1);
    color: var(--green-900);
    margin-bottom: var(--s-2);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--ink-600);
    max-width: 65ch;
  }

  .announcements-full-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .ann-item-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-4);
  }

  @media (min-width: 641px) {
    .ann-item-card {
      flex-direction: row;
      gap: var(--s-5);
      padding: var(--s-5);
    }
  }

  @media (max-width: 640px) {
    .ann-item-card {
      padding: 16px;
      gap: 12px;
    }
    .ann-date-column {
      width: 100%;
      height: auto;
      padding: 8px 12px;
      flex-direction: row;
      gap: 8px;
      justify-content: flex-start;
      align-items: center;
      box-sizing: border-box;
    }
    .ann-day {
      font-size: 1.4rem;
    }
    .ann-month {
      font-size: var(--text-xs);
    }
    .ann-year {
      font-size: var(--text-xs);
    }
    .ann-full-title {
      font-size: 1.05rem;
      line-height: 1.35;
      margin-bottom: 6px;
      overflow-wrap: break-word;
      word-break: break-word;
    }
    .ann-full-summary {
      font-size: var(--text-sm);
      line-height: 1.55;
      margin-bottom: 12px;
      overflow-wrap: break-word;
    }
    .ann-attachment-box {
      width: 100%;
      box-sizing: border-box;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .att-btn {
      margin-left: 0;
      width: 100%;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  .ann-date-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 88px;
    background-color: var(--green-50);
    border: 1px solid var(--green-200);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    text-align: center;
  }

  .ann-day {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--green-900);
    line-height: 1;
  }

  .ann-month {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-700);
    text-transform: uppercase;
  }

  .ann-year {
    font-size: 11px;
    color: var(--ink-600);
  }

  .ann-body-column {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .ann-tags-row {
    margin-bottom: 6px;
  }

  .ann-full-title {
    font-size: var(--h3);
    color: var(--green-900);
    margin-bottom: 8px;
    line-height: 1.35;
  }

  .ann-full-summary {
    font-size: var(--text-base);
    color: var(--ink-900);
    line-height: 1.6;
    margin-bottom: var(--s-4);
  }

  .ann-attachment-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background-color: var(--bg-soft);
    border: 1px solid var(--ink-300);
    border-radius: var(--radius-sm);
    width: fit-content;
    flex-wrap: wrap;
  }

  .att-icon {
    color: var(--green-700);
    flex-shrink: 0;
  }

  .att-info {
    display: flex;
    flex-direction: column;
  }

  .att-name {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green-900);
  }

  .att-size {
    font-size: 11px;
    color: var(--ink-600);
  }

  .att-btn {
    margin-left: 8px;
  }
</style>

